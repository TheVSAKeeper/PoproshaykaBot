<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Version>3.1.0.15</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(POPROSHAYKA_BUILD_SLOT)' != ''">
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\obj\$(POPROSHAYKA_BUILD_SLOT)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildProjectDirectory)\bin\$(POPROSHAYKA_BUILD_SLOT)\</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' Or '$(RuntimeIdentifiers)' != ''">
    <_RidLockFileSuffix>$(RuntimeIdentifier)</_RidLockFileSuffix>
    <_RidLockFileSuffix Condition="'$(_RidLockFileSuffix)' == ''">$(RuntimeIdentifiers.Replace(';', '-'))</_RidLockFileSuffix>
    <_RidLockFileDirectory>$(MSBuildProjectDirectory)\obj</_RidLockFileDirectory>
    <_RidLockFileDirectory Condition="'$(POPROSHAYKA_BUILD_SLOT)' != ''">$(MSBuildProjectDirectory)\obj\$(POPROSHAYKA_BUILD_SLOT)</_RidLockFileDirectory>
    <NuGetLockFilePath>$(_RidLockFileDirectory)\packages.$(_RidLockFileSuffix).lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <PropertyGroup Label="Analyzers">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Label="Analyzer ratchet" Condition="!$(MSBuildProjectName.StartsWith('PoproshaykaBot.WinForms'))">
    <WarningsAsErrors>$(WarningsAsErrors);MA0158;CS8123;CS8602;CS8604;CS4014;CA2016;VSTHRD103;VSTHRD110;VSTHRD200</WarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);MVVMTK0034;S6667;S6966;S2629;S125;S2696;CA1826;S1854;S3604;S4144;S1066;CA1854;S6618;S4487;S1125;S3218;S2486;S2445;S2094;S1144;S2699;S6580;CA1869;CA1835;MA0009;MA0023;RCS1215;S3459;MA0132;NS5003;S127;MA0061;S1006;CA1806;CA1068;S1994;CA1711;S2365;S6672;CA1309;AsyncFixer03;AsyncFixer06;NUnit2007;NUnit2009</WarningsAsErrors>
  </PropertyGroup>
</Project>
