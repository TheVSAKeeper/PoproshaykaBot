<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels">

    <Style x:Key="RatingShareBar"
           TargetType="ProgressBar">
        <Setter Property="Maximum"
                Value="1" />
        <Setter Property="MinHeight"
                Value="0" />
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="IsHitTestVisible"
                Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid SnapsToDevicePixels="True"
                          ClipToBounds="True">
                        <Border x:Name="PART_Track"
                                Background="Transparent" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Accent.Soft}"
                                CornerRadius="0,6,6,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RatingRowItem"
           TargetType="ListBoxItem"
           BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Padding"
                Value="12,0" />
        <Setter Property="Margin"
                Value="0" />
        <Setter Property="MinHeight"
                Value="40" />
        <Setter Property="AutomationProperties.Name"
                Value="{Binding Summary}" />
        <Setter Property="ToolTip"
                Value="{Binding Summary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <ProgressBar Style="{StaticResource RatingShareBar}"
                                         Value="{Binding Share, Mode=OneWay}" />

                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />

                            <Border x:Name="Outline"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{DynamicResource Bg.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{DynamicResource Bg.SurfaceMute}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin"
                                 Value="True">
                            <Setter TargetName="Outline"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Accent.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="RatingPositionCell">
        <Border x:Name="Badge"
                MinWidth="24"
                MinHeight="24"
                Padding="5,0"
                CornerRadius="12"
                Background="Transparent"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <TextBlock x:Name="Number"
                       Text="{Binding Position}"
                       FontFamily="{DynamicResource Font.Mono}"
                       FontSize="{DynamicResource Font.Size.S}"
                       Foreground="{DynamicResource Fg.Secondary}"
                       TextWrapping="NoWrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsTopThree}"
                         Value="True">
                <Setter TargetName="Badge"
                        Property="Background"
                        Value="{DynamicResource Accent.Primary}" />
                <Setter TargetName="Number"
                        Property="Foreground"
                        Value="{DynamicResource Fg.OnAccent}" />
                <Setter TargetName="Number"
                        Property="FontWeight"
                        Value="{DynamicResource Font.Weight.SemiBold}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="RatingName"
           TargetType="TextBlock">
        <Setter Property="FontWeight"
                Value="{DynamicResource Font.Weight.SemiBold}" />
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Primary}" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="RatingNumber"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize"
                Value="{DynamicResource Font.Size.S}" />
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Secondary}" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
        <Setter Property="TextAlignment"
                Value="Right" />
        <Setter Property="HorizontalAlignment"
                Value="Right" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="RatingNumber.Strong"
           TargetType="TextBlock"
           BasedOn="{StaticResource RatingNumber}">
        <Setter Property="FontWeight"
                Value="{DynamicResource Font.Weight.SemiBold}" />
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Primary}" />
    </Style>

    <Style x:Key="RatingHeaderText"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Secondary}" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="RatingSortButton"
           TargetType="Button"
           BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="MinHeight"
                Value="26" />
        <Setter Property="FontSize"
                Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="FontWeight"
                Value="Normal" />
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Secondary}" />
        <Setter Property="Padding"
                Value="8,2" />
    </Style>

    <Style x:Key="RatingSortArrow"
           TargetType="Path">
        <Setter Property="Width"
                Value="8" />
        <Setter Property="Height"
                Value="6" />
        <Setter Property="Margin"
                Value="6,1,0,0" />
        <Setter Property="Stretch"
                Value="Fill" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Fill"
                Value="{DynamicResource Accent.Primary}" />
        <Setter Property="Visibility"
                Value="Hidden" />
        <Setter Property="Data"
                Value="M 0 0 L 8 0 L 4 6 Z" />
        <Style.Triggers>
            <Trigger Property="Tag"
                     Value="{x:Static vm:UserStatisticsSortIndicator.Ascending}">
                <Setter Property="Visibility"
                        Value="Visible" />
                <Setter Property="Data"
                        Value="M 0 6 L 8 6 L 4 0 Z" />
            </Trigger>
            <Trigger Property="Tag"
                     Value="{x:Static vm:UserStatisticsSortIndicator.Descending}">
                <Setter Property="Visibility"
                        Value="Visible" />
                <Setter Property="Data"
                        Value="M 0 0 L 8 0 L 4 6 Z" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="QuickAmountButton"
           TargetType="Button"
           BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="BorderBrush"
                Value="{DynamicResource Border.Subtle}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="MinHeight"
                Value="28" />
        <Setter Property="Padding"
                Value="6,4" />
        <Setter Property="FontSize"
                Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="FontFamily"
                Value="{DynamicResource Font.Mono}" />
    </Style>

    <Style x:Key="StatValue"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="{DynamicResource Font.Size.XL}" />
        <Setter Property="FontWeight"
                Value="{DynamicResource Font.Weight.SemiBold}" />
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Primary}" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
    </Style>

    <Style x:Key="StatValue.Small"
           TargetType="TextBlock"
           BasedOn="{StaticResource StatValue}">
        <Setter Property="FontSize"
                Value="{DynamicResource Font.Size.L}" />
    </Style>

    <Style x:Key="StatLabel"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Muted}" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
        <Setter Property="Margin"
                Value="0,2,0,0" />
    </Style>

    <Style x:Key="StatCell"
           TargetType="Border">
        <Setter Property="BorderBrush"
                Value="{DynamicResource Border.Subtle}" />
        <Setter Property="BorderThickness"
                Value="1,0,0,0" />
        <Setter Property="Padding"
                Value="16,0,0,0" />
        <Setter Property="Margin"
                Value="0,0,16,0" />
    </Style>

    <Style x:Key="StatCell.Lead"
           TargetType="Border"
           BasedOn="{StaticResource StatCell}">
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Padding"
                Value="0" />
    </Style>

</ResourceDictionary>
