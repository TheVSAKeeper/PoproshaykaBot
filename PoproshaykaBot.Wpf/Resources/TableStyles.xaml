<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="MonoCell"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource Font.Mono}" />
    </Style>

    <Style x:Key="RightCell"
           TargetType="TextBlock">
        <Setter Property="HorizontalAlignment"
                Value="Right" />
        <Setter Property="Margin"
                Value="0,0,8,0" />
    </Style>

    <Style x:Key="NumericCell"
           TargetType="TextBlock"
           BasedOn="{StaticResource RightCell}">
        <Setter Property="FontFamily"
                Value="{DynamicResource Font.Mono}" />
    </Style>

    <Style x:Key="EllipsisCell"
           TargetType="TextBlock">
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
        <Setter Property="ToolTip"
                Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>

    <Style x:Key="TableRow"
           TargetType="DataGridRow"
           BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="MinHeight"
                Value="34" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            <Rectangle x:Name="Stripe"
                                       Width="3"
                                       HorizontalAlignment="Left"
                                       Fill="Transparent" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{DynamicResource Bg.SurfaceMute}" />
                        </Trigger>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{DynamicResource Accent.Soft}" />
                            <Setter TargetName="Stripe"
                                    Property="Fill"
                                    Value="{DynamicResource Accent.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NumericHeader"
           TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment"
                Value="Right" />
        <Setter Property="Padding"
                Value="8,8,10,8" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               Margin="0,0,14,0" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
