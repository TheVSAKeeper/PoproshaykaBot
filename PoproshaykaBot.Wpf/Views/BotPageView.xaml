<UserControl x:Class="PoproshaykaBot.Wpf.Views.BotPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ListBox Style="{StaticResource ListBox.Segmented}"
                 ItemsSource="{Binding Tabs}"
                 SelectedIndex="{Binding SelectedTab, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource SegmentedItem}"
                 AutomationProperties.Name="Разделы страницы «Бот»"
                 HorizontalAlignment="Left"
                 Margin="0,0,0,12" />
        <ContentControl Grid.Row="1"
                        Content="{Binding ActivePage}"
                        Focusable="False" />
    </Grid>
</UserControl>
