<UserControl x:Class="PoproshaykaBot.Wpf.Views.Dialogs.TransferPointsDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Dialogs"
             xmlns:platformControls="clr-namespace:PoproshaykaBot.Wpf.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TransferPointsDialogViewModel}"
             MinWidth="540"
             MinHeight="480"
             Width="660"
             Height="620">
    <UserControl.Resources>
        <Style x:Key="TransferStatusText"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.Caption}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Muted}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WillTransfer}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.SuccessText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWarning}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.WarningText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TransferCompletionBorder"
               TargetType="Border">
            <Setter Property="Padding"
                    Value="12" />
            <Setter Property="CornerRadius"
                    Value="{DynamicResource Radius.M}" />
            <Setter Property="Background"
                    Value="{DynamicResource State.SuccessSoft}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource State.Success}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasCompletionWarning}"
                             Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource State.WarningSoft}" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource State.Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   Style="{StaticResource TextBlock.Heading}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14" />

        <Grid Grid.Row="1"
              Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Источник"
                           FontWeight="{DynamicResource Font.Weight.SemiBold}"
                           Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding SourceOptions}"
                          SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          IsEnabled="{Binding CanEditOptions}"
                          AutomationProperties.Name="Источник переноса баллов" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Целевой канал"
                           FontWeight="{DynamicResource Font.Weight.SemiBold}"
                           Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding TargetOptions}"
                          SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          IsEnabled="{Binding CanEditOptions}"
                          AutomationProperties.Name="Целевой канал переноса баллов" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    CornerRadius="{DynamicResource Radius.M}"
                    Background="{DynamicResource Bg.SurfaceAlt}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1">
                <StackPanel IsEnabled="{Binding CanEditOptions}">
                    <TextBlock Text="Кого перенести"
                               FontWeight="{DynamicResource Font.Weight.SemiBold}"
                               Margin="0,0,0,6" />
                    <RadioButton GroupName="TransferScope"
                                 Content="Все пользователи источника"
                                 IsChecked="{Binding IsScopeAll, Mode=TwoWay}"
                                 Margin="0,0,0,4" />
                    <RadioButton GroupName="TransferScope"
                                 Content="Текущий отфильтрованный список"
                                 IsChecked="{Binding IsScopeFiltered, Mode=TwoWay}"
                                 IsEnabled="{Binding CanUseFilteredScope}"
                                 Margin="0,0,0,4" />
                    <RadioButton GroupName="TransferScope"
                                 Content="Выбранные вручную"
                                 IsChecked="{Binding IsScopeSelected, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="12"
                    CornerRadius="{DynamicResource Radius.M}"
                    Background="{DynamicResource Bg.SurfaceAlt}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1">
                <StackPanel IsEnabled="{Binding CanEditOptions}">
                    <TextBlock Text="Состав переноса"
                               FontWeight="{DynamicResource Font.Weight.SemiBold}"
                               Margin="0,0,0,6" />
                    <RadioButton GroupName="TransferMode"
                                 Content="Все счётчики (сообщения, бонусы и штрафы)"
                                 IsChecked="{Binding IsModeAllCounters, Mode=TwoWay}"
                                 Margin="0,0,0,4" />
                    <RadioButton GroupName="TransferMode"
                                 Content="Только бонусы и штрафы"
                                 IsChecked="{Binding IsModeAdjustmentsOnly, Mode=TwoWay}" />
                    <TextBlock Text="Кросс-платформенный перенос идёт по связанным аккаунтам."
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{DynamicResource Fg.Muted}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding IsCrossPlatform, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Padding="12,10"
                CornerRadius="{DynamicResource Radius.M}"
                Background="{DynamicResource Bg.SurfaceAlt}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1"
                Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsManualSelection, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Выбрать всех"
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding SelectAllUsersCommand}"
                            IsEnabled="{Binding CanEditOptions}"
                            Margin="0,0,4,0" />
                    <Button Content="Снять выбор"
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding ClearSelectedUsersCommand}"
                            IsEnabled="{Binding CanEditOptions}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="{Binding PreviewSummaryText}"
                               FontWeight="{DynamicResource Font.Weight.SemiBold}"
                               Foreground="{DynamicResource Fg.Primary}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PreviewDetailsText}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{DynamicResource Fg.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"
                               Visibility="{Binding PreviewDetailsText, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="4">
            <ListBox ItemsSource="{Binding PreviewUsers}"
                     BorderBrush="{DynamicResource Border.Default}"
                     BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding HasPreviewUsers, Converter={StaticResource BoolToVisibility}}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TransferUserRowViewModel}">
                        <Grid Margin="4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      IsEnabled="{Binding DataContext.CanEditOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      Visibility="{Binding DataContext.IsManualSelection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />

                            <platformControls:PlatformIconView Grid.Column="1"
                                                               Platform="{Binding SourcePlatform, Mode=OneWay}"
                                                               Width="14"
                                                               Height="14"
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Center" />

                            <StackPanel Grid.Column="2"
                                        Margin="0,0,10,0">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CountersText}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Fg.Muted}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="3"
                                       Text="{Binding StatusText}"
                                       Style="{StaticResource TransferStatusText}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Нет пользователей для предпросмотра."
                       Style="{StaticResource TextBlock.Subtle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasPreviewUsers, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>

        <Border Grid.Row="5"
                Style="{StaticResource TransferCompletionBorder}"
                Margin="0,10,0,0"
                Visibility="{Binding HasCompleted, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding CompletionMessage}"
                       Foreground="{DynamicResource Fg.Primary}"
                       TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="{Binding CloseButtonText}"
                    Style="{StaticResource Button.Secondary}"
                    Command="{Binding CloseCommand}"
                    MinWidth="96"
                    Margin="0,0,8,0" />
            <Button Content="Перенести"
                    Style="{StaticResource Button.Primary}"
                    Command="{Binding ExecuteTransferCommand}"
                    MinWidth="112"
                    Visibility="{Binding HasCompleted, Converter={StaticResource InverseBoolToVisibility}}" />
        </StackPanel>
    </Grid>
</UserControl>
