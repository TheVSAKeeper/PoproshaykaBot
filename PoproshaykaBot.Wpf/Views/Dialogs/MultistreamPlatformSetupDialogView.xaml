<UserControl x:Class="PoproshaykaBot.Wpf.Views.Dialogs.MultistreamPlatformSetupDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:controls="clr-namespace:PoproshaykaBot.Wpf.Views.Controls"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Dialogs"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MultistreamPlatformSetupDialogViewModel}"
             MinWidth="520"
             MaxWidth="640"
             Width="560">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right"
                        Style="{StaticResource Badge.Info}"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                    <TextBlock Text="{Binding StepProgressText}"
                               FontSize="{DynamicResource Font.Size.Caption}" />
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:PlatformIconView Platform="{Binding Platform, Mode=OneWay}"
                                               Width="20"
                                               Height="20"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource TextBlock.Heading}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding StepHeading}"
                       Style="{StaticResource TextBlock.Subtle}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="420">
            <StackPanel>
                <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Card.Inset}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="{Binding PlatformDescription}"
                                       Foreground="{DynamicResource Fg.Secondary}"
                                       TextWrapping="Wrap" />

                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding IsYouTubePlatform, Converter={StaticResource BoolToVisibility}}">
                                <CheckBox Style="{StaticResource CheckBox.Default}"
                                          Content="Включить площадку YouTube"
                                          IsChecked="{Binding EnableYouTube, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="PlatformWizardEnableYouTube" />
                                <Button Content="Включить YouTube и продолжить"
                                        Style="{StaticResource Button.Primary}"
                                        Command="{Binding EnableYouTubeAndContinueCommand}"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding ShowQuickEnableYouTubeButton, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Подключённые аккаунты"
                               Foreground="{DynamicResource Fg.Primary}"
                               FontWeight="{DynamicResource Font.Weight.SemiBold}"
                               Margin="0,0,0,8" />

                    <Border Style="{StaticResource Card.Inset}"
                            Padding="12,10"
                            Margin="0,0,0,12"
                            Visibility="{Binding HasExistingAccounts, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="Для этой площадки пока нет подключённых аккаунтов. Выберите способ входа ниже – после успешного входа проверка запустится автоматически."
                                   Foreground="{DynamicResource Fg.Secondary}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding ExistingAccounts}"
                                  Focusable="False"
                                  Margin="0,0,0,12"
                                  Visibility="{Binding HasExistingAccounts, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WizardAccountSummaryItem}">
                                <Border Style="{StaticResource Card.Inset}"
                                        Padding="12,8"
                                        Margin="0,0,0,6">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="12,0,0,0">
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"
                                                     keepshell:SeverityBrushBehavior.Fill="{Binding Severity}" />
                                            <TextBlock Text="{Binding RolesSummary}"
                                                       FontSize="{DynamicResource Font.Size.S}"
                                                       keepshell:SeverityBrushBehavior.Foreground="{Binding Severity}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource Fg.Primary}"
                                                   FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Войти через OAuth"
                               Foreground="{DynamicResource Fg.Primary}"
                               FontWeight="{DynamicResource Font.Weight.SemiBold}"
                               Margin="0,0,0,8" />
                    <WrapPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Primary}"
                                Command="{Binding AuthorizeCombinedCommand}"
                                AutomationProperties.AutomationId="PlatformWizardAuthCombined"
                                Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.KeyRound}"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="Войти (бот + владелец)" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="Войти как бот"
                                Style="{StaticResource Button.Secondary}"
                                Command="{Binding AuthorizeBotCommand}"
                                AutomationProperties.AutomationId="PlatformWizardAuthBot"
                                Margin="0,0,8,8" />
                        <Button Content="Войти как владелец"
                                Style="{StaticResource Button.Secondary}"
                                Command="{Binding AuthorizeBroadcasterCommand}"
                                AutomationProperties.AutomationId="PlatformWizardAuthBroadcaster"
                                Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Card.Inset}" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="10"
                                         Height="10"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"
                                         keepshell:SeverityBrushBehavior.Fill="{Binding VerificationSeverity}" />
                                <TextBlock Text="{Binding VerificationHeading}"
                                           FontSize="{DynamicResource Font.Size.L}"
                                           FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                           keepshell:SeverityBrushBehavior.Foreground="{Binding VerificationSeverity}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{Binding VerificationMessage}"
                                       Foreground="{DynamicResource Fg.Secondary}"
                                       TextWrapping="Wrap" />

                            <Button Command="{Binding RetryVerificationCommand}"
                                    Style="{StaticResource Button.Secondary}"
                                    AutomationProperties.AutomationId="PlatformWizardRetryVerification"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding CanRetryVerification, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.RefreshCw}"
                                                              Width="14"
                                                              Height="14"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,6,0" />
                                    <TextBlock Text="Повторить проверку" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource Card.Inset}"
                        Padding="12,8"
                        Margin="0,12,0,0"
                        Visibility="{Binding HasStepNotice, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding StepNotice}"
                               TextWrapping="Wrap"
                               keepshell:SeverityBrushBehavior.Foreground="{Binding StepNoticeSeverity}" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2"
                   LastChildFill="False"
                   Margin="0,16,0,0">
            <Button DockPanel.Dock="Left"
                    Content="Назад"
                    Style="{StaticResource Button.Secondary}"
                    Command="{Binding BackCommand}"
                    MinWidth="92"
                    Visibility="{Binding CanShowBack, Converter={StaticResource BoolToVisibility}}" />

            <Button DockPanel.Dock="Right"
                    Content="{Binding PrimaryButtonLabel}"
                    Style="{StaticResource Button.Primary}"
                    Command="{Binding NextCommand}"
                    AutomationProperties.AutomationId="PlatformWizardPrimaryNext"
                    MinWidth="112" />
            <Button DockPanel.Dock="Right"
                    Content="Закрыть"
                    Style="{StaticResource Button.Ghost}"
                    Command="{Binding CloseCommand}"
                    Margin="0,0,8,0"
                    MinWidth="92" />
        </DockPanel>
    </Grid>
</UserControl>
