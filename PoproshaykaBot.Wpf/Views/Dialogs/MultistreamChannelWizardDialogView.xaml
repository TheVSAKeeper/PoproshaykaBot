<UserControl x:Class="PoproshaykaBot.Wpf.Views.Dialogs.MultistreamChannelWizardDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:controls="clr-namespace:PoproshaykaBot.Wpf.Views.Controls"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Dialogs"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MultistreamChannelWizardDialogViewModel}"
             MinWidth="520"
             MaxWidth="660"
             Width="580">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right"
                        Style="{StaticResource Badge.Info}"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                    <TextBlock Text="{Binding StepProgressText}"
                               FontSize="{DynamicResource Font.Size.Caption}" />
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:PlatformIconView Platform="{Binding Platform, Mode=OneWay}"
                                               Width="20"
                                               Height="20"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource TextBlock.Heading}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding StepHeading}"
                       Style="{StaticResource TextBlock.Subtle}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="440">
            <StackPanel>
                <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Канал"
                               Foreground="{DynamicResource Fg.Primary}"
                               FontWeight="{DynamicResource Font.Weight.SemiBold}"
                               Margin="0,0,0,6" />
                    <TextBox Style="{StaticResource TextBox.Form}"
                             Text="{Binding ChannelInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             keepshell:PlaceholderBehavior.Placeholder="{Binding ChannelInputPlaceholder}"
                             AutomationProperties.AutomationId="ChannelWizardInput"
                             AutomationProperties.Name="Логин, @handle или ссылка на канал"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Отображаемое имя (необязательно)"
                               Foreground="{DynamicResource Fg.Primary}"
                               FontWeight="{DynamicResource Font.Weight.SemiBold}"
                               Margin="0,0,0,6" />
                    <TextBox Style="{StaticResource TextBox.Form}"
                             Text="{Binding CustomDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             keepshell:PlaceholderBehavior.Placeholder="Если пусто – подставится название с площадки"
                             AutomationProperties.AutomationId="ChannelWizardDisplayName"
                             AutomationProperties.Name="Отображаемое имя канала"
                             Margin="0,0,0,12" />

                    <CheckBox Style="{StaticResource CheckBox.Default}"
                              Content="Сделать активным каналом сразу после сохранения"
                              IsChecked="{Binding MakeActiveChannel, Mode=TwoWay}"
                              AutomationProperties.AutomationId="ChannelWizardMakeActive" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="0,0,0,12"
                                Visibility="{Binding ShowChannelSelector, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Канал"
                                   Foreground="{DynamicResource Fg.Primary}"
                                   FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                   Margin="0,0,0,6" />
                        <ComboBox Style="{StaticResource ComboBox.Form}"
                                  ItemsSource="{Binding AvailableChannels}"
                                  SelectedItem="{Binding SelectedTargetChannel, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  AutomationProperties.AutomationId="ChannelWizardTargetChannel"
                                  AutomationProperties.Name="Канал для назначения аккаунта" />
                    </StackPanel>

                    <Border Style="{StaticResource Card.Inset}"
                            Padding="12,9"
                            Margin="0,0,0,12"
                            Visibility="{Binding ShowChannelSelector, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Tv}"
                                                      Width="15"
                                                      Height="15"
                                                      Foreground="{DynamicResource Fg.Secondary}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0" />
                            <TextBlock Text="{Binding TargetChannelDisplayName}"
                                       Foreground="{DynamicResource Fg.Primary}"
                                       FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Аккаунт бота"
                               Foreground="{DynamicResource Fg.Primary}"
                               FontWeight="{DynamicResource Font.Weight.SemiBold}"
                               Margin="0,0,0,6" />
                    <ComboBox Style="{StaticResource ComboBox.Form}"
                              ItemsSource="{Binding BotAccountOptions}"
                              SelectedItem="{Binding SelectedBotAccount, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              AutomationProperties.AutomationId="ChannelWizardBotAccount"
                              AutomationProperties.Name="Аккаунт бота"
                              Margin="0,0,0,12" />

                    <TextBlock Text="Аккаунт владельца (необязательно)"
                               Foreground="{DynamicResource Fg.Primary}"
                               FontWeight="{DynamicResource Font.Weight.SemiBold}"
                               Margin="0,0,0,6" />
                    <ComboBox Style="{StaticResource ComboBox.Form}"
                              ItemsSource="{Binding BroadcasterAccountOptions}"
                              SelectedItem="{Binding SelectedBroadcasterAccount, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              AutomationProperties.AutomationId="ChannelWizardBroadcasterAccount"
                              AutomationProperties.Name="Аккаунт владельца"
                              Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding CanAuthorize, Converter={StaticResource BoolToVisibility}}">
                        <Button Command="{Binding AuthorizeNewAccountCommand}"
                                Style="{StaticResource Button.Secondary}"
                                AutomationProperties.AutomationId="ChannelWizardAuthorizeNewAccount">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.KeyRound}"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="Войти новым аккаунтом" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Card.Inset}"
                            Padding="14,12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="10"
                                         Height="10"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"
                                         keepshell:SeverityBrushBehavior.Fill="{Binding VerificationSummarySeverity}" />
                                <TextBlock Text="{Binding VerificationSummaryHeading}"
                                           FontSize="{DynamicResource Font.Size.L}"
                                           FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                           keepshell:SeverityBrushBehavior.Foreground="{Binding VerificationSummarySeverity}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding VerificationSummaryMessage}"
                                       Foreground="{DynamicResource Fg.Secondary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding VerificationResults}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WizardRoleVerificationItem}">
                                <Border Style="{StaticResource Card.Inset}"
                                        Padding="12,10"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="10,0,0,0">
                                                <Ellipse Width="7"
                                                         Height="7"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,6,0"
                                                         keepshell:SeverityBrushBehavior.Fill="{Binding Severity}" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="{DynamicResource Font.Size.S}"
                                                           keepshell:SeverityBrushBehavior.Foreground="{Binding Severity}"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RoleTitle}"
                                                           Foreground="{DynamicResource Fg.Primary}"
                                                           FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text=" · "
                                                           Foreground="{DynamicResource Fg.Muted}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding AccountName}"
                                                           Foreground="{DynamicResource Fg.Secondary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Text="{Binding HintText}"
                                                   Foreground="{DynamicResource Fg.Muted}"
                                                   FontSize="{DynamicResource Font.Size.S}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"
                                                   Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Command="{Binding RetryVerificationCommand}"
                            Style="{StaticResource Button.Secondary}"
                            AutomationProperties.AutomationId="ChannelWizardRetryVerification"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0"
                            Visibility="{Binding HasVerificationFailure, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.RefreshCw}"
                                                      Width="14"
                                                      Height="14"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0" />
                            <TextBlock Text="Повторить проверку" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Style="{StaticResource Card.Inset}"
                        Padding="12,8"
                        Margin="0,12,0,0"
                        Visibility="{Binding HasStepNotice, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding StepNotice}"
                               TextWrapping="Wrap"
                               keepshell:SeverityBrushBehavior.Foreground="{Binding StepNoticeSeverity}" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2"
                   LastChildFill="False"
                   Margin="0,16,0,0">
            <Button DockPanel.Dock="Left"
                    Content="Назад"
                    Style="{StaticResource Button.Secondary}"
                    Command="{Binding BackCommand}"
                    MinWidth="92"
                    Visibility="{Binding CanShowBack, Converter={StaticResource BoolToVisibility}}" />

            <Button DockPanel.Dock="Right"
                    Content="{Binding PrimaryButtonLabel}"
                    Style="{StaticResource Button.Primary}"
                    Command="{Binding NextCommand}"
                    AutomationProperties.AutomationId="ChannelWizardPrimaryNext"
                    MinWidth="132" />
            <Button DockPanel.Dock="Right"
                    Content="Закрыть"
                    Style="{StaticResource Button.Ghost}"
                    Command="{Binding CloseCommand}"
                    Margin="0,0,8,0"
                    MinWidth="92" />
        </DockPanel>
    </Grid>
</UserControl>
