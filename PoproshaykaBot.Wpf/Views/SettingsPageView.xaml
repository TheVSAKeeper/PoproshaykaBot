<UserControl x:Class="PoproshaykaBot.Wpf.Views.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels"
             xmlns:keepshell="clr-namespace:KeepShell.Bootstrap;assembly=KeepShell"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsPageViewModel}"
             d:DesignHeight="720"
             d:DesignWidth="1100">

    <UserControl.Resources>
        <Style x:Key="SettingsTabControl"
               TargetType="TabControl"
               BasedOn="{StaticResource {x:Type TabControl}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0"
                                       IsItemsHost="True"
                                       Margin="0,0,0,8" />
                            <Border Grid.Row="1"
                                    Background="{DynamicResource Bg.Surface}"
                                    BorderBrush="{DynamicResource Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.L}"
                                    Padding="16">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0"
                Margin="0,12,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}">
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource State.Warning}" />
                    <TextBlock Text="Есть несохранённые изменения"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource State.Warning}" />
                </StackPanel>

                <Button DockPanel.Dock="Right"
                        Content="Сохранить"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding SaveCommand}"
                        MinWidth="120" />
                <Button DockPanel.Dock="Right"
                        Content="Отменить изменения"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding RevertCommand}"
                        MinWidth="120"
                        Margin="0,0,8,0" />
            </DockPanel>
        </Border>

        <TabControl Style="{StaticResource SettingsTabControl}">
            <TabItem Header="Основные">
                <ContentControl Content="{Binding Basic}" />
            </TabItem>
            <TabItem Header="Ограничения">
                <ContentControl Content="{Binding RateLimiting}" />
            </TabItem>
            <TabItem Header="HTTP сервер">
                <ContentControl Content="{Binding HttpServer}" />
            </TabItem>
            <TabItem Header="Сообщения">
                <ContentControl Content="{Binding Messages}" />
            </TabItem>
            <TabItem Header="Авторизация">
                <ContentControl Content="{Binding OAuth}" />
            </TabItem>
            <TabItem Header="Чат OBS">
                <ContentControl Content="{Binding ObsChat}" />
            </TabItem>
            <TabItem Header="OBS подключение">
                <ContentControl Content="{Binding ObsIntegration}" />
            </TabItem>
            <TabItem Header="Автоматический режим">
                <ContentControl Content="{Binding AutoBroadcast}" />
            </TabItem>
            <TabItem Header="Автозапуск бота">
                <ContentControl Content="{Binding BotLifecycle}" />
            </TabItem>
            <TabItem Header="Опросы">
                <ContentControl Content="{Binding Polls}" />
            </TabItem>
            <TabItem Header="Прочее">
                <ContentControl Content="{Binding Misc}" />
            </TabItem>
            <TabItem Header="Обновления">
                <ContentControl Content="{Binding Update}" />
            </TabItem>
            <TabItem Header="Дашборд">
                <ContentControl Content="{Binding DashboardLayout}" />
            </TabItem>
            <TabItem Header="Оформление">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="12">
                        <StackPanel>
                            <TextBlock Text="Внешний вид"
                                       Style="{StaticResource TextBlock.Heading}"
                                       Margin="0,0,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Масштаб шрифта"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Shell.FontScale, StringFormat={}{0:P0}}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Slider Minimum="{x:Static keepshell:FontScaleManager.MinScale}"
                                    Maximum="{x:Static keepshell:FontScaleManager.MaxScale}"
                                    Value="{Binding Shell.FontScale, Mode=TwoWay}"
                                    TickFrequency="0.1"
                                    IsSnapToTickEnabled="True"
                                    Margin="0,6,0,0" />
                            <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                       Text="Увеличивает размер текста по всему приложению. 100% – стандартный размер."
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />

                            <CheckBox Content="Показывать заголовок страницы"
                                      IsChecked="{Binding Shell.ShowPageHeader, Mode=TwoWay}"
                                      Margin="0,16,0,0" />
                            <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                       Text="Плашка с названием раздела и описанием над содержимым каждой страницы."
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
