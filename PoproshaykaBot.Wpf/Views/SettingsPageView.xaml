<UserControl x:Class="PoproshaykaBot.Wpf.Views.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels"
             xmlns:settingsVm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Settings"
             xmlns:settings="clr-namespace:PoproshaykaBot.Wpf.Views.Settings"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsPageViewModel}"
             d:DesignHeight="720"
             d:DesignWidth="1100">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PoproshaykaBot.Wpf;component/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="MultiBlockSectionTemplate"
                          DataType="{x:Type settingsVm:SettingsSectionPresentation}">
                <Grid Visibility="{Binding Section.IsSelected, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"
                                          MaxWidth="{StaticResource Setting.ContentWidth}" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Section.Title}"
                                   Style="{StaticResource Setting.SectionTitle}" />

                        <ItemsControl ItemsSource="{Binding Blocks}"
                                      Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type settingsVm:SettingsSectionBlockDescriptor}">
                                    <HeaderedContentControl Style="{StaticResource Form.Panel}"
                                                            Header="{Binding Title}"
                                                            Margin="{StaticResource Setting.BlockGap}"
                                                            settings:SettingsBlock.Key="{Binding Key}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Hint}"
                                                       Style="{StaticResource Setting.BlockHint}"
                                                       Visibility="{Binding Hint, Converter={StaticResource NullToVisibility}}" />
                                            <ContentControl Content="{Binding Content}"
                                                            Focusable="False" />
                                        </StackPanel>
                                    </HeaderedContentControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="SingleBlockSectionTemplate"
                          DataType="{x:Type settingsVm:SettingsSectionPresentation}">
                <Grid Visibility="{Binding Section.IsSelected, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*">
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="MaxWidth"
                                            Value="{StaticResource Setting.ContentWidth}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFullWidth}"
                                                     Value="True">
                                            <Setter Property="MaxWidth"
                                                    Value="{x:Static sys:Double.PositiveInfinity}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <HeaderedContentControl Grid.Column="0"
                                            Style="{StaticResource Form.Panel}"
                                            Header="{Binding Section.Title}">
                        <StackPanel>
                            <TextBlock Text="{Binding Blocks[0].Hint}"
                                       Style="{StaticResource Setting.BlockHint}"
                                       Visibility="{Binding Blocks[0].Hint, Converter={StaticResource NullToVisibility}}" />
                            <ContentControl Content="{Binding Blocks[0].Content}"
                                            Focusable="False" />
                        </StackPanel>
                    </HeaderedContentControl>
                </Grid>
            </DataTemplate>

            <settings:SettingsSectionTemplateSelector x:Key="SectionTemplateSelector"
                                                      MultiBlockTemplate="{StaticResource MultiBlockSectionTemplate}"
                                                      SingleBlockTemplate="{StaticResource SingleBlockSectionTemplate}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="20,6"
                Margin="-20,12,-20,-20"
                Visibility="{Binding HasDraft, Converter={StaticResource BoolToVisibility}}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}">
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource State.Warning}" />
                    <TextBlock Text="Есть несохранённые изменения"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource State.WarningText}" />
                </StackPanel>

                <Button DockPanel.Dock="Right"
                        Content="Сохранить"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding SaveCommand}"
                        MinWidth="104" />
                <Button DockPanel.Dock="Right"
                        Content="Отменить изменения"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding RevertCommand}"
                        MinWidth="104"
                        Margin="0,0,8,0" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <keepshell:SettingsRail Sections="{Binding Sections}" />

            <ScrollViewer x:Name="SectionScroll"
                          Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="16,0,0,0"
                          Padding="0,0,12,0"
                          ScrollChanged="SectionScroll_OnScrollChanged">
                <ItemsControl x:Name="SectionsHost"
                              ItemsSource="{Binding SectionPresentations}"
                              ItemTemplateSelector="{StaticResource SectionTemplateSelector}"
                              Focusable="False"
                              RequestBringIntoView="SuppressAutoScroll">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
