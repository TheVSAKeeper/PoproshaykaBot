<UserControl x:Class="PoproshaykaBot.Wpf.Views.Onboarding.HttpServerCheckPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Onboarding"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HttpServerCheckPageViewModel}"
             d:DesignHeight="376"
             d:DesignWidth="688">

    <ScrollViewer AutomationProperties.Name="Локальный HTTP-сервер"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,18">
            <TextBlock Text="Локальный HTTP-сервер нужен для оверлея чата в OBS и обратных вызовов локальных сервисов."
                       Foreground="{DynamicResource Fg.Secondary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14" />

            <StackPanel Visibility="{Binding IsPortEditable, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,0,14">
                <TextBlock Text="Порт HTTP-сервера"
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Margin="0,0,0,4" />
                <WrapPanel>
                    <TextBox Style="{StaticResource TextBox.Form}"
                             Width="120"
                             AutomationProperties.Name="Порт HTTP-сервера"
                             Text="{Binding PortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             keepshell:PlaceholderBehavior.Placeholder="8080"
                             Margin="0,0,8,0" />
                    <Button Content="Проверить порт"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding RetryCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding PortErrorText}"
                           Foreground="{DynamicResource State.ErrorText}"
                           FontSize="{DynamicResource Font.Size.S}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           Visibility="{Binding HasPortError, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <Border Background="{DynamicResource Bg.SurfaceAlt}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.S}"
                    Padding="14,12"
                    Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,6">
                        <TextBlock Text="Статус:"
                                   Foreground="{DynamicResource Fg.Muted}"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   Width="120"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}"
                                   keepshell:SeverityBrushBehavior.Foreground="{Binding StatusSeverity}"
                                   FontWeight="SemiBold"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{Binding DetailsText}"
                               Foreground="{DynamicResource Fg.Secondary}"
                               FontSize="{DynamicResource Font.Size.S}"
                               TextWrapping="Wrap"
                               Visibility="{Binding DetailsText, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </Border>

            <Button Content="Повторить проверку"
                    Style="{StaticResource Button.Secondary}"
                    Command="{Binding RetryCommand}"
                    Visibility="{Binding IsRetryVisible, Converter={StaticResource BoolToVisibility}}"
                    HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
