<UserControl x:Class="PoproshaykaBot.Wpf.Views.Onboarding.HealthCheckPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Onboarding"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HealthCheckPageViewModel}"
             d:DesignHeight="420"
             d:DesignWidth="688">

    <ScrollViewer AutomationProperties.Name="Проверка готовности"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,18">

            <TextBlock Text="OBS Browser Source"
                       FontWeight="SemiBold"
                       FontSize="{DynamicResource Font.Size.M}"
                       Foreground="{DynamicResource Fg.Primary}"
                       Margin="0,0,0,6" />

            <WrapPanel Margin="0,0,0,4"
                       VerticalAlignment="Center">
                <TextBlock Text="Адрес для Browser Source в OBS: "
                           Foreground="{DynamicResource Fg.Secondary}"
                           FontSize="{DynamicResource Font.Size.S}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding OverlayUrl}"
                           FontFamily="{DynamicResource Font.Mono}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Foreground="{DynamicResource Fg.Primary}"
                           VerticalAlignment="Center" />
            </WrapPanel>

            <TextBlock Text="{Binding OverlayHint}"
                       Foreground="{DynamicResource Fg.Secondary}"
                       FontSize="{DynamicResource Font.Size.S}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <WrapPanel Margin="0,0,0,16"
                       VerticalAlignment="Center">
                <Button Style="{StaticResource Button.Secondary}"
                        Content="Скопировать"
                        Command="{Binding CopyOverlayUrlCommand}"
                        AutomationProperties.Name="Скопировать адрес оверлея"
                        Margin="0,0,8,4" />
                <Button Style="{StaticResource Button.Secondary}"
                        Content="Открыть в браузере"
                        Command="{Binding OpenOverlayInBrowserCommand}"
                        Margin="0,0,10,4" />
                <TextBlock Text="{Binding OverlayCopyFeedback}"
                           keepshell:SeverityBrushBehavior.Foreground="{Binding OverlayCopyFeedbackSeverity}"
                           FontSize="{DynamicResource Font.Size.S}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Visibility="{Binding OverlayCopyFeedback, Converter={StaticResource NullToVisibility}}"
                           Margin="0,0,0,4" />
            </WrapPanel>

            <Separator Background="{DynamicResource Border.Subtle}"
                       Margin="0,0,0,16" />

            <TextBlock Text="Статус бота в чате"
                       FontWeight="SemiBold"
                       FontSize="{DynamicResource Font.Size.M}"
                       Foreground="{DynamicResource Fg.Primary}"
                       Margin="0,0,0,6" />

            <TextBlock Text="{Binding BotStatusText}"
                       FontSize="{DynamicResource Font.Size.S}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BotStatusKnown}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource State.SuccessText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Separator Background="{DynamicResource Border.Subtle}"
                       Margin="0,0,0,16" />

            <Border Background="{DynamicResource Bg.Base}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.S}"
                    Padding="14,12">
                <StackPanel>
                    <TextBlock Text="Тест отправки сообщения"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource Font.Size.M}"
                               Foreground="{DynamicResource Fg.Primary}"
                               Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,8"
                                Visibility="{Binding ShowPlatformSelector, Converter={StaticResource BoolToVisibility}}">
                        <RadioButton Style="{StaticResource ToggleButton.Toolbar}"
                                     GroupName="HealthCheckPlatform"
                                     Content="Twitch"
                                     IsChecked="{Binding IsTwitchSelected, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource ToggleButton.Toolbar}"
                                     GroupName="HealthCheckPlatform"
                                     Content="YouTube"
                                     Margin="6,0,0,0"
                                     IsChecked="{Binding IsYouTubeSelected, Mode=TwoWay}" />
                    </StackPanel>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource TextBox.Form}"
                                 Text="{Binding ChatTestMessage, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Текст тестового сообщения"
                                 keepshell:PlaceholderBehavior.Placeholder="Введите тестовое сообщение"
                                 PreviewKeyDown="OnChatTestInputPreviewKeyDown"
                                 Margin="0,0,8,0" />
                        <Button Grid.Column="1"
                                Style="{StaticResource Button.Secondary}"
                                Content="Отправить тест"
                                Command="{Binding SendChatTestCommand}" />
                    </Grid>

                    <WrapPanel VerticalAlignment="Center">
                        <iconPacks:PackIconLucide Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center"
                                                  keepshell:SeverityBrushBehavior.Foreground="{Binding ChatTestSeverity}"
                                                  Margin="0,0,6,0">
                            <iconPacks:PackIconLucide.Style>
                                <Style TargetType="iconPacks:PackIconLucide">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChatTestSeverity}" Value="Success">
                                            <Setter Property="Kind" Value="Check" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ChatTestSeverity}" Value="Warning">
                                            <Setter Property="Kind" Value="TriangleAlert" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ChatTestSeverity}" Value="Error">
                                            <Setter Property="Kind" Value="X" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconLucide.Style>
                        </iconPacks:PackIconLucide>
                        <TextBlock Text="{Binding ChatTestStatusText}"
                                   keepshell:SeverityBrushBehavior.Foreground="{Binding ChatTestSeverity}"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite" />
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
