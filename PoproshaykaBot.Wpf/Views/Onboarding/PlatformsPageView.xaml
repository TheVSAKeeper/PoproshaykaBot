<UserControl x:Class="PoproshaykaBot.Wpf.Views.Onboarding.PlatformsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Onboarding"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PlatformsPageViewModel}"
             d:DesignHeight="400"
             d:DesignWidth="688">

    <ScrollViewer AutomationProperties.Name="Площадки трансляции"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,18">
            <TextBlock Text="Выберите, какие площадки будет обслуживать бот. Вы можете подключить одну площадку или обе сразу в режиме мультистрима."
                       Foreground="{DynamicResource Fg.Secondary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <Border Background="{DynamicResource Bg.Base}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.M}"
                    Padding="14"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding TwitchEnabled, Mode=TwoWay}"
                              AutomationProperties.Name="Включить Twitch"
                              VerticalAlignment="Top"
                              Margin="0,2,12,0" />

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,4">
                            <Path Data="{StaticResource Icon.Platform.Twitch}"
                                  Fill="{StaticResource Brush.Platform.Twitch}"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                            <TextBlock Text="Twitch"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource Font.Size.M}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Чат, команды и начисления, опросы, управление трансляцией и локальный оверлей."
                                   Foreground="{DynamicResource Fg.Secondary}"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            CornerRadius="{DynamicResource Radius.S}"
                            Padding="8,3"
                            VerticalAlignment="Top"
                            Margin="12,0,0,0"
                            keepshell:SeverityBrushBehavior.SoftBackground="{Binding TwitchStatusSeverity}">
                        <TextBlock Text="{Binding TwitchStatusText}"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   FontWeight="SemiBold"
                                   keepshell:SeverityBrushBehavior.Foreground="{Binding TwitchStatusSeverity}" />
                    </Border>
                </Grid>
            </Border>

            <Border Background="{DynamicResource Bg.Base}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.M}"
                    Padding="14"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding YouTubeEnabled, Mode=TwoWay}"
                              AutomationProperties.Name="Включить YouTube"
                              VerticalAlignment="Top"
                              Margin="0,2,12,0" />

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,4">
                            <Path Data="{StaticResource Icon.Platform.YouTube}"
                                  Fill="{StaticResource Brush.Platform.YouTube}"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                            <TextBlock Text="YouTube"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource Font.Size.M}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Чат прямых трансляций через InnerTube и Data API, мониторинг эфира и единый оверлей чата."
                                   Foreground="{DynamicResource Fg.Secondary}"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            CornerRadius="{DynamicResource Radius.S}"
                            Padding="8,3"
                            VerticalAlignment="Top"
                            Margin="12,0,0,0"
                            keepshell:SeverityBrushBehavior.SoftBackground="{Binding YouTubeStatusSeverity}">
                        <TextBlock Text="{Binding YouTubeStatusText}"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   FontWeight="SemiBold"
                                   keepshell:SeverityBrushBehavior.Foreground="{Binding YouTubeStatusSeverity}" />
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="{Binding ValidationErrorText}"
                       Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibility}}"
                       Foreground="{DynamicResource State.ErrorText}"
                       FontSize="{DynamicResource Font.Size.S}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
