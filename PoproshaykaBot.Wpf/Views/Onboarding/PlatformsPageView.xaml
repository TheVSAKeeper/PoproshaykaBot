<UserControl x:Class="PoproshaykaBot.Wpf.Views.Onboarding.PlatformsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Onboarding"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PlatformsPageViewModel}"
             d:DesignHeight="400"
             d:DesignWidth="688">

    <UserControl.Resources>
        <Style x:Key="WizardPlatform.CardCheckBox"
               TargetType="CheckBox">
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Margin"
                    Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Card"
                                Background="{DynamicResource Bg.Base}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.M}"
                                Padding="14"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="CheckMarkBox"
                                        Grid.Column="0"
                                        Width="18"
                                        Height="18"
                                        CornerRadius="4"
                                        Background="{DynamicResource Bg.Base}"
                                        BorderBrush="{DynamicResource Border.Strong}"
                                        BorderThickness="1"
                                        VerticalAlignment="Top"
                                        Margin="0,2,12,0">
                                    <iconPacks:PackIconLucide x:Name="CheckMarkIcon"
                                                              Kind="{x:Static iconPacks:PackIconLucideKind.Check}"
                                                              Width="12"
                                                              Height="12"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Foreground="{DynamicResource Fg.OnAccent}"
                                                              Visibility="Collapsed" />
                                </Border>

                                <ContentPresenter Grid.Column="1" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Border.Strong}" />
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="Card"
                                        Property="Background"
                                        Value="{DynamicResource Accent.Soft}" />
                                <Setter TargetName="CheckMarkBox"
                                        Property="Background"
                                        Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="CheckMarkBox"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="CheckMarkIcon"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent.Focus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer AutomationProperties.Name="Площадки трансляции"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,18">
            <TextBlock Text="Выберите, какие площадки будет обслуживать бот. Вы можете подключить одну площадку или обе сразу в режиме мультистрима."
                       Foreground="{DynamicResource Fg.Secondary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <CheckBox Style="{StaticResource WizardPlatform.CardCheckBox}"
                      IsChecked="{Binding TwitchEnabled, Mode=TwoWay}"
                      AutomationProperties.Name="Включить Twitch"
                      AutomationProperties.HelpText="Чат, команды и начисления, опросы, управление трансляцией и локальный оверлей.">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,4">
                            <Path Data="{StaticResource Icon.Platform.Twitch}"
                                  Fill="{StaticResource Brush.Platform.Twitch}"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                            <TextBlock Text="Twitch"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource Font.Size.M}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Чат, команды и начисления, опросы, управление трансляцией и локальный оверлей."
                                   Foreground="{DynamicResource Fg.Secondary}"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            CornerRadius="{DynamicResource Radius.S}"
                            Padding="8,3"
                            VerticalAlignment="Top"
                            Margin="12,0,0,0"
                            keepshell:SeverityBrushBehavior.SoftBackground="{Binding TwitchStatusSeverity}">
                        <TextBlock Text="{Binding TwitchStatusText}"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   FontWeight="SemiBold"
                                   keepshell:SeverityBrushBehavior.Foreground="{Binding TwitchStatusSeverity}" />
                    </Border>
                </Grid>
            </CheckBox>

            <CheckBox Style="{StaticResource WizardPlatform.CardCheckBox}"
                      IsChecked="{Binding YouTubeEnabled, Mode=TwoWay}"
                      AutomationProperties.Name="Включить YouTube"
                      AutomationProperties.HelpText="Чат прямых трансляций через InnerTube и Data API, мониторинг эфира и единый оверлей чата.">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,4">
                            <Path Data="{StaticResource Icon.Platform.YouTube}"
                                  Fill="{StaticResource Brush.Platform.YouTube}"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                            <TextBlock Text="YouTube"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource Font.Size.M}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Чат прямых трансляций через InnerTube и Data API, мониторинг эфира и единый оверлей чата."
                                   Foreground="{DynamicResource Fg.Secondary}"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            CornerRadius="{DynamicResource Radius.S}"
                            Padding="8,3"
                            VerticalAlignment="Top"
                            Margin="12,0,0,0"
                            keepshell:SeverityBrushBehavior.SoftBackground="{Binding YouTubeStatusSeverity}">
                        <TextBlock Text="{Binding YouTubeStatusText}"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   FontWeight="SemiBold"
                                   keepshell:SeverityBrushBehavior.Foreground="{Binding YouTubeStatusSeverity}" />
                    </Border>
                </Grid>
            </CheckBox>

            <TextBlock Text="{Binding ValidationErrorText}"
                       Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibility}}"
                       Foreground="{DynamicResource State.ErrorText}"
                       FontSize="{DynamicResource Font.Size.S}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
