<UserControl x:Class="PoproshaykaBot.Wpf.Views.Onboarding.AppearancePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:PoproshaykaBot.Wpf.Views.Settings">
    <ScrollViewer AutomationProperties.Name="Оформление"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <settings:AppearanceSettingsView DataContext="{Binding Appearance}"
                                         Margin="16" />
    </ScrollViewer>
</UserControl>
