<UserControl x:Class="PoproshaykaBot.Wpf.Views.Onboarding.CredentialsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Onboarding"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CredentialsPageViewModel}"
             d:DesignHeight="520"
             d:DesignWidth="688">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="20,14,20,0"
                Padding="10,8"
                CornerRadius="{DynamicResource Radius.M}"
                Background="{DynamicResource State.ErrorSoft}"
                BorderBrush="{DynamicResource State.Error}"
                BorderThickness="1"
                Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconLucide Grid.Column="0"
                                          Kind="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}"
                                          Width="16"
                                          Height="16"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource State.ErrorText}"
                                          Margin="0,0,8,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ValidationErrorText}"
                           Foreground="{DynamicResource State.ErrorText}"
                           FontSize="{DynamicResource Font.Size.S}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      AutomationProperties.Name="Настройка Twitch"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16">
                <TextBlock Text="{Binding InstructionText}"
                           Foreground="{DynamicResource Fg.Secondary}"
                           FontSize="{DynamicResource Font.Size.S}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <WrapPanel Margin="0,0,0,12"
                           VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center"
                               Margin="0,0,12,4">
                        <Hyperlink Command="{Binding OpenDevConsoleCommand}"
                                   Foreground="{DynamicResource Fg.Link}">
                            Открыть Twitch Developer Console
                        </Hyperlink>
                    </TextBlock>
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="Скопировать Redirect URI"
                            Command="{Binding CopyRedirectUriCommand}"
                            AutomationProperties.Name="Скопировать Redirect URI"
                            Margin="0,0,10,4" />
                    <TextBlock Text="{Binding RedirectUriCopyFeedback}"
                               Foreground="{DynamicResource Fg.Muted}"
                               FontSize="{DynamicResource Font.Size.S}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="{Binding RedirectUriCopyFeedback, Converter={StaticResource NullToVisibility}}"
                               Margin="0,0,0,4" />
                </WrapPanel>

                <TextBlock Text="{Binding ChannelFieldLabel}"
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Margin="0,0,0,4" />
                <TextBox Style="{StaticResource TextBox.Form}"
                         AutomationProperties.Name="Канал Twitch"
                         Text="{Binding Channel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsChannelReadOnly}"
                         keepshell:PlaceholderBehavior.Placeholder="название_канала"
                         Margin="0,0,0,4" />
                <CheckBox Content="Определить автоматически по аккаунту стримера"
                          IsChecked="{Binding AutoDetectChannel, Mode=TwoWay}"
                          Margin="0,0,0,4" />
                <WrapPanel Visibility="{Binding ChannelStatusText, Converter={StaticResource NullToVisibility}}"
                           Margin="0,0,0,12"
                           VerticalAlignment="Center">
                    <iconPacks:PackIconLucide Width="14"
                                              Height="14"
                                              VerticalAlignment="Center"
                                              keepshell:SeverityBrushBehavior.Foreground="{Binding ChannelStatusSeverity}"
                                              Margin="0,0,6,2">
                        <iconPacks:PackIconLucide.Style>
                            <Style TargetType="iconPacks:PackIconLucide">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChannelStatusSeverity}" Value="Success">
                                        <Setter Property="Kind" Value="Check" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChannelStatusSeverity}" Value="Warning">
                                        <Setter Property="Kind" Value="TriangleAlert" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChannelStatusSeverity}" Value="Error">
                                        <Setter Property="Kind" Value="TriangleAlert" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconLucide.Style>
                    </iconPacks:PackIconLucide>
                    <TextBlock Text="{Binding ChannelStatusText}"
                               keepshell:SeverityBrushBehavior.Foreground="{Binding ChannelStatusSeverity}"
                               FontSize="{DynamicResource Font.Size.S}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,8,2" />
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="Повторить проверку"
                            Command="{Binding RetryChannelValidationCommand}"
                            Visibility="{Binding CanRetryChannelCheck, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Повторить проверку канала"
                            Margin="0,0,0,2" />
                </WrapPanel>

                <TextBlock Text="Client ID (обязательно)"
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Margin="0,0,0,4" />
                <keepshell:RevealableTextBox Password="{Binding ClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Client ID"
                                             keepshell:McpPrivacy.IsSensitive="True"
                                             Margin="0,0,0,4">
                    <keepshell:RevealableTextBox.Resources>
                        <Style TargetType="PasswordBox">
                            <Setter Property="AutomationProperties.Name" Value="Client ID" />
                        </Style>
                        <Style TargetType="TextBox">
                            <Setter Property="AutomationProperties.Name" Value="Client ID" />
                        </Style>
                    </keepshell:RevealableTextBox.Resources>
                </keepshell:RevealableTextBox>

                <TextBlock Text="Client Secret (обязательно)"
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Margin="0,0,0,4" />
                <keepshell:RevealableTextBox Password="{Binding ClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Client Secret"
                                             keepshell:McpPrivacy.IsSensitive="True"
                                             Margin="0,0,0,4">
                    <keepshell:RevealableTextBox.Resources>
                        <Style TargetType="PasswordBox">
                            <Setter Property="AutomationProperties.Name" Value="Client Secret" />
                        </Style>
                        <Style TargetType="TextBox">
                            <Setter Property="AutomationProperties.Name" Value="Client Secret" />
                        </Style>
                    </keepshell:RevealableTextBox.Resources>
                </keepshell:RevealableTextBox>

                <WrapPanel Visibility="{Binding ClientStatusText, Converter={StaticResource NullToVisibility}}"
                           Margin="0,0,0,12"
                           VerticalAlignment="Center">
                    <iconPacks:PackIconLucide Width="14"
                                              Height="14"
                                              VerticalAlignment="Center"
                                              keepshell:SeverityBrushBehavior.Foreground="{Binding ClientStatusSeverity}"
                                              Margin="0,0,6,2">
                        <iconPacks:PackIconLucide.Style>
                            <Style TargetType="iconPacks:PackIconLucide">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ClientStatusSeverity}" Value="Success">
                                        <Setter Property="Kind" Value="Check" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ClientStatusSeverity}" Value="Warning">
                                        <Setter Property="Kind" Value="TriangleAlert" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ClientStatusSeverity}" Value="Error">
                                        <Setter Property="Kind" Value="TriangleAlert" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconLucide.Style>
                    </iconPacks:PackIconLucide>
                    <TextBlock Text="{Binding ClientStatusText}"
                               keepshell:SeverityBrushBehavior.Foreground="{Binding ClientStatusSeverity}"
                               FontSize="{DynamicResource Font.Size.S}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,8,2" />
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="Повторить проверку"
                            Command="{Binding RetryClientValidationCommand}"
                            Visibility="{Binding CanRetryClientCheck, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Повторить проверку ключей"
                            Margin="0,0,0,2" />
                </WrapPanel>

                <TextBlock Text="Redirect URI"
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Margin="0,0,0,4" />
                <TextBox Style="{StaticResource TextBox.Form}"
                         AutomationProperties.Name="Redirect URI"
                         Text="{Binding RedirectUri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         keepshell:PlaceholderBehavior.Placeholder="http://localhost:8080"
                         Margin="0,0,0,4" />
                <TextBlock Text="{Binding PortHintText}"
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Visibility="{Binding PortHintText, Converter={StaticResource NullToVisibility}}"
                           Margin="0,0,0,12" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
