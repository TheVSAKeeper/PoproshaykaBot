<UserControl x:Class="PoproshaykaBot.Wpf.Views.Onboarding.LegacyImportPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Onboarding"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LegacyImportPageViewModel}"
             d:DesignHeight="420"
             d:DesignWidth="688">

    <UserControl.Resources>
        <Style x:Key="WizardImport.SourceCard"
               TargetType="ListBoxItem">
            <Setter Property="Margin"
                    Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Primary}" />
            <Setter Property="AutomationProperties.Name"
                    Value="{Binding Path}" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                Background="{DynamicResource Bg.Base}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.M}"
                                Padding="12"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      Width="18"
                                      Height="18"
                                      VerticalAlignment="Top"
                                      Margin="0,2,10,0">
                                    <Ellipse x:Name="Marker"
                                             Stroke="{DynamicResource Border.Strong}"
                                             StrokeThickness="1"
                                             Fill="{DynamicResource Bg.Base}" />
                                    <Ellipse x:Name="MarkerDot"
                                             Width="8"
                                             Height="8"
                                             Fill="{DynamicResource Accent.Primary}"
                                             Visibility="Collapsed" />
                                </Grid>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Path}"
                                               Foreground="{DynamicResource Fg.Secondary}"
                                               FontSize="{DynamicResource Font.Size.S}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Modified}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Fg.Muted}"
                                               FontSize="{DynamicResource Font.Size.S}"
                                               Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Content}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Note}"
                                               Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}"
                                               Foreground="{DynamicResource Fg.Secondary}"
                                               FontSize="{DynamicResource Font.Size.S}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Border.Strong}" />
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="Card"
                                        Property="Background"
                                        Value="{DynamicResource Accent.Soft}" />
                                <Setter TargetName="Marker"
                                        Property="Stroke"
                                        Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="MarkerDot"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent.Focus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid AutomationProperties.Name="Перенос данных">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,18,20,14">
                <StackPanel Visibility="{Binding HasCompletedImport, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="{Binding Import.Explanation}"
                               Foreground="{DynamicResource Fg.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <TextBlock Text="{Binding Import.BlockedNotice}"
                               Visibility="{Binding Import.BlockedNotice, Converter={StaticResource NullToVisibility}}"
                               Foreground="{DynamicResource State.WarningText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <Button Content="Выбрать папку…"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding Import.PickFolderCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,8" />

                    <TextBlock Text="{Binding Import.PickerNotice}"
                               Visibility="{Binding Import.PickerNotice, Converter={StaticResource NullToVisibility}}"
                               Foreground="{DynamicResource State.WarningText}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,8" />

                    <ListBox x:Name="SourceList"
                             ItemsSource="{Binding Import.Sources}"
                             SelectedItem="{Binding Import.SelectedSource, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource WizardImport.SourceCard}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             Margin="0,6,0,0"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Папки с данными предыдущей версии"
                             IsEnabled="{Binding Import.CanSelectSource}"
                             PreviewKeyDown="OnSourceListPreviewKeyDown">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ItemsPresenter />
                            </ControlTemplate>
                        </ListBox.Template>
                    </ListBox>

                    <TextBlock Text="{Binding Import.AuthorizationNotice}"
                               Visibility="{Binding Import.AuthorizationNotice, Converter={StaticResource NullToVisibility}}"
                               Foreground="{DynamicResource Fg.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />

                    <CheckBox Content="Заменить файлы, которые уже есть"
                              IsChecked="{Binding Import.OverwriteExisting, Mode=TwoWay}"
                              Visibility="{Binding Import.CanOverwriteExisting, Converter={StaticResource BoolToVisibility}}"
                              Margin="0,12,0,0" />

                    <TextBlock Text="{Binding Import.ConflictNotice}"
                               Visibility="{Binding Import.ConflictNotice, Converter={StaticResource NullToVisibility}}"
                               Style="{StaticResource Form.CheckHint}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasCompletedImport, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Visibility="{Binding Import.BusyMessage, Converter={StaticResource NullToVisibility}}"
                                Margin="0,0,0,12">
                        <TextBlock Text="{Binding Import.BusyMessage}"
                                   AutomationProperties.LiveSetting="Polite"
                                   TextWrapping="Wrap" />
                        <ProgressBar IsIndeterminate="True"
                                     Height="4"
                                     Margin="0,6,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding Import.ResultHeadline}"
                               Style="{StaticResource TextBlock.Heading}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />

                    <ItemsControl ItemsSource="{Binding Import.ResultCounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Import.ResultFailures}"
                                  AutomationProperties.Name="Ошибки переноса данных"
                                  Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource State.ErrorText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding Import.ResultUnmigratedNotice}"
                               Visibility="{Binding Import.ResultUnmigratedNotice, Converter={StaticResource NullToVisibility}}"
                               Foreground="{DynamicResource Fg.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <TextBlock Text="{Binding Import.ResultAuthorizationNotice}"
                               Visibility="{Binding Import.ResultAuthorizationNotice, Converter={StaticResource NullToVisibility}}"
                               Foreground="{DynamicResource Fg.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <TextBlock Text="{Binding Import.ResultRestartNotice}"
                               Visibility="{Binding Import.ResultRestartNotice, Converter={StaticResource NullToVisibility}}"
                               Foreground="{DynamicResource State.WarningText}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <Button Content="Повторить выбор папки"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding Import.ResetAfterInterruptionCommand}"
                            Visibility="{Binding IsImportInterrupted, Converter={StaticResource BoolToVisibility}}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0" />

                    <Border Background="{DynamicResource Bg.Base}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.S}"
                            Padding="14,12"
                            Margin="0,14,0,0"
                            Visibility="{Binding HasReadinessSummary, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ReadinessTitle}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource State.InfoText}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProfileComplete}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource State.SuccessText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{Binding ReadinessDescription}"
                                       Foreground="{DynamicResource Fg.Secondary}"
                                       TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding MissingItems}"
                                          Visibility="{Binding HasMissingItems, Converter={StaticResource BoolToVisibility}}"
                                          Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}"
                                                   Foreground="{DynamicResource Fg.Primary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{DynamicResource Bg.Base}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="20,12"
                Visibility="{Binding HasCompletedImport, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel>
                <StackPanel Visibility="{Binding Import.BusyMessage, Converter={StaticResource NullToVisibility}}"
                            Margin="0,0,0,10">
                    <TextBlock Text="{Binding Import.BusyMessage}"
                               AutomationProperties.LiveSetting="Polite"
                               TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True"
                                 Height="4"
                                 Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Visibility="{Binding Import.HasSources, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,0,0,10">
                    <TextBlock Text="{Binding Import.SelectionSummaryTitle}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Import.SelectionSummaryDetail}"
                               Foreground="{DynamicResource Fg.Secondary}"
                               FontSize="{DynamicResource Font.Size.S}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>

                <CheckBox Content="Больше не предлагать перенос при запуске"
                          IsChecked="{Binding Import.NeverAskAgain, Mode=TwoWay}"
                          Visibility="{Binding Import.CanDismiss, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
