<UserControl x:Class="PoproshaykaBot.Wpf.Views.Onboarding.CompletionPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Onboarding"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CompletionPageViewModel}"
             d:DesignHeight="420"
             d:DesignWidth="688">

    <ScrollViewer AutomationProperties.Name="Завершение настройки"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,18">

            <TextBlock Text="{Binding PageTitle}"
                       FontWeight="Bold"
                       FontSize="{DynamicResource Font.Size.L}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <TextBlock Text="{Binding SummaryText}"
                       Foreground="{DynamicResource Fg.Primary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Результат проверки"
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource Button.Ghost}"
                        Content="Повторить проверку"
                        Command="{Binding RevalidateCommand}"
                        AutomationProperties.Name="Повторить проверку настроек" />
            </Grid>

            <ItemsControl ItemsSource="{Binding ValidationItems}"
                          Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Bg.Base}"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.S}"
                                Padding="10,8"
                                Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <iconPacks:PackIconLucide Grid.Column="0"
                                                          Kind="{Binding IconKind}"
                                                          Width="15"
                                                          Height="15"
                                                          VerticalAlignment="Top"
                                                          keepshell:SeverityBrushBehavior.Foreground="{Binding Severity}"
                                                          Margin="0,2,10,0" />

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Fg.Primary}"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   keepshell:SeverityBrushBehavior.Foreground="{Binding Severity}"
                                                   FontSize="{DynamicResource Font.Size.S}"
                                                   FontWeight="SemiBold" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Detail}"
                                               Foreground="{DynamicResource Fg.Secondary}"
                                               FontSize="{DynamicResource Font.Size.S}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="Исправить"
                                        Style="{StaticResource Button.Secondary}"
                                        Command="{Binding DataContext.FixIssueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding TargetStep}"
                                        Visibility="{Binding CanFix, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="{Binding FixAutomationName}"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Visibility="{Binding ShowTwitchChatDisplayOption, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,0,16">
                <TextBlock Text="Аккаунт для отображения чата"
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Margin="0,0,0,6" />

                <WrapPanel Visibility="{Binding CanSelectTwitchChatDisplayAccount, Converter={StaticResource BoolToVisibility}}">
                    <RadioButton Content="{Binding TwitchBotChatDisplayLabel}"
                                 IsChecked="{Binding ChatDisplayAccount, Converter={StaticResource EnumToBoolean}, ConverterParameter=Bot}"
                                 Margin="0,0,16,4" />
                    <RadioButton Content="{Binding TwitchBroadcasterChatDisplayLabel}"
                                 IsChecked="{Binding ChatDisplayAccount, Converter={StaticResource EnumToBoolean}, ConverterParameter=Broadcaster}"
                                 Margin="0,0,0,4" />
                </WrapPanel>

                <TextBlock Text="{Binding SingleTwitchChatDisplayText}"
                           Foreground="{DynamicResource Fg.Primary}"
                           TextWrapping="Wrap"
                           Visibility="{Binding ShowSingleTwitchChatDisplayNotice, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <CheckBox Content="{Binding ConnectionAfterFinishText}"
                      IsChecked="{Binding AutoConnect, Mode=TwoWay}"
                      Margin="0,0,0,4" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
