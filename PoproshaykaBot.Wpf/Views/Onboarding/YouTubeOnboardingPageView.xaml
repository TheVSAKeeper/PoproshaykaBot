<UserControl x:Class="PoproshaykaBot.Wpf.Views.Onboarding.YouTubeOnboardingPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Onboarding"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:YouTubeOnboardingPageViewModel}"
             d:DesignHeight="520"
             d:DesignWidth="688">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,18">
            <TextBlock Text="Подключите YouTube, если хотите читать и отправлять сообщения в чате YouTube-трансляций вместе с Twitch. Если используете только Twitch, просто нажмите «Далее →»."
                       Foreground="{DynamicResource Fg.Secondary}"
                       FontSize="{DynamicResource Font.Size.S}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14" />

            <CheckBox Style="{StaticResource CheckBox.Default}"
                      IsChecked="{Binding Editor.Enabled, Mode=TwoWay}"
                      Content="Включить интеграцию YouTube"
                      Margin="0,0,0,14" />

            <ContentControl Content="{Binding Editor}"
                            Focusable="False" />

            <TextBlock Text="{Binding ValidationHint}"
                       Foreground="{DynamicResource State.WarningText}"
                       FontSize="{DynamicResource Font.Size.S}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Visibility="{Binding HasValidationHint, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Visibility="{Binding Editor.Enabled, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,16,0,0">
                <TextBlock Text="Аккаунт бота (YouTube)"
                           FontWeight="{DynamicResource Font.Weight.SemiBold}"
                           Foreground="{DynamicResource Fg.Primary}"
                           Margin="0,0,0,8" />
                <ContentControl Content="{Binding Editor.Bot}"
                                Focusable="False"
                                Margin="0,0,0,16" />

                <TextBlock Text="Аккаунт стримера (YouTube)"
                           FontWeight="{DynamicResource Font.Weight.SemiBold}"
                           Foreground="{DynamicResource Fg.Primary}"
                           Margin="0,0,0,8" />
                <ContentControl Content="{Binding Editor.Broadcaster}"
                                Focusable="False" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
