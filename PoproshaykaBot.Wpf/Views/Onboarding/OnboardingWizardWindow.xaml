<Window x:Class="PoproshaykaBot.Wpf.Views.Onboarding.OnboardingWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:keepshell="https://schemas.keepshell.dev/wpf"
        xmlns:local="clr-namespace:PoproshaykaBot.Wpf.Views.Onboarding"
        xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Onboarding"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:OnboardingWizardViewModel}"
        Title="Первичная настройка"
        Height="560"
        Width="760"
        MinHeight="480"
        MinWidth="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{DynamicResource Bg.Base}"
        Foreground="{DynamicResource Fg.Primary}"
        FontFamily="{DynamicResource Font.Sans}"
        FontSize="{DynamicResource Font.Size.M}">

    <Window.InputBindings>
        <KeyBinding Key="Escape"
                    Command="{Binding HandleEscapeCommand}" />
    </Window.InputBindings>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="0,0,0,1"
                keepshell:TitleBarBehavior.IsWindowChrome="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Первичная настройка"
                           Margin="14,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Chrome.Button}"
                            keepshell:ChromeAction.Action="Minimize"
                            ToolTip="Свернуть"
                            AutomationProperties.Name="Свернуть">
                        <Path Style="{StaticResource Chrome.Glyph.Minimize}" />
                    </Button>
                    <Button Style="{StaticResource Chrome.Button.Close}"
                            keepshell:ChromeAction.Action="Close"
                            ToolTip="Закрыть"
                            AutomationProperties.Name="Закрыть">
                        <Path Style="{StaticResource Chrome.Glyph.Close}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1"
                    Margin="20,16,20,8">
            <TextBlock x:Name="PageHeaderTitle"
                       Text="{Binding HeaderTitle}"
                       Style="{StaticResource TextBlock.Heading}"
                       Focusable="True"
                       FocusVisualStyle="{x:Null}"
                       AutomationProperties.Name="{Binding HeaderTitle}" />
            <TextBlock Text="{Binding StepIndicator}"
                       Foreground="{DynamicResource Fg.Secondary}"
                       FontSize="{DynamicResource Font.Size.S}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="2"
                Margin="20,4,20,12"
                Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.M}">
            <ContentControl x:Name="PageContentHost"
                            Content="{Binding CurrentPage}"
                            IsEnabled="{Binding IsPageInteractive}" />
        </Border>

        <Border Grid.Row="3"
                Padding="20,0,20,16">
            <local:WizardFooterPanel HorizontalGap="16"
                                     VerticalGap="8">
                <WrapPanel VerticalAlignment="Center">
                    <Button Content="Назад"
                            Visibility="{Binding ShowBackButton, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding BackCommand}"
                            MinWidth="76"
                            Margin="0,0,8,0" />
                    <Button Content="Отложить настройку"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding CancelCommand}"
                            ToolTip="Закрыть мастер и настроить позже"
                            Padding="14,6" />
                </WrapPanel>

                <WrapPanel HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <Button x:Name="SecondaryActionButton"
                            Content="{Binding SecondaryActionText}"
                            Visibility="{Binding HasSecondaryAction, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding SecondaryActionCommand}"
                            IsDefault="False"
                            VerticalAlignment="Center"
                            Padding="14,6"
                            Margin="0,0,8,0" />
                    <ContentControl Content="{Binding}"
                                    IsTabStop="False"
                                    Focusable="False"
                                    VerticalAlignment="Center">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <Button x:Name="NextActionButton"
                                        Content="{Binding NextButtonText}"
                                        Style="{StaticResource Button.Primary}"
                                        Command="{Binding NextCommand}"
                                        IsDefault="True"
                                        VerticalAlignment="Center"
                                        MinWidth="120" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsNextActionSecondary}"
                                                 Value="True">
                                        <Setter TargetName="NextActionButton"
                                                Property="Style"
                                                Value="{StaticResource Button.Secondary}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </WrapPanel>
            </local:WizardFooterPanel>
        </Border>
    </Grid>
</Window>
