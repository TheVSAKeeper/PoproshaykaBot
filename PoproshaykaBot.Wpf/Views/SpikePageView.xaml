<UserControl x:Class="PoproshaykaBot.Wpf.Views.SpikePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SpikePageViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="WPF spike работает"
                               Style="{StaticResource TextBlock.Heading}"
                               Margin="0,0,0,12" />
                    <TextBlock Text="{Binding CoreStatus}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource TextBlock.Subtle}"
                               TextWrapping="Wrap"
                               Text="Переключатель тем в заголовке окна меняет тему вживую (ThemeManager). View подобран ViewLocator-ом по паре IView&lt;SpikePageViewModel&gt;." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
