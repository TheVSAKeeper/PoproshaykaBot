<UserControl x:Class="PoproshaykaBot.Wpf.Views.MultistreamPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:controls="clr-namespace:PoproshaykaBot.Wpf.Views.Controls"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:keepshellVm="clr-namespace:KeepShell.ViewModels;assembly=KeepShell"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:localVm="clr-namespace:PoproshaykaBot.Wpf.ViewModels"
             xmlns:settingsVm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance localVm:MultistreamPageViewModel}"
             d:DesignHeight="720"
             d:DesignWidth="1100">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PoproshaykaBot.Wpf;component/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="SettingsBlockTemplate" DataType="{x:Type settingsVm:SettingsSectionBlockDescriptor}">
                <HeaderedContentControl Style="{StaticResource Form.Panel}"
                                        Header="{Binding Title}"
                                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding Hint}"
                                   Style="{StaticResource Setting.BlockHint}"
                                   Visibility="{Binding Hint, Converter={StaticResource NullToVisibility}}" />
                        <ContentControl Content="{Binding Content}" Focusable="False" />
                    </StackPanel>
                </HeaderedContentControl>
            </DataTemplate>

            <Style x:Key="OverlayScrollViewerStyle" TargetType="ScrollViewer">
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid Background="{TemplateBinding Background}">
                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                        Margin="{TemplateBinding Padding}"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}" />
                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                           HorizontalAlignment="Right"
                                           Width="6"
                                           MinWidth="6"
                                           Background="Transparent"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                           AutomationProperties.Name="Прокрутка">
                                    <ScrollBar.Template>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Style="{StaticResource ScrollBar.PageButton}"
                                                                  Command="ScrollBar.PageUpCommand" />
                                                </Track.DecreaseRepeatButton>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Style="{StaticResource ScrollBar.PageButton}"
                                                                  Command="ScrollBar.PageDownCommand" />
                                                </Track.IncreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border x:Name="Bd"
                                                                        Background="{DynamicResource Bg.ScrollThumb}"
                                                                        CornerRadius="3"
                                                                        Margin="1,0" />
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd"
                                                                                Property="Background"
                                                                                Value="{DynamicResource Bg.ScrollThumbHover}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsDragging" Value="True">
                                                                        <Setter TargetName="Bd"
                                                                                Property="Background"
                                                                                Value="{DynamicResource Accent.Primary}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </ControlTemplate>
                                    </ScrollBar.Template>
                                </ScrollBar>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PlatformCardItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="14,11" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource Chrome.FocusVisual}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationSummary}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="CardBorder"
                                    Background="{DynamicResource Bg.Surface}"
                                    BorderBrush="{DynamicResource Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.L}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource Bg.SurfaceAlt}" />
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Border.Default}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource Accent.Soft}" />
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="Margin" Value="0,0,8,8" />
                        <Setter Property="MinWidth" Value="204" />
                        <Setter Property="Padding" Value="11,8" />
                        <Setter Property="HorizontalAlignment" Value="Left" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PlatformBadgeStyle" TargetType="Border" BasedOn="{StaticResource Badge.Info}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status.StatusBadgeSeverity}" Value="{x:Static keepshellVm:StatusSeverity.Warning}">
                        <Setter Property="Background" Value="{DynamicResource State.WarningSoft}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource State.Warning}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource State.WarningText}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status.StatusBadgeSeverity}" Value="{x:Static keepshellVm:StatusSeverity.Error}">
                        <Setter Property="Background" Value="{DynamicResource State.ErrorSoft}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource State.Error}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource State.ErrorText}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status.StatusBadgeSeverity}" Value="{x:Static keepshellVm:StatusSeverity.Success}">
                        <Setter Property="Background" Value="{DynamicResource State.SuccessSoft}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource State.Success}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource State.SuccessText}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="20,6"
                Margin="-20,12,-20,-20"
                Visibility="{Binding Settings.HasChanges, Converter={StaticResource BoolToVisibility}}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource State.Warning}" />
                    <TextBlock Text="Есть несохранённые изменения"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource State.WarningText}" />
                </StackPanel>

                <Button DockPanel.Dock="Right"
                        Content="Сохранить"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding Settings.SaveCommand}"
                        MinWidth="104" />
                <Button DockPanel.Dock="Right"
                        Content="Отменить изменения"
                        Command="{Binding DiscardUnsavedChangesCommand}"
                        MinWidth="104"
                        Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Settings.IsSaving}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Settings.IsSaving}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MasterColumn" Width="312" />
                <ColumnDefinition x:Name="MasterGapColumn" Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="MasterPane"
                          AutomationProperties.Name="Список площадок"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource OverlayScrollViewerStyle}">
                        <Setter Property="Grid.Column" Value="0" />
                        <Setter Property="Grid.Row" Value="0" />
                        <Setter Property="Grid.ColumnSpan" Value="1" />
                        <Setter Property="Grid.RowSpan" Value="2" />
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                        <Setter Property="Padding" Value="0,0,8,0" />
                        <Setter Property="Margin" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="3" />
                                <Setter Property="Grid.RowSpan" Value="1" />
                                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Text="ПЛОЩАДКИ"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               FontWeight="{DynamicResource Font.Weight.SemiBold}"
                               Foreground="{DynamicResource Fg.Muted}"
                               Margin="4,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox x:Name="PlatformCards"
                             ItemsSource="{Binding Cards}"
                             SelectedItem="{Binding SelectedPlatformCard, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource PlatformCardItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Площадки">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel>
                                    <WrapPanel.Style>
                                        <Style TargetType="WrapPanel">
                                            <Setter Property="ItemWidth" Value="{Binding MasterCardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                    <Setter Property="ItemWidth" Value="{x:Static sys:Double.NaN}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </WrapPanel.Style>
                                </WrapPanel>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Grid.Row" Value="1" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBox">
                                            <ItemsPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type localVm:MultistreamPlatformCard}">
                                <StackPanel>
                                    <Grid MinHeight="28">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:PlatformIconView Grid.Column="0"
                                                                   Platform="{Binding Status.Platform}"
                                                                   ToolTip="{Binding Status.DisplayName}"
                                                                   Width="18"
                                                                   Height="18"
                                                                   Margin="0,0,8,0"
                                                                   VerticalAlignment="Center" />
                                        <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Status.DisplayName}"
                                                       ToolTip="{Binding Status.DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       Foreground="{DynamicResource Fg.Primary}"
                                                       FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.Column="1"
                                                    Margin="6,0,0,0"
                                                    Padding="5,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Badge.Count}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                                    <Condition Binding="{Binding Status.HasMultipleChannels}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status.ChannelCount}"
                                                           FontSize="{DynamicResource Font.Size.Caption}" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{Binding Status.ConnectionActionLabel}"
                                                    Style="{StaticResource Button.Secondary}"
                                                    Visibility="{Binding Status.ShowConnectionAction, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding Status.ToggleConnectionCommand}"
                                                    AutomationProperties.AutomationId="{Binding Status.Platform, StringFormat='MultistreamConnect{0}'}"
                                                    AutomationProperties.Name="{Binding Status.ConnectionActionName}"
                                                    MinHeight="26"
                                                    Padding="10,2"
                                                    FontSize="{DynamicResource Font.Size.S}"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center" />
                                            <Border Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource PlatformBadgeStyle}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status.ShowConnectionAction}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status.StatusBadgeText}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status.StatusBadgeText}"
                                                           FontSize="{DynamicResource Font.Size.Caption}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,6,0,0" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Ellipse Width="6"
                                                     Height="6"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,4,0"
                                                     ToolTip="{Binding Status.BroadcastText}"
                                                     keepshell:SeverityBrushBehavior.Fill="{Binding Status.BroadcastSeverity}" />
                                            <Ellipse Width="6"
                                                     Height="6"
                                                     VerticalAlignment="Center"
                                                     ToolTip="{Binding Status.ChatText}"
                                                     keepshell:SeverityBrushBehavior.Fill="{Binding Status.ChatSeverity}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Status.ChannelName}"
                                                   ToolTip="{Binding Status.ChannelName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   Foreground="{DynamicResource Fg.Secondary}"
                                                   FontSize="{DynamicResource Font.Size.S}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                            <Setter Property="MaxWidth" Value="220" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Grid.Column="2"
                                                Padding="7,1"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                                                                <Condition Binding="{Binding Status.HasMultipleChannels}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status.ChannelCountText}"
                                                       Foreground="{DynamicResource Fg.Secondary}"
                                                       FontSize="{DynamicResource Font.Size.Caption}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Margin="0,6,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <DockPanel Margin="0,0,0,2">
                                            <Ellipse DockPanel.Dock="Left"
                                                     Width="6"
                                                     Height="6"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,5,0"
                                                     keepshell:SeverityBrushBehavior.Fill="{Binding Status.BroadcastSeverity}" />
                                            <TextBlock Text="{Binding Status.BroadcastText}"
                                                       ToolTip="{Binding Status.BroadcastText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       FontSize="{DynamicResource Font.Size.S}"
                                                       keepshell:SeverityBrushBehavior.Foreground="{Binding Status.BroadcastSeverity}" />
                                        </DockPanel>
                                        <DockPanel>
                                            <Ellipse DockPanel.Dock="Left"
                                                     Width="6"
                                                     Height="6"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,5,0"
                                                     keepshell:SeverityBrushBehavior.Fill="{Binding Status.ChatSeverity}" />
                                            <TextBlock Text="{Binding Status.ChatText}"
                                                       ToolTip="{Binding Status.ChatText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       FontSize="{DynamicResource Font.Size.S}"
                                                       keepshell:SeverityBrushBehavior.Foreground="{Binding Status.ChatSeverity}" />
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Text="ОБЩЕЕ"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               FontWeight="{DynamicResource Font.Weight.SemiBold}"
                               Foreground="{DynamicResource Fg.Muted}"
                               Margin="4,10,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Command="{Binding OpenAutomationCommand}"
                            AutomationProperties.AutomationId="MultistreamOpenAutomation"
                            AutomationProperties.Name="Профили и автоматика"
                            Cursor="Hand"
                            HorizontalContentAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Grid.Row" Value="3" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                <Setter Property="Padding" Value="14,11" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Grid.Row" Value="1" />
                                        <Setter Property="Grid.Column" Value="1" />
                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                        <Setter Property="Padding" Value="12,10" />
                                        <Setter Property="Margin" Value="8,0,0,8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CardBorder"
                                        Background="{DynamicResource Bg.Surface}"
                                        BorderBrush="{DynamicResource Border.Subtle}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.L}"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Layers}"
                                                                      Width="16"
                                                                      Height="16"
                                                                      Foreground="{DynamicResource Fg.Secondary}"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,8,0" />
                                            <TextBlock Text="Профили и автоматика"
                                                       Foreground="{DynamicResource Fg.Primary}"
                                                       FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Профили трансляции, рассылка, автоподключение и группы каналов"
                                                   Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Form.Hint}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource Bg.SurfaceAlt}" />
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Border.Default}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsAutomationSelected}" Value="True">
                                        <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource Accent.Soft}" />
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="DetailScroll"
                          AutomationProperties.Name="Параметры площадки"
                          RequestBringIntoView="SuppressNavigationAutoScroll"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource OverlayScrollViewerStyle}">
                        <Setter Property="Grid.Column" Value="2" />
                        <Setter Property="Grid.Row" Value="0" />
                        <Setter Property="Grid.ColumnSpan" Value="1" />
                        <Setter Property="Grid.RowSpan" Value="2" />
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                        <Setter Property="Padding" Value="0,0,12,0" />
                        <Setter Property="MaxHeight" Value="{x:Static sys:Double.PositiveInfinity}" />
                        <Setter Property="Margin" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.Row" Value="1" />
                                <Setter Property="Grid.ColumnSpan" Value="3" />
                                <Setter Property="Grid.RowSpan" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1480" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Площадки не зарегистрированы."
                                   Style="{StaticResource Form.Hint}"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding HasSelectedPlatform, Converter={StaticResource InverseBoolToVisibility}}" />

                        <StackPanel Visibility="{Binding IsPlatformSelected, Converter={StaticResource BoolToVisibility}}">
                            <ContentControl Content="{Binding SelectedCard}" Focusable="False">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate DataType="{x:Type localVm:MultistreamPlatformCard}">
                                        <DockPanel MinHeight="36" Margin="0,0,0,12">
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="12,0,0,0">
                                                <Button Content="{Binding DataContext.HeaderSetupActionLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Style="{StaticResource Button.Primary}"
                                                        Command="{Binding DataContext.OpenSelectedPlatformParametersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Visibility="{Binding DataContext.ShowParametersButtonInHeader, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Content="Войти как бот"
                                                        Style="{StaticResource Button.Primary}"
                                                        Command="{Binding DataContext.OpenSelectedPlatformBotAuthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Visibility="{Binding DataContext.ShowBotAuthButtonInHeader, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>

                                            <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <controls:PlatformIconView Grid.Column="0"
                                                                           Platform="{Binding Status.Platform}"
                                                                           ToolTip="{Binding Status.DisplayName}"
                                                                           Width="22"
                                                                           Height="22"
                                                                           Margin="0,0,8,0"
                                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Status.DisplayName}"
                                                           Foreground="{DynamicResource Fg.Primary}"
                                                           FontSize="{DynamicResource Font.Size.XL}"
                                                           FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                           Text="·"
                                                           Foreground="{DynamicResource Fg.Muted}"
                                                           FontSize="{DynamicResource Font.Size.XL}"
                                                           Margin="8,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Status.ChannelName}"
                                                           ToolTip="{Binding Status.ChannelName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           Foreground="{DynamicResource Fg.Secondary}"
                                                           FontSize="{DynamicResource Font.Size.M}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0" />
                                                <Border Grid.Column="4"
                                                        Style="{StaticResource PlatformBadgeStyle}"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding Status.StatusBadgeText, Converter={StaticResource NullToVisibility}}">
                                                    <TextBlock Text="{Binding Status.StatusBadgeText}"
                                                               FontSize="{DynamicResource Font.Size.Caption}" />
                                                </Border>
                                            </Grid>
                                        </DockPanel>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <Border x:Name="GuidedOverviewCard"
                                    Style="{StaticResource Card.Inset}"
                                    Padding="14,10"
                                    Margin="0,0,0,12"
                                    AutomationProperties.AutomationId="MultistreamGuidedOverviewCard">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                            <Ellipse DockPanel.Dock="Left"
                                                     Width="7"
                                                     Height="7"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0"
                                                     keepshell:SeverityBrushBehavior.Fill="{Binding PlatformReadinessSeverity}" />
                                            <TextBlock Text="{Binding PlatformReadinessText}"
                                                       ToolTip="{Binding PlatformReadinessText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       FontSize="{DynamicResource Font.Size.S}"
                                                       keepshell:SeverityBrushBehavior.Foreground="{Binding PlatformReadinessSeverity}"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>

                                        <DockPanel Grid.Column="1" Margin="0,0,10,0">
                                            <Ellipse DockPanel.Dock="Left"
                                                     Width="7"
                                                     Height="7"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0"
                                                     keepshell:SeverityBrushBehavior.Fill="{Binding AccountReadinessSeverity}" />
                                            <TextBlock Text="{Binding AccountReadinessText}"
                                                       ToolTip="{Binding AccountReadinessText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       FontSize="{DynamicResource Font.Size.S}"
                                                       keepshell:SeverityBrushBehavior.Foreground="{Binding AccountReadinessSeverity}"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>

                                        <DockPanel Grid.Column="2">
                                            <Ellipse DockPanel.Dock="Left"
                                                     Width="7"
                                                     Height="7"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0"
                                                     keepshell:SeverityBrushBehavior.Fill="{Binding ChannelReadinessSeverity}" />
                                            <TextBlock Text="{Binding ChannelReadinessText}"
                                                       ToolTip="{Binding ChannelReadinessText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       FontSize="{DynamicResource Font.Size.S}"
                                                       keepshell:SeverityBrushBehavior.Foreground="{Binding ChannelReadinessSeverity}"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Grid>

                                    <WrapPanel Orientation="Horizontal"
                                               VerticalAlignment="Center"
                                               Margin="0,10,0,-4">
                                        <Button Content="{Binding GuidedPrimaryActionLabel}"
                                                Style="{StaticResource Button.Primary}"
                                                Command="{Binding ExecuteGuidedPrimaryActionCommand}"
                                                AutomationProperties.AutomationId="MultistreamWizardPrimaryAction"
                                                MinHeight="28"
                                                Padding="10,3"
                                                Margin="0,0,8,4"
                                                Visibility="{Binding IsGuidedActionPrimary, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="{Binding GuidedPrimaryActionLabel}"
                                                Style="{StaticResource Button.Secondary}"
                                                Command="{Binding ExecuteGuidedPrimaryActionCommand}"
                                                AutomationProperties.AutomationId="MultistreamWizardPrimaryActionSecondary"
                                                MinHeight="28"
                                                Padding="10,3"
                                                Margin="0,0,8,4"
                                                Visibility="{Binding IsGuidedActionPrimary, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <Button Style="{StaticResource Button.Secondary}"
                                                Command="{Binding OpenAddChannelWizardCommand}"
                                                AutomationProperties.AutomationId="MultistreamWizardAddChannel"
                                                Visibility="{Binding ShowQuickAddChannelButton, Converter={StaticResource BoolToVisibility}}"
                                                MinHeight="28"
                                                Padding="10,3"
                                                Margin="0,0,8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Plus}"
                                                                          Width="13"
                                                                          Height="13"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,5,0" />
                                                <TextBlock Text="Добавить канал" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Button.Secondary}"
                                                Command="{Binding OpenAssignAccountWizardCommand}"
                                                AutomationProperties.AutomationId="MultistreamWizardAssignAccount"
                                                Visibility="{Binding ShowQuickAssignAccountButton, Converter={StaticResource BoolToVisibility}}"
                                                MinHeight="28"
                                                Padding="10,3"
                                                Margin="0,0,8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.KeyRound}"
                                                                          Width="13"
                                                                          Height="13"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,5,0" />
                                                <TextBlock Text="Назначить аккаунт" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Button.Secondary}"
                                                Command="{Binding OpenPlatformSetupWizardCommand}"
                                                AutomationProperties.AutomationId="MultistreamWizardPlatformSetup"
                                                Visibility="{Binding ShowQuickPlatformSetupButton, Converter={StaticResource BoolToVisibility}}"
                                                MinHeight="28"
                                                Padding="10,3"
                                                Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Settings2}"
                                                                          Width="13"
                                                                          Height="13"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,5,0" />
                                                <TextBlock Text="Мастер площадки" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,0,0,14"
                                       VerticalAlignment="Center">
                                <Border Background="{DynamicResource Bg.SurfaceAlt}"
                                        BorderBrush="{DynamicResource Border.Subtle}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.M}"
                                        Padding="2"
                                        Margin="0,0,12,0"
                                        Visibility="{Binding HasPlatformTabs, Converter={StaticResource BoolToVisibility}}">
                                    <WrapPanel>
                                        <RadioButton Style="{StaticResource RadioButton.Segment}"
                                                     GroupName="MultistreamPlatformTabs"
                                                     IsChecked="{Binding IsChannelsTabSelected, Mode=TwoWay}"
                                                     Command="{Binding SelectPlatformTabCommand}"
                                                     CommandParameter="{x:Static localVm:MultistreamPlatformTab.Channels}"
                                                     AutomationProperties.AutomationId="MultistreamTabChannels"
                                                     AutomationProperties.Name="Каналы">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Tv}"
                                                                          Width="14"
                                                                          Height="14"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,6,0" />
                                                <TextBlock Text="Каналы" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource Badge.Count}"
                                                        Padding="6,0"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding HasSelectedPlatformChannels, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding SelectedPlatformChannelCount}"
                                                               FontSize="{DynamicResource Font.Size.Caption}" />
                                                </Border>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource RadioButton.Segment}"
                                                     GroupName="MultistreamPlatformTabs"
                                                     Margin="2,0,0,0"
                                                     IsChecked="{Binding IsAccountsTabSelected, Mode=TwoWay}"
                                                     Command="{Binding SelectPlatformTabCommand}"
                                                     CommandParameter="{x:Static localVm:MultistreamPlatformTab.Accounts}"
                                                     AutomationProperties.AutomationId="MultistreamTabAccounts"
                                                     AutomationProperties.Name="Аккаунты"
                                                     Visibility="{Binding HasPlatformAccounts, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.KeyRound}"
                                                                          Width="14"
                                                                          Height="14"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,6,0" />
                                                <TextBlock Text="Аккаунты" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource Badge.Count}"
                                                        Padding="6,0"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding HasSelectedPlatformAccounts, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding SelectedPlatformAccountCount}"
                                                               FontSize="{DynamicResource Font.Size.Caption}" />
                                                </Border>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource RadioButton.Segment}"
                                                     GroupName="MultistreamPlatformTabs"
                                                     Margin="2,0,0,0"
                                                     IsChecked="{Binding IsParametersTabSelected, Mode=TwoWay}"
                                                     Command="{Binding SelectPlatformTabCommand}"
                                                     CommandParameter="{x:Static localVm:MultistreamPlatformTab.Parameters}"
                                                     AutomationProperties.AutomationId="MultistreamTabParameters"
                                                     AutomationProperties.Name="Параметры и доступ"
                                                     Visibility="{Binding HasPlatformSettings, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Settings2}"
                                                                          Width="14"
                                                                          Height="14"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,6,0" />
                                                <TextBlock Text="Параметры и доступ" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                    </WrapPanel>
                                </Border>

                                <ContentControl Content="{Binding SelectedCard}" Focusable="False">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate DataType="{x:Type localVm:MultistreamPlatformCard}">
                                            <WrapPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,12,4">
                                                    <Ellipse Width="6"
                                                             Height="6"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,5,0"
                                                             keepshell:SeverityBrushBehavior.Fill="{Binding Status.BroadcastSeverity}" />
                                                    <TextBlock Text="{Binding Status.BroadcastText}"
                                                               FontSize="{DynamicResource Font.Size.S}"
                                                               keepshell:SeverityBrushBehavior.Foreground="{Binding Status.BroadcastSeverity}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,12,4">
                                                    <Ellipse Width="6"
                                                             Height="6"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,5,0"
                                                             keepshell:SeverityBrushBehavior.Fill="{Binding Status.ChatSeverity}" />
                                                    <TextBlock Text="{Binding Status.ChatText}"
                                                               FontSize="{DynamicResource Font.Size.S}"
                                                               keepshell:SeverityBrushBehavior.Foreground="{Binding Status.ChatSeverity}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Button Content="{Binding DataContext.HeaderSetupActionLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Style="{StaticResource Button.Primary}"
                                                        MinHeight="30"
                                                        Padding="10,4"
                                                        Command="{Binding DataContext.OpenSelectedPlatformParametersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Visibility="{Binding DataContext.ShowParametersButtonInHeader, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Content="Войти как бот"
                                                        Style="{StaticResource Button.Primary}"
                                                        MinHeight="30"
                                                        Padding="10,4"
                                                        Command="{Binding DataContext.OpenSelectedPlatformBotAuthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Visibility="{Binding DataContext.ShowBotAuthButtonInHeader, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                            </WrapPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </WrapPanel>

                            <ContentControl x:Name="ChannelEditor"
                                            Content="{Binding Catalog}"
                                            Focusable="False"
                                            Visibility="{Binding IsChannelsTabSelected, Converter={StaticResource BoolToVisibility}}" />

                            <ContentControl x:Name="PlatformAccountsHost"
                                            Content="{Binding Accounts}"
                                            Focusable="False"
                                            Visibility="{Binding IsAccountsTabSelected, Converter={StaticResource BoolToVisibility}}" />

                            <ItemsControl x:Name="PlatformSettingsHost"
                                          ItemsSource="{Binding PlatformSettings}"
                                          ItemTemplate="{StaticResource SettingsBlockTemplate}"
                                          Focusable="False"
                                          Visibility="{Binding IsParametersTabSelected, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <GroupBox x:Name="AutomationSection"
                                  AutomationProperties.AutomationId="MultistreamAutomationSection"
                                  AutomationProperties.Name="Профили и автоматика"
                                  Focusable="False"
                                  Visibility="{Binding IsAutomationSelected, Converter={StaticResource BoolToVisibility}}">
                            <GroupBox.Template>
                                <ControlTemplate TargetType="GroupBox">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </GroupBox.Template>
                            <StackPanel>
                                <DockPanel MinHeight="36" Margin="0,0,0,12">
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <TextBlock Text="Профили и автоматика"
                                               AutomationProperties.HeadingLevel="Level2"
                                               Foreground="{DynamicResource Fg.Primary}"
                                               FontSize="{DynamicResource Font.Size.XL}"
                                               FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="· Профили трансляции, рассылка, автозапуск и группы каналов"
                                               ToolTip="Профили трансляции, рассылка, автозапуск и группы каналов"
                                               Foreground="{DynamicResource Fg.Muted}"
                                               FontSize="{DynamicResource Font.Size.S}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                            <Border Background="{DynamicResource Bg.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.M}"
                                    Padding="2"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,14">
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource RadioButton.Segment}"
                                                 GroupName="MultistreamAutomationTabs"
                                                 IsChecked="{Binding IsProfilesTabSelected, Mode=TwoWay}"
                                                 Command="{Binding SelectAutomationTabCommand}"
                                                 CommandParameter="{x:Static localVm:MultistreamAutomationTab.Profiles}"
                                                 AutomationProperties.AutomationId="MultistreamAutoTabProfiles"
                                                 AutomationProperties.Name="Профили трансляции">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ListChecks}"
                                                                      Width="14"
                                                                      Height="14"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,6,0" />
                                            <TextBlock Text="Профили трансляции" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource RadioButton.Segment}"
                                                 GroupName="MultistreamAutomationTabs"
                                                 Margin="2,0,0,0"
                                                 IsChecked="{Binding IsAutomationTabSelected, Mode=TwoWay}"
                                                 Command="{Binding SelectAutomationTabCommand}"
                                                 CommandParameter="{x:Static localVm:MultistreamAutomationTab.Automation}"
                                                 AutomationProperties.AutomationId="MultistreamAutoTabAutomation"
                                                 AutomationProperties.Name="Автоматика">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Bot}"
                                                                      Width="14"
                                                                      Height="14"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,6,0" />
                                            <TextBlock Text="Автоматика" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource RadioButton.Segment}"
                                                 GroupName="MultistreamAutomationTabs"
                                                 Margin="2,0,0,0"
                                                 IsChecked="{Binding IsGroupsTabSelected, Mode=TwoWay}"
                                                 Command="{Binding SelectAutomationTabCommand}"
                                                 CommandParameter="{x:Static localVm:MultistreamAutomationTab.Groups}"
                                                 AutomationProperties.AutomationId="MultistreamAutoTabGroups"
                                                 AutomationProperties.Name="Группы каналов">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Users}"
                                                                      Width="14"
                                                                      Height="14"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,6,0" />
                                            <TextBlock Text="Группы каналов" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                </WrapPanel>
                            </Border>

                            <StackPanel Visibility="{Binding IsProfilesTabSelected, Converter={StaticResource BoolToVisibility}}">
                                <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,12" Padding="12,9">
                                    <TextBlock Text="Профили трансляции сохраняются сразу при подтверждении диалога и не требуют нажатия нижней кнопки «Сохранить»."
                                               Style="{StaticResource Form.Hint}"
                                               Margin="0" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding ProfilesBlocks}"
                                              ItemTemplate="{StaticResource SettingsBlockTemplate}"
                                              Focusable="False" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding LifecycleAndBroadcastBlocks}"
                                          ItemTemplate="{StaticResource SettingsBlockTemplate}"
                                          Focusable="False"
                                          Visibility="{Binding IsAutomationTabSelected, Converter={StaticResource BoolToVisibility}}" />

                                <ItemsControl ItemsSource="{Binding ChannelGroupsBlocks}"
                                              ItemTemplate="{StaticResource SettingsBlockTemplate}"
                                              Focusable="False"
                                              Visibility="{Binding IsGroupsTabSelected, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
