<UserControl x:Class="PoproshaykaBot.Wpf.Views.MultistreamPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PoproshaykaBot.Wpf.Views.Controls"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Settings">
    <UserControl.Resources>
        <DataTemplate x:Key="SettingsBlockTemplate" DataType="{x:Type vm:SettingsSectionBlockDescriptor}">
            <HeaderedContentControl Style="{StaticResource Form.Panel}"
                                    Header="{Binding Title}"
                                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding Hint}"
                               Style="{StaticResource Form.Hint}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"
                               Visibility="{Binding Hint, Converter={StaticResource NullToVisibility}}" />
                    <ContentControl Content="{Binding Content}" Focusable="False" />
                </StackPanel>
            </HeaderedContentControl>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="0,8,0,0"
                Margin="0,12,0,0">
            <WrapPanel HorizontalAlignment="Right">
                <TextBlock Text="Есть несохранённые изменения"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource State.WarningText}"
                           Margin="0,0,12,0"
                           Visibility="{Binding Settings.HasChanges, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Отменить изменения"
                        Command="{Binding DiscardUnsavedChangesCommand}"
                        Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                            <Setter Property="IsEnabled" Value="False" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Settings.HasChanges}" Value="True" />
                                        <Condition Binding="{Binding Settings.IsSaving}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="IsEnabled" Value="True" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Сохранить"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding Settings.SaveCommand}" />
            </WrapPanel>
        </Border>

        <ScrollViewer x:Name="PageScroll"
                      RequestBringIntoView="SuppressNavigationAutoScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Settings.IsSaving}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel MaxWidth="780"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,14,0">
                <ItemsControl x:Name="PlatformCards" ItemsSource="{Binding Cards}" Margin="-6,0,-6,2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid>
                                <UniformGrid.Style>
                                    <Style TargetType="UniformGrid">
                                        <Setter Property="Columns" Value="2" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="1">
                                                <Setter Property="Columns" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </UniformGrid.Style>
                            </UniformGrid>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="PlatformCard" Style="{StaticResource Card}" Padding="16,12" Margin="6,0,6,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <controls:PlatformIconView Platform="{Binding Status.Platform}"
                                                                       ToolTip="{Binding Status.DisplayName}"
                                                                       DockPanel.Dock="Left"
                                                                       Width="20"
                                                                       Height="20"
                                                                       Margin="0,0,8,0"
                                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Status.DisplayName}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Fg.Primary}"
                                                       FontSize="{DynamicResource Font.Size.XL}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Status.ChannelName}"
                                                   ToolTip="{Binding Status.ChannelName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Fg.Secondary}"
                                                   Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding Status.BroadcastText}"
                                                   keepshell:SeverityBrushBehavior.Foreground="{Binding Status.BroadcastSeverity}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Status.ChatText}"
                                                   keepshell:SeverityBrushBehavior.Foreground="{Binding Status.ChatSeverity}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                        <ContentControl x:Name="PlatformControls" Content="{Binding Controls}"
                                                        Visibility="{Binding Controls, Converter={StaticResource NullToVisibility}}"
                                                        Focusable="False" />
                                    </StackPanel>

                                    <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                        <Button Content="{Binding Status.ConnectionActionLabel}"
                                                Style="{StaticResource Button.Primary}"
                                                Visibility="{Binding Status.ShowConnectionAction, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding Status.ToggleConnectionCommand}"
                                                AutomationProperties.AutomationId="{Binding Status.Platform, StringFormat='MultistreamConnect{0}'}"
                                                AutomationProperties.Name="{Binding Status.ConnectionActionName}"
                                                Margin="0,4,8,0" />
                                        <Button x:Name="OpenPlatform"
                                                Content="Настроить канал"
                                                Style="{StaticResource Button.Secondary}"
                                                Command="{Binding DataContext.OpenPlatformCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Status.Platform}"
                                                AutomationProperties.AutomationId="{Binding Status.Platform, StringFormat='MultistreamPageSettings{0}'}"
                                                AutomationProperties.Name="{Binding Status.DisplayName, StringFormat='Настроить канал {0}'}"
                                                Margin="0,4,0,0" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="PlatformCard" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                    <Setter TargetName="PlatformCard" Property="BorderThickness" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status.NeedsBotAuthorization}" Value="True">
                                    <Setter TargetName="OpenPlatform" Property="Content" Value="Войти как бот" />
                                    <Setter TargetName="OpenPlatform" Property="AutomationProperties.Name"
                                            Value="{Binding Status.DisplayName, StringFormat='Войти как бот {0}'}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Площадки не зарегистрированы."
                           Style="{StaticResource Form.Hint}"
                           Margin="0,0,0,10"
                           Visibility="{Binding HasSelectedPlatform, Converter={StaticResource InverseBoolToVisibility}}" />

                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right"
                            Content="Автоматика и профили"
                            Style="{StaticResource Button.Secondary}"
                            AutomationProperties.AutomationId="MultistreamOpenAutomation"
                            Command="{Binding OpenAutomationCommand}"
                            Margin="12,0,0,0" />
                    <TextBlock x:Name="EditorHeading"
                               AutomationProperties.AutomationId="MultistreamEditorPlatform"
                               AutomationProperties.HeadingLevel="Level2"
                               Visibility="{Binding HasSelectedPlatform, Converter={StaticResource BoolToVisibility}}"
                               Text="{Binding EditorTitle}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Fg.Primary}"
                               FontSize="{DynamicResource Font.Size.XL}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>

                <Expander Header="{Binding PlatformSettingsTitle}"
                          Style="{StaticResource Expander.Section}"
                          Visibility="{Binding HasPlatformSettings, Converter={StaticResource BoolToVisibility}}"
                          Margin="0,0,0,14">
                    <ItemsControl ItemsSource="{Binding PlatformSettings}"
                                  ItemTemplate="{StaticResource SettingsBlockTemplate}"
                                  Margin="0,10,0,0" />
                </Expander>

                <ContentControl x:Name="ChannelEditor" Content="{Binding Catalog}"
                                Visibility="{Binding HasSelectedPlatform, Converter={StaticResource BoolToVisibility}}" />

                <Expander x:Name="AutomationSection"
                          Header="Автоматика и профили"
                          AutomationProperties.AutomationId="MultistreamAutomationSection"
                          IsExpanded="{Binding IsAutomationExpanded, Mode=TwoWay}"
                          Focusable="True"
                          Style="{StaticResource Expander.Section}"
                          Margin="0,18,0,0">
                    <ItemsControl ItemsSource="{Binding AutomationSettings}"
                                  ItemTemplate="{StaticResource SettingsBlockTemplate}"
                                  Margin="0,10,0,0" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
