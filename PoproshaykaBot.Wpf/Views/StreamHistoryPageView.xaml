<UserControl x:Class="PoproshaykaBot.Wpf.Views.StreamHistoryPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels"
             xmlns:controls="clr-namespace:KeepShell.Views.Controls;assembly=KeepShell"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StreamHistoryPageViewModel}"
             d:DesignHeight="720"
             d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="120" />
            <RowDefinition Height="5" />
            <RowDefinition Height="*" MinHeight="160" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Margin="16,16,16,8">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource Button.Secondary}"
                    Content="Обновить"
                    Command="{Binding RefreshCommand}" />
            <TextBlock VerticalAlignment="Center"
                       Foreground="{DynamicResource Fg.Muted}"
                       FontSize="{DynamicResource Font.Size.S}"
                       Text="{Binding Summary}" />
        </DockPanel>

        <controls:EmptyState Grid.Row="1"
                             Icon="History"
                             Heading="Стримов пока нет"
                             Description="Сессия появится здесь после первого завершённого стрима."
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             Margin="16"
                             Visibility="{Binding HasSessions, Converter={StaticResource InverseBoolToVisibility}}" />

        <DataGrid x:Name="SessionsGrid"
                  Grid.Row="1"
                  Margin="16,0,16,0"
                  AutomationProperties.Name="Список сессий стрима"
                  Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibility}}"
                  ItemsSource="{Binding Sessions}"
                  SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  CanUserReorderColumns="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Начало"
                                    Binding="{Binding StartedAtFormatted}"
                                    SortMemberPath="StartedAt"
                                    SortDirection="Descending"
                                    Width="130" />
                <DataGridTextColumn Header="Длит."
                                    Binding="{Binding DurationFormatted}"
                                    SortMemberPath="Duration"
                                    Width="80" />
                <DataGridTextColumn Header="Игра"
                                    Binding="{Binding GameFormatted}"
                                    SortMemberPath="GameFormatted"
                                    Width="*" />
                <DataGridTextColumn Header="Сообщ."
                                    Binding="{Binding MessageCountFormatted}"
                                    SortMemberPath="MessageCount"
                                    Width="75" />
                <DataGridTextColumn Header="Чатт."
                                    Binding="{Binding ChatterCountFormatted}"
                                    SortMemberPath="ChatterCount"
                                    Width="60" />
                <DataGridTextColumn Header="Пик зр."
                                    Binding="{Binding PeakViewersFormatted}"
                                    SortMemberPath="PeakViewers"
                                    Width="70" />
                <DataGridTextColumn Header="Средн. зр."
                                    Binding="{Binding AverageViewersFormatted}"
                                    SortMemberPath="AverageViewers"
                                    Width="80" />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="2"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource Border.Default}"
                      Cursor="SizeNS" />

        <Grid Grid.Row="3"
              Margin="16,4,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="180" MinWidth="120" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   Text="Заголовок" />
                        <TextBlock Foreground="{DynamicResource Fg.Secondary}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,1,0,8"
                                   Text="{Binding DetailTitle}" />

                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   Text="Игра" />
                        <TextBlock Foreground="{DynamicResource Fg.Secondary}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,1,0,8"
                                   Text="{Binding DetailGame}" />

                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   Text="Начало" />
                        <TextBlock Foreground="{DynamicResource Fg.Secondary}"
                                   FontFamily="{DynamicResource Font.Mono}"
                                   Margin="0,1,0,8"
                                   Text="{Binding DetailStarted}" />

                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   Text="Окончание" />
                        <TextBlock Foreground="{DynamicResource Fg.Secondary}"
                                   FontFamily="{DynamicResource Font.Mono}"
                                   Margin="0,1,0,8"
                                   Text="{Binding DetailEnded}" />

                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   Text="Длительность" />
                        <TextBlock Foreground="{DynamicResource Fg.Secondary}"
                                   Margin="0,1,0,8"
                                   Text="{Binding DetailDuration}" />

                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   Text="Зрители (пик / средн.)" />
                        <TextBlock Foreground="{DynamicResource Fg.Secondary}"
                                   Margin="0,1,0,8"
                                   Text="{Binding DetailViewers}" />

                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   Text="Сообщений" />
                        <TextBlock Foreground="{DynamicResource Fg.Secondary}"
                                   Margin="0,1,0,8"
                                   Text="{Binding DetailMessages}" />

                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   Text="Чаттеров" />
                        <TextBlock Foreground="{DynamicResource Fg.Secondary}"
                                   Margin="0,1,0,0"
                                   Text="{Binding DetailChatters}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Center"
                          Background="{DynamicResource Border.Default}"
                          Cursor="SizeWE" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Style="{StaticResource TextBlock.Subtle}"
                           FontSize="{DynamicResource Font.Size.XS}"
                           Margin="0,0,0,4"
                           Text="Сегменты" />

                <TextBlock Grid.Row="1"
                           Style="{StaticResource TextBlock.Subtle}"
                           VerticalAlignment="Top"
                           Text="Выберите стрим, чтобы увидеть его сегменты"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasSegments, Converter={StaticResource InverseBoolToVisibility}}" />

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Segments}"
                          AutomationProperties.Name="Сегменты выбранного стрима"
                          Visibility="{Binding HasSegments, Converter={StaticResource BoolToVisibility}}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserSortColumns="False"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Игра"
                                            Binding="{Binding Game}"
                                            Width="*" />
                        <DataGridTextColumn Header="Длит."
                                            Binding="{Binding Duration}"
                                            Width="75" />
                        <DataGridTextColumn Header="Сообщ."
                                            Binding="{Binding Messages}"
                                            Width="70" />
                        <DataGridTextColumn Header="Пик зр."
                                            Binding="{Binding PeakViewers}"
                                            Width="65" />
                        <DataGridTextColumn Header="Средн."
                                            Binding="{Binding AverageViewers}"
                                            Width="65" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <GridSplitter Grid.Column="3"
                          Width="5"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Center"
                          Background="{DynamicResource Border.Default}"
                          Cursor="SizeWE" />

            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Style="{StaticResource TextBlock.Subtle}"
                           FontSize="{DynamicResource Font.Size.XS}"
                           Margin="0,0,0,4"
                           Text="Чаттеры" />

                <TextBlock Grid.Row="1"
                           Style="{StaticResource TextBlock.Subtle}"
                           VerticalAlignment="Top"
                           Text="Выберите стрим, чтобы увидеть его чаттеров"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasChatters, Converter={StaticResource InverseBoolToVisibility}}" />

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Chatters}"
                          AutomationProperties.Name="Чаттеры выбранного стрима"
                          Visibility="{Binding HasChatters, Converter={StaticResource BoolToVisibility}}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserSortColumns="True"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ник"
                                            Binding="{Binding DisplayName}"
                                            SortMemberPath="DisplayName"
                                            Width="*" />
                        <DataGridTextColumn Header="Сообщ."
                                            Binding="{Binding MessageCountFormatted}"
                                            SortMemberPath="MessageCount"
                                            Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
