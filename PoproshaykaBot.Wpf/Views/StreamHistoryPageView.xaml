<UserControl x:Class="PoproshaykaBot.Wpf.Views.StreamHistoryPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels"
             xmlns:controls="clr-namespace:KeepShell.Views.Controls;assembly=KeepShell"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StreamHistoryPageViewModel}"
             d:DesignHeight="720"
             d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Margin="0,0,0,12">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource Button.Secondary}"
                    Content="Обновить"
                    Command="{Binding RefreshCommand}" />
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource TextBlock.Subtle}"
                       Text="{Binding Summary}" />
        </DockPanel>

        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Padding="0"
                Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibility}}">
            <DataGrid x:Name="SessionsGrid"
                      BorderThickness="0"
                      AutomationProperties.Name="Список сессий стрима"
                      ItemsSource="{Binding Sessions}"
                      SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      CanUserReorderColumns="False"
                      SelectionMode="Single"
                      RowStyle="{StaticResource TableRow}"
                      RowBackground="Transparent"
                      AlternatingRowBackground="Transparent"
                      GridLinesVisibility="None">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Начало"
                                        Binding="{Binding StartedAtFormatted}"
                                        SortMemberPath="StartedAt"
                                        SortDirection="Descending"
                                        ElementStyle="{StaticResource MonoCell}"
                                        Width="150" />
                    <DataGridTextColumn Header="Длительность"
                                        Binding="{Binding DurationFormatted}"
                                        SortMemberPath="Duration"
                                        ElementStyle="{StaticResource RightCell}"
                                        HeaderStyle="{StaticResource NumericHeader}"
                                        Width="Auto" />
                    <DataGridTextColumn Header="Игра"
                                        Binding="{Binding GameFormatted}"
                                        SortMemberPath="GameFormatted"
                                        Width="*"
                                        MinWidth="140" />
                    <DataGridTextColumn Header="Сообщ."
                                        Binding="{Binding MessageCountFormatted}"
                                        SortMemberPath="MessageCount"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericHeader}"
                                        Width="95" />
                    <DataGridTextColumn Header="Чаттеры"
                                        Binding="{Binding ChatterCountFormatted}"
                                        SortMemberPath="ChatterCount"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericHeader}"
                                        Width="95" />
                    <DataGridTextColumn Header="Пик зр."
                                        Binding="{Binding PeakViewersFormatted}"
                                        SortMemberPath="PeakViewers"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericHeader}"
                                        Width="90" />
                    <DataGridTextColumn Header="Средн."
                                        Binding="{Binding AverageViewersFormatted}"
                                        SortMemberPath="AverageViewers"
                                        ElementStyle="{StaticResource NumericCell}"
                                        HeaderStyle="{StaticResource NumericHeader}"
                                        Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <GridSplitter Grid.Row="2"
                      ResizeDirection="Rows"
                      Height="12"
                      Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibility}}" />

        <controls:EmptyState Grid.Row="3"
                             Icon="MousePointerClick"
                             Heading="Выберите стрим, чтобы увидеть его детали, сегменты и чаттеров"
                             IconSize="24"
                             Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />

        <Grid Grid.Row="3"
              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="180" MinWidth="120" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   Text="Заголовок" />
                        <TextBlock Foreground="{DynamicResource Fg.Secondary}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,1,0,8"
                                   Text="{Binding DetailTitle}" />

                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   Text="Игра" />
                        <TextBlock Foreground="{DynamicResource Fg.Secondary}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,1,0,8"
                                   Text="{Binding DetailGame}" />

                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   Text="Начало" />
                        <TextBlock Foreground="{DynamicResource Fg.Secondary}"
                                   FontFamily="{DynamicResource Font.Mono}"
                                   Margin="0,1,0,8"
                                   Text="{Binding DetailStarted}" />

                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   Text="Окончание" />
                        <TextBlock Foreground="{DynamicResource Fg.Secondary}"
                                   FontFamily="{DynamicResource Font.Mono}"
                                   Margin="0,1,0,8"
                                   Text="{Binding DetailEnded}" />

                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   Text="Длительность" />
                        <TextBlock Foreground="{DynamicResource Fg.Secondary}"
                                   Margin="0,1,0,8"
                                   Text="{Binding DetailDuration}" />

                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   Text="Зрители (пик / средн.)" />
                        <TextBlock Foreground="{DynamicResource Fg.Secondary}"
                                   Margin="0,1,0,8"
                                   Text="{Binding DetailViewers}" />

                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   Text="Сообщений" />
                        <TextBlock Foreground="{DynamicResource Fg.Secondary}"
                                   Margin="0,1,0,8"
                                   Text="{Binding DetailMessages}" />

                        <TextBlock Style="{StaticResource TextBlock.Subtle}"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   Text="Чаттеров" />
                        <TextBlock Foreground="{DynamicResource Fg.Secondary}"
                                   Margin="0,1,0,0"
                                   Text="{Binding DetailChatters}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns" />

            <Border Grid.Column="2"
                    Style="{StaticResource Card}"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource TextBlock.Subtle}"
                               FontSize="{DynamicResource Font.Size.XS}"
                               Margin="0,0,0,8"
                               Text="Сегменты" />

                    <TextBlock Grid.Row="1"
                               Style="{StaticResource TextBlock.Subtle}"
                               VerticalAlignment="Top"
                               Text="Сегментов нет"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasSegments, Converter={StaticResource InverseBoolToVisibility}}" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Segments}"
                              AutomationProperties.Name="Сегменты выбранного стрима"
                              Visibility="{Binding HasSegments, Converter={StaticResource BoolToVisibility}}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="False"
                              SelectionMode="Single"
                              BorderThickness="0"
                              Background="Transparent"
                              RowStyle="{StaticResource TableRow}"
                              RowBackground="Transparent"
                              AlternatingRowBackground="Transparent"
                              GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Игра"
                                                Binding="{Binding Game}"
                                                Width="*" />
                            <DataGridTextColumn Header="Длит."
                                                Binding="{Binding Duration}"
                                                ElementStyle="{StaticResource RightCell}"
                                                HeaderStyle="{StaticResource NumericHeader}"
                                                Width="80" />
                            <DataGridTextColumn Header="Сообщ."
                                                Binding="{Binding Messages}"
                                                ElementStyle="{StaticResource NumericCell}"
                                                HeaderStyle="{StaticResource NumericHeader}"
                                                Width="80" />
                            <DataGridTextColumn Header="Пик зр."
                                                Binding="{Binding PeakViewers}"
                                                ElementStyle="{StaticResource NumericCell}"
                                                HeaderStyle="{StaticResource NumericHeader}"
                                                Width="75" />
                            <DataGridTextColumn Header="Средн."
                                                Binding="{Binding AverageViewers}"
                                                ElementStyle="{StaticResource NumericCell}"
                                                HeaderStyle="{StaticResource NumericHeader}"
                                                Width="75" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3"
                          ResizeDirection="Columns" />

            <Border Grid.Column="4"
                    Style="{StaticResource Card}"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource TextBlock.Subtle}"
                               FontSize="{DynamicResource Font.Size.XS}"
                               Margin="0,0,0,8"
                               Text="Чаттеры" />

                    <TextBlock Grid.Row="1"
                               Style="{StaticResource TextBlock.Subtle}"
                               VerticalAlignment="Top"
                               Text="Чаттеров нет"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasChatters, Converter={StaticResource InverseBoolToVisibility}}" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Chatters}"
                              AutomationProperties.Name="Чаттеры выбранного стрима"
                              Visibility="{Binding HasChatters, Converter={StaticResource BoolToVisibility}}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              SelectionMode="Single"
                              BorderThickness="0"
                              Background="Transparent"
                              RowStyle="{StaticResource TableRow}"
                              RowBackground="Transparent"
                              AlternatingRowBackground="Transparent"
                              GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ник"
                                                Binding="{Binding DisplayName}"
                                                SortMemberPath="DisplayName"
                                                Width="*" />
                            <DataGridTextColumn Header="Сообщ."
                                                Binding="{Binding MessageCountFormatted}"
                                                SortMemberPath="MessageCount"
                                                ElementStyle="{StaticResource NumericCell}"
                                                HeaderStyle="{StaticResource NumericHeader}"
                                                Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <controls:EmptyState Grid.Row="1"
                             Grid.RowSpan="3"
                             Icon="History"
                             Heading="Стримов пока нет"
                             Description="Сессия появится здесь после первого завершённого стрима."
                             DescriptionMaxWidth="360"
                             Visibility="{Binding HasSessions, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>
