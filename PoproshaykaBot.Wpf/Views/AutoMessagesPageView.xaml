<UserControl x:Class="PoproshaykaBot.Wpf.Views.AutoMessagesPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PoproshaykaBot.Wpf;component/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <CollectionViewSource x:Key="GroupedRules" Source="{Binding Options}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Group" />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="225" MaxWidth="295" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
            <ListBox x:Name="RulesList"
                     ItemsSource="{Binding Source={StaticResource GroupedRules}}"
                     SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                     SelectionChanged="OnRuleSelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Правила автоматических сообщений">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource Setting.GroupHeading}"
                                           Margin="8,8,8,4" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="Настройки выбранного сообщения">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="{Binding SelectedOption.Title}"
                                   FontSize="{DynamicResource Font.Size.XL}"
                                   FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Trigger}"
                                   Foreground="{DynamicResource Fg.Secondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{Binding AudienceText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding AvailabilityText}"
                                   Foreground="{DynamicResource Fg.Secondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding AvailabilityText, Converter={StaticResource NullToVisibility}}" />
                        <StackPanel Margin="0,6,0,0"
                                    Visibility="{Binding IsBroadcast, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding BroadcastStatus}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LastDispatch}"
                                       AutomationProperties.HelpText="Результат последней рассылки"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding LastDispatch, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                        <Button Content="Открыть команду !пока"
                                Command="{Binding OpenFarewellCommandCommand}"
                                Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                Visibility="{Binding IsFarewell, Converter={StaticResource BoolToVisibility}}" />
                        <CheckBox Content="{Binding ToggleLabel}"
                                  IsChecked="{Binding Enabled}"
                                  Style="{StaticResource CheckBox.Default}"
                                  Margin="0,12,0,12" />
                        <TextBlock Text="Текст сообщения" Style="{StaticResource Setting.GroupHeading}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Текст сообщения"
                                 Style="{StaticResource TextBox.Form}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="74"
                                 MaxHeight="150" />
                        <TextBlock Text="{Binding ApplyHint}"
                                   Foreground="{DynamicResource Fg.Secondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Placeholders, StringFormat='Подстановки: {0}'}"
                                   AutomationProperties.HelpText="Неизвестные подстановки останутся в тексте."
                                   Foreground="{DynamicResource Fg.Secondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding Placeholders, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Text="Предпросмотр на примере" Style="{StaticResource Setting.GroupHeading}" Margin="0,12,0,4" />
                        <TextBlock Text="{Binding Preview}"
                                   AutomationProperties.Name="Предпросмотр сообщения"
                                   TextWrapping="Wrap" />
                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding HasInterval, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding IntervalLabel}" Style="{StaticResource Setting.GroupHeading}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{Binding IntervalLabel}"
                                     Style="{StaticResource TextBox.Form}"
                                     Width="125"
                                     HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding IntervalHint}"
                                       Foreground="{DynamicResource Fg.Secondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <WrapPanel Margin="0,10,0,0"
                                   Visibility="{Binding IsBroadcast, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="Открыть цели в «Мультистриме»"
                                    Command="{Binding OpenProfileTargetsCommand}"
                                    Style="{StaticResource Button.Secondary}"
                                    Margin="0,0,8,4" />
                            <Button Content="Отправить сейчас"
                                    Command="{Binding SendNowCommand}"
                                    Style="{StaticResource Button.Secondary}"
                                    Margin="0,0,0,4" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock x:Name="NoticeText"
                               Text="{Binding Notice}"
                               AutomationProperties.LiveSetting="Polite"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"
                               Visibility="{Binding Notice, Converter={StaticResource NullToVisibility}}" />
                    <WrapPanel>
                        <Button Content="Сохранить"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource Button.Primary}"
                                Margin="0,0,8,0" />
                        <Button Content="Отменить изменения"
                                Command="{Binding RevertCommand}"
                                Style="{StaticResource Button.Secondary}"
                                Margin="0,0,8,0" />
                        <Button Content="Вернуть стандартные"
                                Command="{Binding RestoreDefaultsCommand}"
                                Style="{StaticResource Button.Secondary}"
                                Visibility="{Binding CanRestoreDefaults, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
