<UserControl x:Class="PoproshaykaBot.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels"
             xmlns:tiles="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Tiles"
             xmlns:controls="clr-namespace:KeepShell.Views.Controls;assembly=KeepShell"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             d:DesignHeight="720"
             d:DesignWidth="1100">

    <UserControl.Resources>
        <DataTemplate x:Key="DashboardTileChrome"
                      DataType="{x:Type tiles:DashboardTileViewModel}">
            <Border x:Name="TileRoot"
                    Background="{DynamicResource Bg.Surface}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="0,0,0,1"
                    Padding="14,10,14,14">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding ToggleCollapseCommand}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header"
                                            Value="Свернуть плитку" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCollapsed}"
                                                     Value="True">
                                            <Setter Property="Header"
                                                    Value="Развернуть плитку" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                <DockPanel LastChildFill="True">
                    <DockPanel x:Name="TileHeader"
                               DockPanel.Dock="Top"
                               LastChildFill="True"
                               Margin="0,0,0,10">
                        <DockPanel.Resources>
                            <Style x:Key="Button.Icon"
                                   TargetType="Button"
                                   BasedOn="{StaticResource Button.Ghost}">
                                <Setter Property="Width"
                                        Value="{DynamicResource Control.Height.Compact}" />
                                <Setter Property="Height"
                                        Value="{DynamicResource Control.Height.Compact}" />
                                <Setter Property="MinHeight"
                                        Value="{DynamicResource Control.Height.Compact}" />
                                <Setter Property="Padding"
                                        Value="0" />
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Center" />
                                <Setter Property="VerticalContentAlignment"
                                        Value="Center" />
                            </Style>
                        </DockPanel.Resources>

                        <StackPanel x:Name="TileActions"
                                    DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ItemsControl x:Name="TileToolbar"
                                          Style="{StaticResource Toolbar.ItemsControl}"
                                          ItemsSource="{Binding HeaderActions}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,4,0"
                                          Opacity="0.55" />

                            <Button x:Name="TileCollapse"
                                    Style="{StaticResource Button.Icon}"
                                    Opacity="0.55"
                                    Command="{Binding ToggleCollapseCommand}"
                                    AutomationProperties.Name="Свернуть или развернуть плитку">
                                <iconPacks:PackIconLucide Width="14"
                                                          Height="14">
                                    <iconPacks:PackIconLucide.Style>
                                        <Style TargetType="iconPacks:PackIconLucide">
                                            <Setter Property="Kind"
                                                    Value="ChevronDown" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCollapsed}"
                                                             Value="True">
                                                    <Setter Property="Kind"
                                                            Value="ChevronRight" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconLucide.Style>
                                </iconPacks:PackIconLucide>
                            </Button>
                        </StackPanel>

                        <TextBlock x:Name="TileTitle"
                                   Text="{Binding Title}"
                                   ToolTip="{Binding Title}"
                                   FontFamily="{DynamicResource Font.Sans}"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg.Primary}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="VerticalScrollBarVisibility"
                                        Value="Auto" />
                                <Setter Property="VerticalAlignment"
                                        Value="Top" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FillsAvailableSpace}"
                                                 Value="True">
                                        <Setter Property="VerticalScrollBarVisibility"
                                                Value="Disabled" />
                                        <Setter Property="VerticalAlignment"
                                                Value="Stretch" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding GrowsWithSpace}"
                                                 Value="True">
                                        <Setter Property="VerticalAlignment"
                                                Value="Stretch" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <ContentControl Content="{Binding}" />
                    </ScrollViewer>
                </DockPanel>

                <Border x:Name="TileShield"
                        Background="Transparent"
                        Focusable="True"
                        Cursor="SizeAll"
                        AutomationProperties.Name="{Binding Title}"
                        PreviewMouseLeftButtonDown="OnShieldMouseDown"
                        PreviewMouseMove="OnShieldMouseMove"
                        PreviewMouseLeftButtonUp="OnShieldMouseUp"
                        Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="TileRoot"
                         Property="IsMouseOver"
                         Value="True">
                    <Setter TargetName="TileToolbar"
                            Property="Opacity"
                            Value="1" />
                    <Setter TargetName="TileCollapse"
                            Property="Opacity"
                            Value="1" />
                </Trigger>

                <Trigger SourceName="TileRoot"
                         Property="IsKeyboardFocusWithin"
                         Value="True">
                    <Setter TargetName="TileToolbar"
                            Property="Opacity"
                            Value="1" />
                    <Setter TargetName="TileCollapse"
                            Property="Opacity"
                            Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Border Background="{DynamicResource Bg.Base}"
                Visibility="{Binding HasTiles, Converter={StaticResource BoolToVisibility}}">
            <DockPanel LastChildFill="True">
                <Border x:Name="EditToolbar"
                        DockPanel.Dock="Top"
                        Background="{DynamicResource Bg.Surface}"
                        BorderBrush="{DynamicResource Border.Subtle}"
                        BorderThickness="0,0,0,1"
                        Padding="14,8"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="Готово"
                                Command="{Binding ToggleEditCommand}"
                                AutomationProperties.Name="Выйти из режима правки панели"
                                Margin="0,0,8,0" />

                        <Button Content="Отменить"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding UndoCommand}"
                                IsEnabled="{Binding CanUndo}"
                                AutomationProperties.Name="Отменить последнюю правку раскладки"
                                Margin="0,0,8,0" />

                        <Button x:Name="AddTileButton"
                                Content="Добавить плитку"
                                Style="{StaticResource Button.Ghost}"
                                Click="OnAddTileClick"
                                AutomationProperties.Name="Добавить плитку на панель"
                                Margin="0,0,8,0">
                            <Button.ContextMenu>
                                <ContextMenu ItemsSource="{Binding HiddenTiles}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header"
                                                    Value="{Binding Title}" />
                                            <Setter Property="Command"
                                                    Value="{Binding PlacementTarget.DataContext.AddTileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Setter Property="CommandParameter"
                                                    Value="{Binding TypeId}" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button Content="Сбросить"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding ResetLayoutCommand}"
                                AutomationProperties.Name="Сбросить раскладку панели к умолчаниям"
                                Margin="0,0,16,0" />

                        <TextBlock Text="Тяните разделители и плитки; Ctrl+Z – отмена, Escape – выход"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="BandsScroll"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                    <Grid x:Name="BandsGrid"
                          Margin="0,0,-1,-1" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Canvas x:Name="EditOverlay"
                IsHitTestVisible="False" />

        <controls:EmptyState Icon="LayoutDashboard"
                             Heading="Плиток пока нет"
                             Description="Плитки панели появятся здесь после регистрации."
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             Margin="20"
                             Visibility="{Binding HasTiles, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>
