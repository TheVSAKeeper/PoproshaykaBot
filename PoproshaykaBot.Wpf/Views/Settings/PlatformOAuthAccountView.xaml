<UserControl x:Class="PoproshaykaBot.Wpf.Views.Settings.PlatformOAuthAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:infra="clr-namespace:PoproshaykaBot.Wpf.Infrastructure"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PlatformOAuthAccountViewModel}"
             d:DesignWidth="680">

    <StackPanel>
        <TextBlock Text="{Binding RolePurposeHint}"
                   Foreground="{DynamicResource Fg.Muted}"
                   FontSize="{DynamicResource Font.Size.S}"
                   TextWrapping="Wrap"
                   Visibility="{Binding Capabilities.ShowsRolePurposeHint, Converter={StaticResource BoolToVisibility}}"
                   Margin="0,0,0,10" />

        <StackPanel Orientation="Horizontal"
                    Visibility="{Binding Capabilities.ShowsAuthorizationSummary, Converter={StaticResource BoolToVisibility}}"
                    Margin="0,0,0,10">
            <TextBlock Text="Состояние: "
                       Foreground="{DynamicResource Fg.Muted}"
                       FontSize="{DynamicResource Font.Size.S}" />
            <TextBlock Text="{Binding AuthorizationSummary}"
                       Foreground="{DynamicResource Fg.Primary}"
                       FontWeight="{DynamicResource Font.Weight.SemiBold}"
                       FontSize="{DynamicResource Font.Size.S}" />
        </StackPanel>

        <WrapPanel Margin="0,0,0,8">
            <Button Style="{StaticResource Button.Primary}"
                    Content="{Binding EmbeddedAuthorizeButtonText}"
                    Command="{Binding AuthorizeInAppCommand}"
                    ToolTip="Страница авторизации откроется во встроенном окне приложения."
                    Margin="0,0,8,4"
                    Visibility="{Binding ShowEmbeddedAuthorizeButton, Converter={StaticResource BoolToVisibility}}" />
            <Button Style="{StaticResource Button.Secondary}"
                    Content="{Binding OpenBrowserButtonText}"
                    Command="{Binding OpenBrowserCommand}"
                    ToolTip="Откроется системный браузер на странице авторизации."
                    Margin="0,0,8,4"
                    Visibility="{Binding ShowSecondaryBrowserAuthorizeButton, Converter={StaticResource BoolToVisibility}}" />
            <Button Style="{StaticResource Button.Primary}"
                    Content="{Binding OpenBrowserButtonText}"
                    Command="{Binding OpenBrowserCommand}"
                    ToolTip="Откроется системный браузер на странице авторизации."
                    Margin="0,0,8,4"
                    Visibility="{Binding ShowPrimaryBrowserAuthorizeButton, Converter={StaticResource BoolToVisibility}}" />
            <Button Style="{StaticResource Button.Destructive}"
                    Content="Отменить авторизацию"
                    Command="{Binding CancelAuthorizationCommand}"
                    Margin="0,0,0,4"
                    Visibility="{Binding IsAuthorizing, Converter={StaticResource BoolToVisibility}}" />
        </WrapPanel>

        <TextBlock Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource Font.Size.S}"
                   keepshell:SeverityBrushBehavior.Foreground="{Binding StatusSeverity}"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}"
                   Margin="0,0,0,10" />

        <StackPanel Visibility="{Binding Capabilities.ShowsLoginAndRefreshMetadata, Converter={StaticResource BoolToVisibility}}">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Аккаунт:"
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Margin="0,0,8,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding LoginText}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Foreground="{DynamicResource Fg.Primary}" />
            </Grid>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Статус токена:"
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Margin="0,0,8,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding TokenStatusText}"
                           FontSize="{DynamicResource Font.Size.S}"
                           keepshell:SeverityBrushBehavior.Foreground="{Binding TokenStatusSeverity}" />
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Последнее обновление:"
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Margin="0,0,8,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding LastRefreshText}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Foreground="{DynamicResource Fg.Primary}" />
            </Grid>
        </StackPanel>

        <StackPanel Visibility="{Binding Capabilities.ShowsChannelIdentity, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding HasChannelIdentity, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,0,8">
                <TextBlock Text="{Binding Capabilities.ChannelIdentityLabel}"
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}" />
                <TextBlock Text="{Binding ChannelDisplay}"
                           Foreground="{DynamicResource Fg.Primary}"
                           FontSize="{DynamicResource Font.Size.S}" />
            </StackPanel>
        </StackPanel>

        <Expander Style="{StaticResource Expander.Section}"
                  Header="Дополнительные параметры (токены и права)"
                  IsExpanded="False"
                  Margin="0,4,0,0">
            <StackPanel Margin="0,6,0,0">
                <StackPanel Visibility="{Binding Capabilities.ShowsScopeSummaries, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Запрашиваемые права"
                               Foreground="{DynamicResource Fg.Muted}"
                               FontSize="{DynamicResource Font.Size.S}"
                               Margin="0,0,0,2" />
                    <TextBlock Text="{Binding ExpectedScopesSummary}"
                               Foreground="{DynamicResource Fg.Primary}"
                               FontSize="{DynamicResource Font.Size.S}"
                               FontFamily="{DynamicResource Font.Mono}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <TextBlock Text="Выданные права"
                               Foreground="{DynamicResource Fg.Muted}"
                               FontSize="{DynamicResource Font.Size.S}"
                               Margin="0,0,0,2" />
                    <TextBlock Text="{Binding GrantedScopesSummary}"
                               Foreground="{DynamicResource Fg.Primary}"
                               FontSize="{DynamicResource Font.Size.S}"
                               FontFamily="{DynamicResource Font.Mono}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6" />

                    <TextBlock Text="Выданные права отличаются от запрашиваемых – при следующем входе браузер запросит недостающие."
                               Foreground="{DynamicResource Fg.Muted}"
                               FontSize="{DynamicResource Font.Size.S}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasScopeMismatch, Converter={StaticResource BoolToVisibility}}"
                               Margin="0,0,0,8" />

                    <TextBlock Text="{Binding TokenExpirySummary}"
                               Foreground="{DynamicResource Fg.Muted}"
                               FontSize="{DynamicResource Font.Size.S}"
                               Margin="0,0,0,10" />
                </StackPanel>

                <StackPanel Visibility="{Binding Capabilities.SupportsEditableScopes, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Scopes"
                               Foreground="{DynamicResource Fg.Muted}"
                               FontSize="{DynamicResource Font.Size.S}"
                               Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource TextBox.Form}"
                                 AutomationProperties.Name="Scopes"
                                 Text="{Binding ScopesText, UpdateSourceTrigger=PropertyChanged}"
                                 keepshell:PlaceholderBehavior.Placeholder="Список scope через пробел" />
                        <Button Grid.Column="1"
                                Style="{StaticResource Form.RowReset}"
                                Command="{Binding ResetScopesCommand}"
                                ToolTip="{Binding ResetScopesButtonText}"
                                AutomationProperties.Name="{Binding ResetScopesButtonText}" />
                    </Grid>
                </StackPanel>

                <TextBlock Text="Access Token"
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Margin="0,0,0,4" />
                <keepshell:RevealableTextBox Password="{Binding AccessTokenValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Access Token"
                                             infra:RevealableInputAutomation.PropagateName="True"
                                             keepshell:McpPrivacy.IsSensitive="True"
                                             Margin="0,0,0,8" />

                <TextBlock Text="Refresh Token"
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Margin="0,0,0,4" />
                <keepshell:RevealableTextBox Password="{Binding RefreshTokenValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Refresh Token"
                                             infra:RevealableInputAutomation.PropagateName="True"
                                             keepshell:McpPrivacy.IsSensitive="True"
                                             Margin="0,0,0,10" />

                <WrapPanel>
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="Проверить токен"
                            Margin="0,0,8,4"
                            Command="{Binding ValidateTokenCommand}"
                            Visibility="{Binding Capabilities.SupportsTokenValidation, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="Обновить токен"
                            Margin="0,0,8,4"
                            Command="{Binding RefreshTokenCommand}"
                            Visibility="{Binding Capabilities.SupportsManualTokenRefresh, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="{Binding ResetScopesButtonText}"
                            AutomationProperties.Name="{Binding ResetScopesButtonText}"
                            Margin="0,0,8,4"
                            Command="{Binding ResetScopesCommand}"
                            Visibility="{Binding Capabilities.ShowsScopeSummaries, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Button.Destructive}"
                            Content="Очистить токены"
                            Margin="0,0,0,4"
                            Command="{Binding ClearCommand}" />
                </WrapPanel>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
