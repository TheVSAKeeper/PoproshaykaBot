<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <sys:Double x:Key="Setting.ContentWidth">780</sys:Double>
    <sys:Double x:Key="Setting.NavWidth">220</sys:Double>

    <Style x:Key="Setting.NavIcon"
           TargetType="iconPacks:PackIconLucide">
        <Setter Property="Width"
                Value="16" />
        <Setter Property="Height"
                Value="16" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="Setting.GroupTitle"
           TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Primary}" />
        <Setter Property="FontWeight"
                Value="{DynamicResource Font.Weight.SemiBold}" />
        <Setter Property="Margin"
                Value="0,24,0,10" />
    </Style>

    <Style x:Key="Setting.BlockTitle"
           TargetType="TextBlock"
           BasedOn="{StaticResource Setting.GroupTitle}">
        <Setter Property="Margin"
                Value="0,20,0,10" />
    </Style>

    <Style x:Key="Setting.Divider"
           TargetType="Border">
        <Setter Property="Height"
                Value="1" />
        <Setter Property="Background"
                Value="{DynamicResource Border.Subtle}" />
        <Setter Property="Margin"
                Value="0,24,0,0" />
    </Style>

    <Style x:Key="Setting.Panel"
           TargetType="HeaderedContentControl">
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Primary}" />
        <Setter Property="VerticalAlignment"
                Value="Top" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border Style="{StaticResource Card.Inset}">
                        <StackPanel>
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="{DynamicResource Fg.Primary}"
                                              TextElement.FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                              TextElement.FontSize="{DynamicResource Font.Size.L}" />
                            <ContentPresenter Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
