<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="Setting.ContentWidth">780</sys:Double>

    <Style x:Key="Setting.GroupTitle"
           TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Primary}" />
        <Setter Property="FontWeight"
                Value="{DynamicResource Font.Weight.SemiBold}" />
        <Setter Property="Margin"
                Value="0,24,0,10" />
    </Style>

    <Style x:Key="Setting.BlockTitle"
           TargetType="TextBlock"
           BasedOn="{StaticResource Setting.GroupTitle}">
        <Setter Property="Margin"
                Value="0,20,0,10" />
    </Style>

    <Style x:Key="Setting.Divider"
           TargetType="Border">
        <Setter Property="Height"
                Value="1" />
        <Setter Property="Background"
                Value="{DynamicResource Border.Subtle}" />
        <Setter Property="Margin"
                Value="0,24,0,0" />
    </Style>

</ResourceDictionary>
