<UserControl x:Class="PoproshaykaBot.Wpf.Views.Settings.BroadcastProfilesSettingsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PoproshaykaBot.Wpf.Views.Controls">
    <StackPanel DataContext="{Binding Profiles, Mode=OneTime}">
        <TextBlock Text="{Binding UnsavedNotice}"
                   Style="{StaticResource Form.Hint}"
                   Foreground="{DynamicResource State.WarningText}"
                   AutomationProperties.LiveSetting="Polite"
                   Visibility="{Binding UnsavedNotice, Converter={StaticResource NullToVisibility}}" />
        <TextBlock Text="{Binding StatusMessage}"
                   AutomationProperties.LiveSetting="Polite"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Form.Hint}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource State.ErrorText}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="Профилей пока нет."
                   Style="{StaticResource Form.Hint}"
                   Visibility="{Binding HasProfiles, Converter={StaticResource InverseBoolToVisibility}}" />
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right"
                                Content="Удалить"
                                Style="{StaticResource Button.Secondary}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Удалить профиль {0}'}"
                                Command="{Binding DeleteCommand}"
                                Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right"
                                Content="Изменить"
                                Style="{StaticResource Button.Secondary}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Изменить профиль {0}'}"
                                Command="{Binding EditCommand}"
                                Margin="12,0,0,0" />
                        <ItemsControl DockPanel.Dock="Right"
                                      ItemsSource="{Binding TargetPlatforms}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:PlatformIconView Platform="{Binding Mode=OneWay}"
                                                               Margin="6,0,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Name}"
                                   Style="{StaticResource Form.Label}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Добавить профиль"
                Style="{StaticResource Button.Secondary}"
                Command="{Binding AddCommand}"
                HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
