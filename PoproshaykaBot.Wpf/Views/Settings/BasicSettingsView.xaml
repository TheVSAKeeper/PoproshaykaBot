<UserControl x:Class="PoproshaykaBot.Wpf.Views.Settings.BasicSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Settings"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BasicSettingsSectionViewModel}"
             d:DesignHeight="320"
             d:DesignWidth="600">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12">
            <TextBlock Text="Основные"
                       Style="{StaticResource TextBlock.Heading}"
                       Margin="0,0,0,12" />

            <TextBlock Text="Канал"
                       Foreground="{DynamicResource Fg.Muted}"
                       FontSize="{DynamicResource Font.Size.S}"
                       Margin="0,0,0,4" />
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right"
                        Content="Сброс"
                        Style="{StaticResource Button.Ghost}"
                        Command="{Binding ResetChannelCommand}"
                        Margin="8,0,0,0" />
                <TextBox Style="{StaticResource TextBox.Form}"
                         Text="{Binding Channel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         keepshell:PlaceholderBehavior.Placeholder="{Binding ChannelPlaceholder}" />
            </DockPanel>

            <TextBlock Text="Аккаунт для отображения чата"
                       Foreground="{DynamicResource Fg.Muted}"
                       FontSize="{DynamicResource Font.Size.S}"
                       Margin="0,0,0,4" />
            <ComboBox Style="{StaticResource ComboBox.Form}"
                      ItemsSource="{Binding ChatAccountOptions}"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Role"
                      SelectedValue="{Binding ChatDisplayAccount, Mode=TwoWay}"
                      HorizontalAlignment="Left"
                      MinWidth="220" />

            <TextBlock Text="ℹ️ Канал – название канала Twitch, к чату которого подключается бот. Аккаунт отображения определяет, от чьего имени бот показывает сообщения в оверлее."
                       Style="{StaticResource TextBlock.Subtle}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Fg.Muted}"
                       Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
