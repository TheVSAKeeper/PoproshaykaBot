<UserControl x:Class="PoproshaykaBot.Wpf.Views.Settings.BasicSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Settings"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BasicSettingsSectionViewModel}"
             d:DesignHeight="320"
             d:DesignWidth="600">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PoproshaykaBot.Wpf;component/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <keepshell:SettingRowPanel Margin="0,0,0,8">
            <TextBlock Text="Аккаунт отображения"
                       Style="{StaticResource Form.Label}"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0" />
            <ComboBox Style="{StaticResource ComboBox.Form}"
                      AutomationProperties.Name="Аккаунт для отображения чата"
                      ItemsSource="{Binding ChatAccountOptions}"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Role"
                      SelectedValue="{Binding ChatDisplayAccount, Mode=TwoWay}"
                      Width="{DynamicResource Setting.ShortFieldWidth}" />
        </keepshell:SettingRowPanel>

        <DockPanel LastChildFill="True"
                   Margin="0,8,0,0">
            <iconPacks:PackIconLucide DockPanel.Dock="Left"
                                      Kind="{x:Static iconPacks:PackIconLucideKind.Info}"
                                      Width="14"
                                      Height="14"
                                      VerticalAlignment="Top"
                                      Margin="0,2,6,0"
                                      Foreground="{DynamicResource Fg.Muted}" />
            <TextBlock Text="Эта настройка определяет, от чьего имени показываются сообщения в оверлее."
                       Style="{StaticResource TextBlock.Subtle}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Fg.Muted}" />
        </DockPanel>

        <Border BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Border.Subtle}"
                Margin="0,12,0,12" />

        <CheckBox Content="Недавняя история чата (recent-messages.robotty.de)"
                  IsChecked="{Binding FetchRecentMessages, Mode=TwoWay}"
                  Style="{StaticResource CheckBox.Default}" />
        <TextBlock Style="{StaticResource Form.CheckHint}"
                   Text="При подключении к Twitch запрашивать последние сообщения через сторонний архив recent-messages.robotty.de. Работает только для публично логируемых каналов."
                   Margin="24,2,0,0" />
    </StackPanel>
</UserControl>
