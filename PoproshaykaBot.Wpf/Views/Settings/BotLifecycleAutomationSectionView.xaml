<UserControl x:Class="PoproshaykaBot.Wpf.Views.Settings.BotLifecycleAutomationSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PoproshaykaBot.Wpf.Views.Controls"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BotLifecycleAutomationSectionViewModel}"
             d:DesignHeight="300"
             d:DesignWidth="600">

    <ItemsControl ItemsSource="{Binding Platforms}"
                  Focusable="False">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:PlatformLifecycleItemViewModel}">
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,10">
                        <controls:PlatformIconView Platform="{Binding Platform}"
                                                   Width="16"
                                                   Height="16"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="{DynamicResource Fg.Primary}"
                                   FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ContentControl Content="{Binding}"
                                    Focusable="False" />
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

</UserControl>
