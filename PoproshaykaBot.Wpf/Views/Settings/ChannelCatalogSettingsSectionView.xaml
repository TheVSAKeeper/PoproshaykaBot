<UserControl x:Class="PoproshaykaBot.Wpf.Views.Settings.ChannelCatalogSettingsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ChannelCatalogSettingsSectionViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="820">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PoproshaykaBot.Wpf;component/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ChannelListItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource Chrome.FocusVisual}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationSummary}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="CardBorder"
                                    Background="{DynamicResource Bg.Surface}"
                                    BorderBrush="{DynamicResource Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.M}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource Bg.SurfaceMute}" />
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Border.Default}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource Accent.Soft}" />
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ChannelStatusLine" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource Font.Size.S}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ChannelRemoveButtonStyle" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                <Setter Property="Background" Value="{DynamicResource State.ErrorSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource State.Error}" />
                <Setter Property="Foreground" Value="{DynamicResource State.ErrorText}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource Radius.M}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource State.ErrorStrong}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <HeaderedContentControl Style="{StaticResource Form.Panel}"
                                Margin="{StaticResource Setting.BlockGap}">
            <HeaderedContentControl.Header>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="Выберите канал для настройки ролей и мониторинга"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Fg.Muted}"
                               FontSize="{DynamicResource Font.Size.S}"
                               FontWeight="Normal"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasChannels}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsNarrowLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding PlatformChannelsTitle}"
                               Foreground="{DynamicResource Fg.Primary}"
                               FontSize="{DynamicResource Font.Size.L}"
                               FontWeight="{DynamicResource Font.Weight.SemiBold}"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="MultistreamEditorPlatform"
                               AutomationProperties.HeadingLevel="Level2" />
                </DockPanel>
            </HeaderedContentControl.Header>

            <StackPanel>
                <StackPanel Visibility="{Binding HasChannels, Converter={StaticResource InverseBoolToVisibility}}">
                    <keepshell:EmptyState Icon="{x:Static iconPacks:PackIconLucideKind.Tv}"
                                          Heading="Каналы ещё не добавлены"
                                          Description="Добавьте канал ниже по логину, ID или ссылке, либо подключите свой канал через вход." />
                    <Button Content="Войти как бот"
                            AutomationProperties.AutomationId="DefaultBotAuthorization"
                            Command="{Binding AuthorizeDefaultBotCommand}"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SupportsDefaultBotAuthorization}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Grid Visibility="{Binding HasChannels, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition>
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTwoColumnCards, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Width" Value="21" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                        <ColumnDefinition>
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTwoColumnCards, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Width" Value="7*" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox ItemsSource="{Binding VisibleChannels}"
                             SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource ChannelListItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Список каналов площадки"
                             AutomationProperties.AutomationId="ChannelCatalogSelection">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="3" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTwoColumnCards, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ItemsPresenter />
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChannelCatalogItemViewModel}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}"
                                               ToolTip="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Fg.Primary}"
                                               FontWeight="{DynamicResource Font.Weight.SemiBold}" />

                                    <TextBlock Text="{Binding RuntimeStatus.BroadcastText}"
                                               ToolTip="{Binding RuntimeStatus.BroadcastDetails}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,6,0,0"
                                               FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                               keepshell:SeverityBrushBehavior.Foreground="{Binding RuntimeStatus.BroadcastSeverity}" />
                                    <WrapPanel>
                                        <TextBlock Text="{Binding RuntimeStatus.ChatText}"
                                                   keepshell:SeverityBrushBehavior.Foreground="{Binding RuntimeStatus.ChatSeverity}"
                                                   Margin="0,0,12,0"
                                                   Style="{StaticResource ChannelStatusLine}" />
                                        <TextBlock Text="{Binding MonitoringSummaryText}"
                                                   Foreground="{DynamicResource Fg.Muted}"
                                                   Style="{StaticResource ChannelStatusLine}"
                                                   Visibility="{Binding SupportsMonitoring, Converter={StaticResource BoolToVisibility}}" />
                                    </WrapPanel>

                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="{Binding BotSummaryText}"
                                                   keepshell:SeverityBrushBehavior.Foreground="{Binding BotSummarySeverity}"
                                                   Margin="0,0,12,0"
                                                   Style="{StaticResource ChannelStatusLine}" />
                                        <TextBlock Text="{Binding BroadcasterSummaryText}"
                                                   keepshell:SeverityBrushBehavior.Foreground="{Binding BroadcasterSummarySeverity}"
                                                   Style="{StaticResource ChannelStatusLine}" />
                                    </WrapPanel>

                                    <WrapPanel Margin="0,8,0,0">
                                        <Grid Margin="0,0,8,0">
                                            <Button Content="Сделать активным"
                                                    Command="{Binding MakeActiveCommand}"
                                                    AutomationProperties.Name="{Binding DisplayName, StringFormat='Сделать активным – {0}'}"
                                                    MinHeight="26"
                                                    Padding="10,2"
                                                    FontSize="{DynamicResource Font.Size.S}"
                                                    HorizontalAlignment="Left">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Border Style="{StaticResource Badge.Success}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Активный" FontSize="{DynamicResource Font.Size.Caption}" />
                                            </Border>
                                        </Grid>
                                        <Border Style="{StaticResource Badge.Info}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsPreselectedNext, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Следующий" FontSize="{DynamicResource Font.Size.Caption}" />
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border BorderBrush="{DynamicResource Border.Subtle}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Grid.Row" Value="1" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="3" />
                                <Setter Property="BorderThickness" Value="0,1,0,0" />
                                <Setter Property="Margin" Value="0,6,0,14" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTwoColumnCards, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Grid.Row" Value="0" />
                                        <Setter Property="Grid.Column" Value="1" />
                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                        <Setter Property="BorderThickness" Value="1,0,0,0" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Stretch" />
                                        <Setter Property="Margin" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <ContentControl x:Name="SelectedChannelEditor"
                                    Content="{Binding SelectedChannel}"
                                    Focusable="False"
                                    Visibility="{Binding SelectedChannel, Converter={StaticResource NullToVisibility}}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Grid.Row" Value="2" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="3" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTwoColumnCards, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Grid.Row" Value="0" />
                                        <Setter Property="Grid.Column" Value="2" />
                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <ContentControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type vm:ChannelCatalogItemViewModel}">
                                <StackPanel>
                                    <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding EditorHeading}"
                                                   Style="{StaticResource Form.SectionTitle}"
                                                   FontSize="{DynamicResource Font.Size.M}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <Border Style="{StaticResource Badge}"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding ChannelId}">
                                            <TextBlock Text="{Binding ChannelId, StringFormat='ID: {0}'}"
                                                       Style="{StaticResource TextBlock.Mono}"
                                                       Foreground="{DynamicResource Fg.Secondary}" />
                                        </Border>
                                    </WrapPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Название">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Form.Label}">
                                                    <Setter Property="Grid.Row" Value="0" />
                                                    <Setter Property="Grid.Column" Value="0" />
                                                    <Setter Property="Grid.ColumnSpan" Value="1" />
                                                    <Setter Property="Width" Value="188" />
                                                    <Setter Property="Margin" Value="0,0,12,0" />
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNarrowLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                            <Setter Property="Grid.ColumnSpan" Value="2" />
                                                            <Setter Property="Width" Value="Auto" />
                                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                                            <Setter Property="Margin" Value="0,0,0,6" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Название канала">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource TextBox.Form}">
                                                    <Setter Property="Grid.Row" Value="0" />
                                                    <Setter Property="Grid.Column" Value="1" />
                                                    <Setter Property="Grid.ColumnSpan" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNarrowLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                            <Setter Property="Grid.Row" Value="1" />
                                                            <Setter Property="Grid.Column" Value="0" />
                                                            <Setter Property="Grid.ColumnSpan" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Roles}"
                                                  Grid.IsSharedSizeScope="True"
                                                  Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ChannelAccountRoleViewModel}">
                                                <Grid Margin="0,0,0,12"
                                                      Visibility="{Binding CanManageAccount, Converter={StaticResource BoolToVisibility}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding Title}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Form.Label}">
                                                                <Setter Property="Grid.Row" Value="0" />
                                                                <Setter Property="Grid.Column" Value="0" />
                                                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                                                <Setter Property="Width" Value="188" />
                                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                                <Setter Property="VerticalAlignment" Value="Top" />
                                                                <Setter Property="Margin" Value="0,8,12,0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNarrowLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                        <Setter Property="Grid.Row" Value="0" />
                                                                        <Setter Property="Grid.Column" Value="0" />
                                                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                                                        <Setter Property="Width" Value="Auto" />
                                                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                                                        <Setter Property="Margin" Value="0,0,0,6" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel>
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Grid.Row" Value="0" />
                                                                <Setter Property="Grid.Column" Value="1" />
                                                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNarrowLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                        <Setter Property="Grid.Row" Value="1" />
                                                                        <Setter Property="Grid.Column" Value="0" />
                                                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition>
                                                                    <ColumnDefinition.Style>
                                                                        <Style TargetType="ColumnDefinition">
                                                                            <Setter Property="Width" Value="Auto" />
                                                                            <Setter Property="SharedSizeGroup" Value="RoleActions" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsNarrowLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                                    <Setter Property="Width" Value="0" />
                                                                                    <Setter Property="SharedSizeGroup" Value="{x:Null}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ColumnDefinition.Style>
                                                                </ColumnDefinition>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid>
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Setter Property="Grid.Row" Value="0" />
                                                                        <Setter Property="Grid.Column" Value="0" />
                                                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsNarrowLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <ComboBox Grid.Column="0"
                                                                          ItemsSource="{Binding Accounts}"
                                                                          SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                                                          IsSynchronizedWithCurrentItem="False"
                                                                          DisplayMemberPath="DisplayName"
                                                                          Style="{StaticResource ComboBox.Form}"
                                                                          AutomationProperties.Name="{Binding Title}"
                                                                          IsEnabled="{Binding CanSelectAccount}" />
                                                                <Button Grid.Column="1"
                                                                        Style="{StaticResource Button.Ghost}"
                                                                        Command="{Binding ClearAssignmentCommand}"
                                                                        ToolTip="Убрать назначенный аккаунт"
                                                                        AutomationProperties.AutomationId="{Binding ClearAutomationId}"
                                                                        AutomationProperties.Name="{Binding Title, StringFormat='Убрать аккаунт. {0}'}"
                                                                        Padding="8,4"
                                                                        Margin="4,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding HasAssignedAccount, Converter={StaticResource BoolToVisibility}}">
                                                                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.X}"
                                                                                              Width="14"
                                                                                              Height="14" />
                                                                </Button>
                                                            </Grid>
                                                            <Grid VerticalAlignment="Center">
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Setter Property="Grid.Row" Value="0" />
                                                                        <Setter Property="Grid.Column" Value="1" />
                                                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                                                        <Setter Property="Margin" Value="8,0,0,0" />
                                                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsNarrowLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                                <Setter Property="Grid.Row" Value="1" />
                                                                                <Setter Property="Grid.Column" Value="0" />
                                                                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                                                                <Setter Property="Margin" Value="0,8,0,0" />
                                                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="RoleVerify" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button Grid.Column="0"
                                                                        Content="Проверить"
                                                                        AutomationProperties.Name="{Binding Title, StringFormat='Проверить доступ. {0}'}"
                                                                        Style="{StaticResource Button.Secondary}"
                                                                        Command="{Binding VerifyCommand}" />
                                                                <Button Grid.Column="1"
                                                                        Content="{Binding AuthorizationLabel}"
                                                                        AutomationProperties.AutomationId="{Binding AuthorizationAutomationId}"
                                                                        Style="{StaticResource Button.Secondary}"
                                                                        Command="{Binding AuthorizeCommand}"
                                                                        HorizontalAlignment="Stretch"
                                                                        Margin="8,0,0,0"
                                                                        Visibility="{Binding CanAuthorize, Converter={StaticResource BoolToVisibility}}" />
                                                            </Grid>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Status}"
                                                                   Style="{StaticResource Form.Hint}"
                                                                   keepshell:SeverityBrushBehavior.Foreground="{Binding StatusSeverity}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <keepshell:SettingRowPanel Margin="0,0,0,4">
                                        <TextBlock Text="Мониторинг"
                                                   Style="{StaticResource Form.Label}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,12,0" />
                                        <CheckBox Content="Фоновый мониторинг эфира"
                                                  Style="{StaticResource CheckBox.Default}"
                                                  IsChecked="{Binding MonitoringEnabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding SupportsMonitoring}" />
                                    </keepshell:SettingRowPanel>

                                    <Border BorderThickness="0,1,0,0"
                                            BorderBrush="{DynamicResource Border.Subtle}"
                                            Margin="0,12,0,0"
                                            Padding="0,10,0,0">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right"
                                                    Content="Удалить канал"
                                                    Style="{StaticResource ChannelRemoveButtonStyle}"
                                                    Command="{Binding RemoveCommand}"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center" />
                                            <TextBlock Text="Удаление уберёт канал из каталога после сохранения изменений."
                                                       Style="{StaticResource Form.Hint}"
                                                       Margin="0"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>
            </StackPanel>
        </HeaderedContentControl>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <HeaderedContentControl Header="Добавление канала">
                <HeaderedContentControl.Style>
                    <Style TargetType="HeaderedContentControl" BasedOn="{StaticResource Form.Panel}">
                        <Setter Property="Grid.Row" Value="0" />
                        <Setter Property="Grid.Column" Value="0" />
                        <Setter Property="Grid.ColumnSpan" Value="3" />
                        <Setter Property="Margin" Value="0,0,0,16" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTwoColumnCards, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="VerticalAlignment" Value="Stretch" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </HeaderedContentControl.Style>
                <StackPanel>
                    <DockPanel Margin="0,0,0,8" IsEnabled="{Binding CanResolveChannel}">
                        <Button DockPanel.Dock="Right"
                                Content="Добавить канал"
                                Style="{StaticResource Button.Secondary}"
                                Command="{Binding AddChannelCommand}"
                                Margin="8,0,0,0" />
                        <TextBox Text="{Binding NewChannelInput, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBox.Form}"
                                 keepshell:PlaceholderBehavior.Placeholder="Логин, ID или ссылка на канал"
                                 AutomationProperties.Name="Логин, ID или ссылка на канал" />
                    </DockPanel>
                    <Button Content="Подключить свой канал"
                            Command="{Binding AuthorizeOwnChannelCommand}"
                            Visibility="{Binding SupportsOwnChannelAuthorization, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource Button.Secondary}"
                            HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding StatusNotice}"
                               Style="{StaticResource Form.Hint}"
                               keepshell:SeverityBrushBehavior.Foreground="{Binding StatusNoticeSeverity}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="{Binding StatusNotice, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Header="Переключение каналов">
                <HeaderedContentControl.Style>
                    <Style TargetType="HeaderedContentControl" BasedOn="{StaticResource Form.Panel}">
                        <Setter Property="Grid.Row" Value="1" />
                        <Setter Property="Grid.Column" Value="0" />
                        <Setter Property="Grid.ColumnSpan" Value="3" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTwoColumnCards, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.Column" Value="2" />
                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="VerticalAlignment" Value="Stretch" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </HeaderedContentControl.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Режим"
                               Style="{StaticResource Form.Label}"
                               Margin="0,0,12,0" />
                    <ComboBox Grid.Row="0"
                              Grid.Column="1"
                              ItemsSource="{Binding SwitchModeOptions}"
                              SelectedItem="{Binding SelectedSwitchModeOption, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Style="{StaticResource ComboBox.Form}"
                              AutomationProperties.Name="Режим переключения" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding SelectedSwitchModeDescription}"
                               Style="{StaticResource Form.Hint}"
                               Margin="0,6,0,0" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Следующий канал"
                               Style="{StaticResource Form.Label}"
                               Margin="0,12,12,0"
                               Visibility="{Binding IsPreselectedNextMode, Converter={StaticResource BoolToVisibility}}" />
                    <ComboBox Grid.Row="2"
                              Grid.Column="1"
                              Margin="0,12,0,0"
                              ItemsSource="{Binding PreselectedNextOptions}"
                              SelectedItem="{Binding SelectedPreselectedNextOption, Mode=TwoWay}"
                              IsSynchronizedWithCurrentItem="False"
                              DisplayMemberPath="DisplayName"
                              Style="{StaticResource ComboBox.Form}"
                              AutomationProperties.Name="Следующий канал"
                              Visibility="{Binding IsPreselectedNextMode, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </HeaderedContentControl>
        </Grid>
    </StackPanel>
</UserControl>
