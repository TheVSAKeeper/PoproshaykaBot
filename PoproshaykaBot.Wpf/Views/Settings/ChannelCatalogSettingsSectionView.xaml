<UserControl x:Class="PoproshaykaBot.Wpf.Views.Settings.ChannelCatalogSettingsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ChannelCatalogSettingsSectionViewModel}"
             d:DesignHeight="420"
             d:DesignWidth="700">

    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Площадка"
                       Style="{StaticResource Setting.RowLabel}"
                       VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding PlatformOptions}"
                      SelectedValue="{Binding SelectedPlatform, Mode=TwoWay}"
                      SelectedValuePath="Platform"
                      DisplayMemberPath="DisplayName"
                      Width="{DynamicResource Setting.ShortFieldWidth}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Режим переключения"
                       Style="{StaticResource Setting.RowLabel}"
                       VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding SwitchModeOptions}"
                      SelectedItem="{Binding SelectedSwitchModeOption, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"
                      Width="320" />
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,12"
                    Visibility="{Binding IsPreselectedNextMode, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Следующий канал"
                       Style="{StaticResource Setting.RowLabel}"
                       VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding PreselectedNextOptions}"
                      SelectedItem="{Binding SelectedPreselectedNextOption, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"
                      Width="320" />
        </StackPanel>

        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right"
                    Content="Добавить канал"
                    Style="{StaticResource Button.Secondary}"
                    Command="{Binding AddChannelCommand}"
                    Margin="8,0,0,0" />
            <TextBox Text="{Binding NewChannelInput, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource TextBox.Form}"
                     AutomationProperties.Name="Логин, ID или ссылка на канал" />
        </DockPanel>

        <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,12"
                    Visibility="{Binding CanAuthorizeAdditionalContext, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Новый контекст"
                       Style="{StaticResource Setting.RowLabel}"
                       VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding AuthRoleOptions}"
                      SelectedValue="{Binding NewContextRole, Mode=TwoWay}"
                      SelectedValuePath="Role"
                      DisplayMemberPath="DisplayName"
                      Width="120"
                      Margin="0,0,8,0" />
            <TextBox Text="{Binding NewContextLabel, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource TextBox.Form}"
                     Width="160"
                     Margin="0,0,8,0"
                     AutomationProperties.Name="Подпись дополнительного контекста" />
            <Button Content="Авторизовать аккаунт"
                    Style="{StaticResource Button.Secondary}"
                    Command="{Binding AuthorizeNewContextCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding StatusNotice}"
                   Style="{StaticResource Form.Hint}"
                   Foreground="{DynamicResource State.WarningText}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Visibility="{Binding StatusNotice, Converter={StaticResource StringNotEmptyToVisibility}}" />

        <ItemsControl ItemsSource="{Binding VisibleChannels}"
                      Visibility="{Binding HasChannels, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ChannelCatalogItemViewModel}">
                    <Border BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            Padding="0,8,0,10"
                            Margin="0,0,0,6">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Сделать активным"
                                            Style="{StaticResource Button.Secondary}"
                                            Command="{Binding MakeActiveCommand}"
                                            Margin="0,0,6,0"
                                            Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <TextBlock Text="Активный"
                                               Foreground="{DynamicResource State.SuccessText}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="Удалить"
                                            Style="{StaticResource Button.Secondary}"
                                            Command="{Binding RemoveCommand}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextBox.Form}"
                                             Width="180"
                                             Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding ChannelId}"
                                               Style="{StaticResource Form.Hint}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>

                            <CheckBox Content="Фоновый мониторинг эфира"
                                      IsChecked="{Binding MonitoringEnabled, Mode=TwoWay}"
                                      Margin="0,0,0,6" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Стример"
                                           Style="{StaticResource Setting.RowLabel}"
                                           VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding DataContext.BroadcasterContextOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValue="{Binding BroadcasterContextId, Mode=TwoWay}"
                                          SelectedValuePath="ContextId"
                                          DisplayMemberPath="DisplayName"
                                          Width="210"
                                          Margin="0,0,8,0" />
                                <Button Content="Проверить"
                                        Style="{StaticResource Button.Secondary}"
                                        Command="{Binding VerifyBroadcasterCommand}"
                                        Margin="0,0,8,0" />
                                <TextBlock Text="{Binding BroadcasterVerificationStatus}"
                                           Style="{StaticResource Form.Hint}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Бот"
                                           Style="{StaticResource Setting.RowLabel}"
                                           VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding DataContext.BotContextOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValue="{Binding BotContextId, Mode=TwoWay}"
                                          SelectedValuePath="ContextId"
                                          DisplayMemberPath="DisplayName"
                                          Width="210"
                                          Margin="0,0,8,0" />
                                <Button Content="Проверить"
                                        Style="{StaticResource Button.Secondary}"
                                        Command="{Binding VerifyBotCommand}"
                                        Margin="0,0,8,0" />
                                <TextBlock Text="{Binding BotVerificationStatus}"
                                           Style="{StaticResource Form.Hint}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Настроенных каналов для площадки пока нет. Введите логин, ID или ссылку выше."
                   Style="{StaticResource Form.Hint}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasChannels, Converter={StaticResource InverseBoolToVisibility}}" />
    </StackPanel>
</UserControl>
