<UserControl x:Class="PoproshaykaBot.Wpf.Views.Settings.PlatformAccountsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:keepshellVm="clr-namespace:KeepShell.ViewModels;assembly=KeepShell"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PlatformAccountsSectionViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="820">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PoproshaykaBot.Wpf;component/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="AccountSignOutButtonStyle" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                <Setter Property="Background" Value="{DynamicResource State.ErrorSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource State.Error}" />
                <Setter Property="Foreground" Value="{DynamicResource State.ErrorText}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource Radius.M}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource State.ErrorStrong}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BotRoleBadgeStyle" TargetType="Border" BasedOn="{StaticResource Badge.Success}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding BotBadgeSeverity}" Value="{x:Static keepshellVm:StatusSeverity.Warning}">
                        <Setter Property="Background" Value="{DynamicResource State.WarningSoft}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource State.Warning}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource State.WarningText}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BotBadgeSeverity}" Value="{x:Static keepshellVm:StatusSeverity.Info}">
                        <Setter Property="Background" Value="{DynamicResource State.InfoSoft}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource State.Info}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource State.InfoText}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="BroadcasterRoleBadgeStyle" TargetType="Border" BasedOn="{StaticResource Badge.Success}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding BroadcasterBadgeSeverity}" Value="{x:Static keepshellVm:StatusSeverity.Warning}">
                        <Setter Property="Background" Value="{DynamicResource State.WarningSoft}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource State.Warning}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource State.WarningText}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BroadcasterBadgeSeverity}" Value="{x:Static keepshellVm:StatusSeverity.Info}">
                        <Setter Property="Background" Value="{DynamicResource State.InfoSoft}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource State.Info}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource State.InfoText}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <HeaderedContentControl Style="{StaticResource Form.Panel}"
                                Margin="{StaticResource Setting.BlockGap}">
            <HeaderedContentControl.Header>
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Command="{Binding ToggleTechnicalModeCommand}"
                            Style="{StaticResource Button.Secondary}"
                            AutomationProperties.AutomationId="PlatformAccountsTechnicalModeToggle"
                            AutomationProperties.Name="Переключить технический вид аккаунтов"
                            MinHeight="28"
                            Padding="10,4"
                            FontSize="{DynamicResource Font.Size.S}"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.SlidersHorizontal}"
                                                      Width="13"
                                                      Height="13"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0" />
                            <TextBlock Text="{Binding TechnicalModeButtonLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding AccountsTitle}"
                               Foreground="{DynamicResource Fg.Primary}"
                               FontSize="{DynamicResource Font.Size.L}"
                               FontWeight="{DynamicResource Font.Weight.SemiBold}"
                               VerticalAlignment="Center"
                               AutomationProperties.HeadingLevel="Level2" />
                </DockPanel>
            </HeaderedContentControl.Header>

            <StackPanel>
                <TextBlock Text="Войдённые аккаунты сохраняются сразу после авторизации и доступны в выпадающих списках ролей всех каналов площадки."
                           Style="{StaticResource Form.Hint}"
                           Margin="0,0,0,12" />

                <WrapPanel Margin="0,0,0,10"
                           Visibility="{Binding CanAuthorize, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Войти (бот + стример)"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding AuthorizeCombinedCommand}"
                            AutomationProperties.AutomationId="PlatformAccountsAuthorizeCombined"
                            ToolTip="Единый вход сразу с правами бота и стримера, чтобы использовать один аккаунт в обеих ролях."
                            Margin="0,0,8,6" />
                    <Button Content="Войти как бот"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding AuthorizeBotCommand}"
                            AutomationProperties.AutomationId="PlatformAccountsAuthorizeBot"
                            Margin="0,0,8,6" />
                    <Button Content="Войти как стример"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding AuthorizeBroadcasterCommand}"
                            AutomationProperties.AutomationId="PlatformAccountsAuthorizeBroadcaster"
                            Margin="0,0,8,6" />
                </WrapPanel>

                <CheckBox Content="Открывать вход в системном браузере вместо встроенного окна"
                          Style="{StaticResource CheckBox.Default}"
                          IsChecked="{Binding UseSystemBrowser, Mode=TwoWay}"
                          Visibility="{Binding SupportsBrowserToggle, Converter={StaticResource BoolToVisibility}}"
                          Margin="0,0,0,10" />

                <TextBlock Text="{Binding StatusNotice}"
                           Style="{StaticResource Form.Hint}"
                           keepshell:SeverityBrushBehavior.Foreground="{Binding StatusNoticeSeverity}"
                           TextWrapping="Wrap"
                           Visibility="{Binding StatusNotice, Converter={StaticResource NullToVisibility}}"
                           Margin="0,0,0,12" />

                <keepshell:EmptyState Icon="{x:Static iconPacks:PackIconLucideKind.KeyRound}"
                                      Heading="Нет подключённых аккаунтов"
                                      Description="Войдите в аккаунт выше, чтобы назначать его ботом или стримером на каналах площадки."
                                      Visibility="{Binding HasAccounts, Converter={StaticResource InverseBoolToVisibility}}" />

                <ItemsControl ItemsSource="{Binding Accounts}"
                              Focusable="False"
                              Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PlatformAccountCardViewModel}">
                            <Border Background="{DynamicResource Bg.Surface}"
                                    BorderBrush="{DynamicResource Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.M}"
                                    Padding="14,12"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <WrapPanel DockPanel.Dock="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0">
                                            <Button Content="+ Бот"
                                                    Style="{StaticResource Button.Secondary}"
                                                    Command="{Binding AddBotRoleCommand}"
                                                    ToolTip="Выдать этому аккаунту права бота"
                                                    MinHeight="26"
                                                    Padding="10,2"
                                                    FontSize="{DynamicResource Font.Size.S}"
                                                    Margin="0,0,6,0"
                                                    Visibility="{Binding CanAddBotRole, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="+ Стример"
                                                    Style="{StaticResource Button.Secondary}"
                                                    Command="{Binding AddBroadcasterRoleCommand}"
                                                    ToolTip="Выдать этому аккаунту права стримера"
                                                    MinHeight="26"
                                                    Padding="10,2"
                                                    FontSize="{DynamicResource Font.Size.S}"
                                                    Margin="0,0,6,0"
                                                    Visibility="{Binding CanAddBroadcasterRole, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="Выйти"
                                                    Style="{StaticResource AccountSignOutButtonStyle}"
                                                    Command="{Binding SignOutCommand}"
                                                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="Удалить токены этого аккаунта"
                                                    MinHeight="26"
                                                    Padding="10,2"
                                                    FontSize="{DynamicResource Font.Size.S}" />
                                        </WrapPanel>

                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{DynamicResource Fg.Primary}"
                                                       FontSize="{DynamicResource Font.Size.M}"
                                                       FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <Border Style="{StaticResource Badge}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding DataContext.IsTechnicalMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"
                                                    Margin="0,0,6,0">
                                                <TextBlock Text="{Binding AccountId, StringFormat='ID: {0}'}"
                                                           Style="{StaticResource TextBlock.Mono}"
                                                           Foreground="{DynamicResource Fg.Secondary}" />
                                            </Border>
                                            <Border Style="{StaticResource BotRoleBadgeStyle}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,6,0"
                                                    Visibility="{Binding HasBotRole, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Бот" FontSize="{DynamicResource Font.Size.Caption}" />
                                            </Border>
                                            <Border Style="{StaticResource BroadcasterRoleBadgeStyle}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,6,0"
                                                    Visibility="{Binding HasBroadcasterRole, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Стример" FontSize="{DynamicResource Font.Size.Caption}" />
                                            </Border>
                                        </WrapPanel>
                                    </DockPanel>

                                    <TextBlock Text="{Binding AssignedChannelsText}"
                                               Foreground="{DynamicResource Fg.Muted}"
                                               FontSize="{DynamicResource Font.Size.S}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8" />

                                    <Border Background="{DynamicResource Bg.Base}"
                                            BorderBrush="{DynamicResource Border.Subtle}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource Radius.S}"
                                            Padding="10,7"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding OAuthMethodLabel}"
                                                           Foreground="{DynamicResource Fg.Muted}"
                                                           FontSize="{DynamicResource Font.Size.Caption}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"
                                                           Visibility="{Binding HasOAuthMethodLabel, Converter={StaticResource BoolToVisibility}}" />
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="7"
                                                             Height="7"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,7,0"
                                                             keepshell:SeverityBrushBehavior.Fill="{Binding ApiAuthStatusSeverity}" />
                                                    <TextBlock Text="{Binding ApiAuthStatusText}"
                                                               keepshell:SeverityBrushBehavior.Foreground="{Binding ApiAuthStatusSeverity}"
                                                               FontSize="{DynamicResource Font.Size.S}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Margin="0,6,0,0"
                                                       Visibility="{Binding SupportsWebChat, Converter={StaticResource BoolToVisibility}}">
                                                <WrapPanel DockPanel.Dock="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0">
                                                    <Button Content="Войти в веб-чат"
                                                            Style="{StaticResource Button.Secondary}"
                                                            Command="{Binding SignInWebChatCommand}"
                                                            MinHeight="24"
                                                            Padding="9,2"
                                                            FontSize="{DynamicResource Font.Size.S}"
                                                            Visibility="{Binding CanSignInWebChat, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Content="Сбросить веб-сессию"
                                                            Style="{StaticResource Button.Ghost}"
                                                            Command="{Binding ResetWebChatCommand}"
                                                            MinHeight="24"
                                                            Padding="9,2"
                                                            FontSize="{DynamicResource Font.Size.S}"
                                                            Visibility="{Binding CanResetWebChat, Converter={StaticResource BoolToVisibility}}" />
                                                </WrapPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="7"
                                                             Height="7"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,7,0"
                                                             keepshell:SeverityBrushBehavior.Fill="{Binding WebChatStatusSeverity}" />
                                                    <TextBlock Text="{Binding WebChatStatusText}"
                                                               keepshell:SeverityBrushBehavior.Foreground="{Binding WebChatStatusSeverity}"
                                                               FontSize="{DynamicResource Font.Size.S}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Grants}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PlatformAccountGrantViewModel}">
                                                <Border BorderThickness="0,1,0,0"
                                                        BorderBrush="{DynamicResource Border.Subtle}"
                                                        Padding="0,8,0,4">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <WrapPanel DockPanel.Dock="Right"
                                                                       VerticalAlignment="Center"
                                                                       Margin="12,0,0,0">
                                                                <Button Content="Обновить"
                                                                        Style="{StaticResource Button.Secondary}"
                                                                        Command="{Binding RefreshTokenCommand}"
                                                                        MinHeight="26"
                                                                        Padding="10,2"
                                                                        FontSize="{DynamicResource Font.Size.S}"
                                                                        Margin="0,0,6,0" />
                                                                <Button Content="Переавторизовать"
                                                                        Style="{StaticResource Button.Secondary}"
                                                                        Command="{Binding ReauthorizeCommand}"
                                                                        MinHeight="26"
                                                                        Padding="10,2"
                                                                        FontSize="{DynamicResource Font.Size.S}"
                                                                        Margin="0,0,6,0"
                                                                        Visibility="{Binding CanAuthorize, Converter={StaticResource BoolToVisibility}}" />
                                                                <Button Content="Убрать роль"
                                                                        Style="{StaticResource Button.Ghost}"
                                                                        Command="{Binding RemoveRoleCommand}"
                                                                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                                                                        MinHeight="26"
                                                                        Padding="8,2"
                                                                        FontSize="{DynamicResource Font.Size.S}" />
                                                            </WrapPanel>

                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Ellipse Width="7"
                                                                         Height="7"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,7,0"
                                                                         keepshell:SeverityBrushBehavior.Fill="{Binding TokenStatusSeverity}" />
                                                                <TextBlock Text="{Binding RoleTitle}"
                                                                           Foreground="{DynamicResource Fg.Primary}"
                                                                           FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                                                           FontSize="{DynamicResource Font.Size.S}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding TokenStatusText}"
                                                                           keepshell:SeverityBrushBehavior.Foreground="{Binding TokenStatusSeverity}"
                                                                           FontSize="{DynamicResource Font.Size.S}"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </DockPanel>

                                                        <Button Content="{Binding PermissionsLabel}" Command="{Binding TogglePermissionsCommand}"
                                                                Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                                                Padding="0,2" MinHeight="0" Margin="0,3,0,0"
                                                                Visibility="{Binding HasPermissions, Converter={StaticResource BoolToVisibility}}" />
                                                        <ItemsControl ItemsSource="{Binding Permissions}" Focusable="False" Margin="0,4,0,0"
                                                                      Visibility="{Binding IsPermissionsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,3,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="3*" />
                                                                            <ColumnDefinition Width="2*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TextBlock.Subtle}"
                                                                                   Margin="0,0,10,0" TextWrapping="Wrap" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource TextBlock.Subtle}"
                                                                                   TextWrapping="Wrap" keepshell:SeverityBrushBehavior.Foreground="{Binding Severity}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <TextBlock Text="{Binding ActionStatusText}"
                                                                   Style="{StaticResource Form.Hint}"
                                                                   keepshell:SeverityBrushBehavior.Foreground="{Binding ActionStatusSeverity}"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding ActionStatusText, Converter={StaticResource NullToVisibility}}"
                                                                   Margin="0,4,0,0" />

                                                        <StackPanel Margin="0,10,0,4"
                                                                    Visibility="{Binding DataContext.IsTechnicalMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                                            <WrapPanel Margin="0,0,0,6">
                                                                <TextBlock Text="Контекст: "
                                                                           Foreground="{DynamicResource Fg.Muted}"
                                                                           FontSize="{DynamicResource Font.Size.S}" />
                                                                <TextBlock Text="{Binding ContextDisplay}"
                                                                           Style="{StaticResource TextBlock.Mono}"
                                                                           Foreground="{DynamicResource Fg.Primary}"
                                                                           Margin="0,0,14,0" />
                                                                <TextBlock Text="Срок действия: "
                                                                           Foreground="{DynamicResource Fg.Muted}"
                                                                           FontSize="{DynamicResource Font.Size.S}" />
                                                                <TextBlock Text="{Binding TokenExpiryText}"
                                                                           Foreground="{DynamicResource Fg.Primary}"
                                                                           FontSize="{DynamicResource Font.Size.S}" />
                                                            </WrapPanel>

                                                            <StackPanel Visibility="{Binding SupportsEditableScopes, Converter={StaticResource BoolToVisibility}}"
                                                                        Margin="0,0,0,8">
                                                                <TextBlock Text="Scopes (через пробел)"
                                                                           Foreground="{DynamicResource Fg.Muted}"
                                                                           FontSize="{DynamicResource Font.Size.S}"
                                                                           Margin="0,0,0,4" />
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox Grid.Column="0"
                                                                             Style="{StaticResource TextBox.Form}"
                                                                             Text="{Binding ScopesText, UpdateSourceTrigger=PropertyChanged}"
                                                                             AutomationProperties.Name="Список scope через пробел" />
                                                                    <Button Grid.Column="1"
                                                                            Style="{StaticResource Button.Ghost}"
                                                                            Content="Сбросить"
                                                                            Command="{Binding ResetScopesCommand}"
                                                                            Margin="8,0,0,0" />
                                                                </Grid>
                                                            </StackPanel>

                                                            <TextBlock Text="Выданные права"
                                                                       Foreground="{DynamicResource Fg.Muted}"
                                                                       FontSize="{DynamicResource Font.Size.S}"
                                                                       Margin="0,0,0,2" />
                                                            <TextBlock Text="{Binding GrantedScopesSummary}"
                                                                       Style="{StaticResource TextBlock.Mono}"
                                                                       Foreground="{DynamicResource Fg.Primary}"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,0,0,8" />

                                                            <TextBlock Text="Access Token"
                                                                       Foreground="{DynamicResource Fg.Muted}"
                                                                       FontSize="{DynamicResource Font.Size.S}"
                                                                       Margin="0,0,0,4" />
                                                            <keepshell:RevealableTextBox Password="{Binding AccessTokenValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                         Margin="0,0,0,8" />

                                                            <TextBlock Text="Refresh Token"
                                                                       Foreground="{DynamicResource Fg.Muted}"
                                                                       FontSize="{DynamicResource Font.Size.S}"
                                                                       Margin="0,0,0,4" />
                                                            <keepshell:RevealableTextBox Password="{Binding RefreshTokenValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                         Margin="0,0,0,8" />

                                                            <WrapPanel>
                                                                <Button Content="Проверить токен"
                                                                        Style="{StaticResource Button.Secondary}"
                                                                        Command="{Binding ValidateTokenCommand}"
                                                                        Margin="0,0,8,4"
                                                                        Visibility="{Binding SupportsTokenValidation, Converter={StaticResource BoolToVisibility}}" />
                                                                <Button Content="Сохранить правки"
                                                                        Style="{StaticResource Button.Primary}"
                                                                        Command="{Binding SaveManualEditsCommand}"
                                                                        Margin="0,0,8,4"
                                                                        Visibility="{Binding HasManualEdits, Converter={StaticResource BoolToVisibility}}" />
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </HeaderedContentControl>
    </StackPanel>
</UserControl>
