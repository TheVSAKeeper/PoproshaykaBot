<UserControl x:Class="PoproshaykaBot.Wpf.Views.Settings.YouTubeAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:YouTubeAccountViewModel}"
             d:DesignWidth="680">
    <StackPanel>
        <TextBlock Text="{Binding RolePurposeHint}"
                   Foreground="{DynamicResource Fg.Muted}"
                   FontSize="{DynamicResource Font.Size.S}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <DockPanel Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Left"
                        VerticalAlignment="Center">
                <TextBlock Text="Состояние: "
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}" />
                <TextBlock Text="{Binding AuthorizationSummary}"
                           Foreground="{DynamicResource Fg.Primary}"
                           FontWeight="{DynamicResource Font.Weight.SemiBold}"
                           FontSize="{DynamicResource Font.Size.S}" />
            </StackPanel>

            <Button Content="Очистить"
                    Style="{StaticResource Button.Ghost}"
                    Command="{Binding ClearCommand}"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right" />
        </DockPanel>

        <WrapPanel Margin="0,0,0,10">
            <Button Content="{Binding OpenBrowserButtonText}"
                    Style="{StaticResource Button.Primary}"
                    Command="{Binding OpenBrowserCommand}"
                    Margin="0,0,8,0" />

            <Button Content="Отменить вход"
                    Style="{StaticResource Button.Destructive}"
                    Command="{Binding CancelAuthorizationCommand}"
                    Visibility="{Binding IsAuthorizing, Converter={StaticResource BoolToVisibility}}"
                    Margin="0,0,8,0" />
        </WrapPanel>

        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource Fg.Muted}"
                   FontSize="{DynamicResource Font.Size.S}"
                   TextWrapping="Wrap"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}"
                   Margin="0,0,0,10" />

        <StackPanel Orientation="Horizontal"
                    Visibility="{Binding HasChannelIdentity, Converter={StaticResource BoolToVisibility}}"
                    Margin="0,0,0,8">
            <TextBlock Text="Канал Google-аккаунта: "
                       Foreground="{DynamicResource Fg.Muted}"
                       FontSize="{DynamicResource Font.Size.S}" />
            <TextBlock Text="{Binding ChannelDisplay}"
                       Foreground="{DynamicResource Fg.Primary}"
                       FontSize="{DynamicResource Font.Size.S}" />
        </StackPanel>

        <TextBlock Text="Запрашиваемые права"
                   Foreground="{DynamicResource Fg.Muted}"
                   FontSize="{DynamicResource Font.Size.S}"
                   Margin="0,4,0,2" />
        <TextBlock Text="{Binding ExpectedScopesSummary}"
                   Foreground="{DynamicResource Fg.Primary}"
                   FontSize="{DynamicResource Font.Size.S}"
                   FontFamily="{DynamicResource Font.Mono}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <TextBlock Text="Выданные права"
                   Foreground="{DynamicResource Fg.Muted}"
                   FontSize="{DynamicResource Font.Size.S}"
                   Margin="0,0,0,2" />
        <TextBlock Text="{Binding GrantedScopesSummary}"
                   Foreground="{DynamicResource Fg.Primary}"
                   FontSize="{DynamicResource Font.Size.S}"
                   FontFamily="{DynamicResource Font.Mono}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6" />

        <TextBlock Text="Выданные права отличаются от запрашиваемых – при следующем входе браузер запросит недостающие."
                   Foreground="{DynamicResource Fg.Muted}"
                   FontSize="{DynamicResource Font.Size.S}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasScopeMismatch, Converter={StaticResource BoolToVisibility}}"
                   Margin="0,0,0,8" />

        <TextBlock Text="{Binding TokenExpirySummary}"
                   Foreground="{DynamicResource Fg.Muted}"
                   FontSize="{DynamicResource Font.Size.S}"
                   Margin="0,0,0,10" />

        <TextBlock Text="Access Token"
                   Foreground="{DynamicResource Fg.Muted}"
                   FontSize="{DynamicResource Font.Size.S}"
                   Margin="0,0,0,4" />
        <keepshell:RevealableTextBox Password="{Binding AccessTokenValue, Mode=TwoWay}"
                                     Margin="0,0,0,8" />

        <TextBlock Text="Refresh Token"
                   Foreground="{DynamicResource Fg.Muted}"
                   FontSize="{DynamicResource Font.Size.S}"
                   Margin="0,0,0,4" />
        <keepshell:RevealableTextBox Password="{Binding RefreshTokenValue, Mode=TwoWay}"
                                     Margin="0,0,0,10" />

        <WrapPanel>
            <Button Content="Сбросить права"
                    Style="{StaticResource Button.Secondary}"
                    Command="{Binding ResetScopesCommand}" />
        </WrapPanel>
    </StackPanel>
</UserControl>
