<UserControl x:Class="PoproshaykaBot.Wpf.Views.Settings.McpSettingsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Settings"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:McpSettingsSectionViewModel}"
             d:DesignHeight="720"
             d:DesignWidth="600">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PoproshaykaBot.Wpf;component/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource Form.Hint}"
                   Margin="0,0,0,0"
                   Text="Встроенный сервер на loopback: агент подключается к запущенному окну и видит то же, что вы – открытую страницу, дерево контролов, журнал, кадр. Нужен только для отладки, в обычной работе держите выключенным." />

        <CheckBox Content="Поднимать сервер"
                  Style="{StaticResource CheckBox.ToggleSwitch}"
                  IsChecked="{Binding Preferences.Enabled, Mode=TwoWay}"
                  Margin="0,14,0,16"
                  VerticalAlignment="Center" />

        <StackPanel Style="{StaticResource Setting.DependentBlock}"
                    IsEnabled="{Binding Preferences.Enabled}">
            <keepshell:SettingRowPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Порт"
                               Style="{StaticResource Form.Label}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PortError}"
                               Foreground="{DynamicResource State.ErrorText}"
                               FontSize="{DynamicResource Font.Size.S}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding PortError, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Style="{StaticResource Form.Hint}"
                               Margin="0,6,0,0"
                               Text="1024…65535, только 127.0.0.1. Смена порта применяется сразу – сервер перезапускается." />
                </StackPanel>
                <TextBox Text="{Binding PortText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         Width="{DynamicResource Setting.ShortFieldWidth}"
                         VerticalAlignment="Top"
                         FontFamily="{DynamicResource Font.Mono}"
                         AutomationProperties.Name="Порт MCP-сервера">
                    <TextBox.Style>
                        <Style TargetType="TextBox"
                               BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPortError}"
                                             Value="True">
                                    <Setter Property="BorderBrush"
                                            Value="{DynamicResource State.Error}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </keepshell:SettingRowPanel>
        </StackPanel>

        <CheckBox Content="Разрешить изменяющие операции"
                  IsChecked="{Binding AllowMutations, Mode=TwoWay}"
                  IsEnabled="{Binding CanToggleMutations}"
                  Margin="0,16,0,0"
                  VerticalAlignment="Center" />
        <TextBlock Style="{StaticResource Form.CheckHint}"
                   Text="Один флаг на всё: агент сможет нажимать кнопки, вводить текст, закрывать приложение, подключать и отключать бота. Без флага доступно только чтение." />

        <keepshell:SettingRowPanel Margin="0,16,0,0">
            <TextBlock Text="Токен"
                       Style="{StaticResource Form.Label}"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0" />
            <Grid Width="460">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding DisplayToken, Mode=OneWay}"
                         IsReadOnly="True"
                         keepshell:McpPrivacy.IsSensitive="True"
                         FontFamily="{DynamicResource Font.Mono}"
                         FontSize="{DynamicResource Font.Size.S}"
                         AutomationProperties.Name="Токен доступа MCP" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="8,0,0,0">
                    <Button Style="{StaticResource Button.Icon}"
                            Command="{Binding Preferences.RegenerateTokenCommand}"
                            Margin="0,0,4,0"
                            AutomationProperties.Name="Перегенерировать токен"
                            ToolTip="Выдать новый токен – старые подключения агентов отвалятся">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.RefreshCw}"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}"
                            Command="{Binding CopyTokenCommand}"
                            AutomationProperties.Name="Скопировать токен"
                            ToolTip="Скопировать токен в буфер обмена">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Clipboard}"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </keepshell:SettingRowPanel>

        <StackPanel Orientation="Horizontal"
                    Margin="0,16,0,0">
            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Radio}"
                                      Width="14"
                                      Height="14"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      Foreground="{DynamicResource State.SuccessText}"
                                      Visibility="{Binding Server.IsRunning, Converter={StaticResource BoolToVisibility}}"
                                      AutomationProperties.Name="Сервер работает" />
            <TextBlock Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Text="{Binding Server.LastError}"
                   Foreground="{DynamicResource State.ErrorText}"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   Visibility="{Binding Server.LastError, Converter={StaticResource NullToVisibility}}" />

        <Border Padding="12,10"
                Margin="0,14,0,0"
                Background="{DynamicResource State.WarningSoft}"
                BorderBrush="{DynamicResource State.Warning}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.M}"
                Visibility="{Binding Server.IsElevated, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <iconPacks:PackIconLucide Grid.Column="0"
                                          Kind="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}"
                                          Width="14"
                                          Height="14"
                                          Foreground="{DynamicResource State.WarningText}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          AutomationProperties.Name="Внимание" />
                <TextBlock Grid.Column="1"
                           Text="Приложение запущено с правами администратора: изменяющие операции принудительно отключены. Токен доступа создан только на текущую сессию и не сохраняется на диск."
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <keepshell:SettingRowPanel Margin="0,16,0,0">
            <TextBlock Text="Формат подключения"
                       Style="{StaticResource Form.Label}"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0" />
            <ComboBox Style="{StaticResource ComboBox.Form}"
                      Width="{DynamicResource Setting.ShortFieldWidth}"
                      ItemsSource="{Binding SnippetFormats}"
                      SelectedIndex="{Binding SelectedSnippetFormatIndex, Mode=TwoWay}"
                      AutomationProperties.Name="Формат строки подключения" />
        </keepshell:SettingRowPanel>

        <keepshell:SettingRowPanel Margin="0,10,0,0">
            <TextBlock Text="Строка подключения"
                       Style="{StaticResource Form.Label}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top"
                       Margin="0,6,12,0" />
            <Grid Width="460">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding ConnectSnippet, Mode=OneWay}"
                         IsReadOnly="True"
                         keepshell:McpPrivacy.IsSensitive="True"
                         MaxHeight="180"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="{DynamicResource Font.Mono}"
                         FontSize="{DynamicResource Font.Size.S}"
                         AutomationProperties.Name="{Binding ConnectSnippetAutomationName}" />

                <Button Grid.Column="1"
                        Style="{StaticResource Button.Icon}"
                        Command="{Binding CopyConnectSnippetCommand}"
                        Margin="8,0,0,0"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Скопировать строку подключения"
                        ToolTip="{Binding ConnectSnippetTooltip}">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Clipboard}"
                                              Width="16"
                                              Height="16"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                </Button>
            </Grid>
        </keepshell:SettingRowPanel>
    </StackPanel>
</UserControl>
