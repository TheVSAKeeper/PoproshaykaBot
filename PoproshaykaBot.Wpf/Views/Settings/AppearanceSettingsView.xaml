<UserControl x:Class="PoproshaykaBot.Wpf.Views.Settings.AppearanceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Settings"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AppearanceSettingsSectionViewModel}"
             d:DesignHeight="360"
             d:DesignWidth="600">

    <StackPanel>
        <TextBlock Text="Тема оформления"
                   Style="{StaticResource Form.Label}" />
        <keepshell:ThemeSwitcher DataContext="{Binding Theme}"
                               ShowPreviews="True"
                               Margin="0,8,0,0" />
        <TextBlock Style="{StaticResource Form.Hint}"
                   Text="Применяется сразу, как и переключатель в заголовке окна." />

        <StackPanel Margin="0,20,0,0"
                    Visibility="{Binding ThemePacks, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="Пакеты тем"
                       Style="{StaticResource Form.Label}"
                       Margin="0,0,0,8" />
            <keepshell:ThemePacksView DataContext="{Binding ThemePacks}" />
        </StackPanel>

        <keepshell:FontScaleField Scale="{Binding Shell.FontScale}"
                                  Hint="Увеличивает размер текста по всему приложению. 100% – стандартный размер."
                                  Margin="0,20,0,0" />

        <CheckBox Content="Показывать заголовок страницы"
                  Style="{StaticResource CheckBox.ToggleSwitch}"
                  IsChecked="{Binding Shell.ShowPageHeader, Mode=TwoWay}"
                  Margin="0,20,0,0" />
        <TextBlock Style="{StaticResource Form.CheckHint}"
                   Text="Плашка с названием раздела и описанием над содержимым каждой страницы." />

        <CheckBox Content="Показывать всплывающие уведомления"
                  Style="{StaticResource CheckBox.ToggleSwitch}"
                  IsChecked="{Binding Shell.EnableToastNotifications, Mode=TwoWay}"
                  Margin="0,16,0,0" />
        <TextBlock Style="{StaticResource Form.CheckHint}"
                   Text="Короткие уведомления в правом нижнем углу – о копировании строки подключения, статусе выходов OBS и неполной очистке истории." />
    </StackPanel>
</UserControl>
