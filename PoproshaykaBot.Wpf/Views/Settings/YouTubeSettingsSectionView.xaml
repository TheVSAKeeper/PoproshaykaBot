<UserControl x:Class="PoproshaykaBot.Wpf.Views.Settings.YouTubeSettingsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:YouTubeSettingsSectionViewModel}"
             d:DesignWidth="680">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PoproshaykaBot.Wpf;component/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Visibility="{Binding ShowEnableToggle, Mode=OneTime, Converter={StaticResource BoolToVisibility}}">
            <CheckBox Content="Включить YouTube"
                      Style="{StaticResource CheckBox.Default}"
                      FontWeight="{DynamicResource Font.Weight.SemiBold}"
                      AutomationProperties.AutomationId="MultistreamEnableYouTube"
                      IsChecked="{Binding Enabled, Mode=TwoWay}" />
            <TextBlock Text="Управляет запуском и мониторингом YouTube. Применяется после сохранения."
                       Style="{StaticResource Form.CheckHint}" />
            <Border BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    Margin="0,10,0,12" />
        </StackPanel>

        <keepshell:SettingRowPanel Margin="0,0,0,8">
            <TextBlock Text="Project ID"
                       Style="{StaticResource Form.Label}"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0" />
            <TextBox Style="{StaticResource TextBox.Form}"
                     Width="460"
                     Text="{Binding ProjectId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     keepshell:PlaceholderBehavior.Placeholder="например, my-stream-bot-123456" />
        </keepshell:SettingRowPanel>

        <keepshell:SettingRowPanel Margin="0,0,0,8">
            <TextBlock Text="Client ID"
                       Style="{StaticResource Form.Label}"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0" />
            <keepshell:RevealableTextBox Password="{Binding ClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="460"
                                         keepshell:McpPrivacy.IsSensitive="True" />
        </keepshell:SettingRowPanel>

        <keepshell:SettingRowPanel Margin="0,0,0,8">
            <TextBlock Text="Client Secret"
                       Style="{StaticResource Form.Label}"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0" />
            <keepshell:RevealableTextBox Password="{Binding ClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="460"
                                         keepshell:McpPrivacy.IsSensitive="True" />
        </keepshell:SettingRowPanel>

        <keepshell:SettingRowPanel Margin="0,0,0,8"
                                   Visibility="{Binding ShowLegacyChannelField, Mode=OneTime, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Канал стрима"
                       Style="{StaticResource Form.Label}"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0" />
            <TextBox Style="{StaticResource TextBox.Form}"
                     Width="{DynamicResource Setting.ShortFieldWidth}"
                     Text="{Binding Channel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     keepshell:PlaceholderBehavior.Placeholder="@handle или UC..." />
        </keepshell:SettingRowPanel>

        <keepshell:SettingRowPanel Margin="0,0,0,12">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Бюджет квоты в сутки"
                           Style="{StaticResource Form.Label}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding QuotaBudgetError}"
                           Foreground="{DynamicResource State.ErrorText}"
                           FontSize="{DynamicResource Font.Size.S}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasQuotaBudgetError, Converter={StaticResource BoolToVisibility}}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <TextBox Style="{StaticResource TextBox.Form}"
                     Width="{DynamicResource Setting.ShortFieldWidth}"
                     VerticalAlignment="Top"
                     Text="{Binding DailyQuotaBudgetText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     keepshell:PlaceholderBehavior.Placeholder="10000" />
        </keepshell:SettingRowPanel>

        <Border BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0"
                Margin="0,4,0,12"
                Visibility="{Binding ShowQuotaDiagnostics, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource Button.Secondary}"
                            Content="Обновить"
                            Command="{Binding QuotaStatus.RefreshCommand, Mode=OneWay}"
                            VerticalAlignment="Center" />

                    <TextBlock Text="Как сейчас работает YouTube (InnerTube и Data API)"
                               Foreground="{DynamicResource Fg.Primary}"
                               FontWeight="{DynamicResource Font.Weight.SemiBold}"
                               FontSize="{DynamicResource Font.Size.S}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </DockPanel>

                <keepshell:SettingRowPanel Margin="0,0,0,6">
                    <TextBlock Text="Чтение чата"
                               Style="{StaticResource Form.Label}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"
                               Margin="0,0,12,0" />
                    <TextBlock Text="{Binding QuotaStatus.ChatReadTransportText}"
                               Width="460"
                               Foreground="{DynamicResource Fg.Primary}"
                               FontSize="{DynamicResource Font.Size.S}"
                               TextWrapping="Wrap" />
                </keepshell:SettingRowPanel>

                <keepshell:SettingRowPanel Margin="0,0,0,6">
                    <TextBlock Text="Поиск и мониторинг эфира"
                               Style="{StaticResource Form.Label}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"
                               Margin="0,0,12,0" />
                    <TextBlock Text="{Binding QuotaStatus.MonitoringTransportText}"
                               Width="460"
                               Foreground="{DynamicResource Fg.Primary}"
                               FontSize="{DynamicResource Font.Size.S}"
                               TextWrapping="Wrap" />
                </keepshell:SettingRowPanel>

                <keepshell:SettingRowPanel Margin="0,0,0,10">
                    <TextBlock Text="Отправка сообщений бота"
                               Style="{StaticResource Form.Label}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"
                               Margin="0,0,12,0" />
                    <TextBlock Text="{Binding QuotaStatus.ChatSendTransportText}"
                               Width="460"
                               Foreground="{DynamicResource Fg.Primary}"
                               FontSize="{DynamicResource Font.Size.S}"
                               TextWrapping="Wrap" />
                </keepshell:SettingRowPanel>

                <Border BorderBrush="{DynamicResource Border.Subtle}"
                        BorderThickness="0,1,0,0"
                        Padding="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,8">
                            <Ellipse Width="8"
                                     Height="8"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"
                                     keepshell:SeverityBrushBehavior.Fill="{Binding QuotaStatus.StatusSeverity}" />
                            <TextBlock Text="Куда уходит квота за сегодня"
                                       Foreground="{DynamicResource Fg.Primary}"
                                       FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                       FontSize="{DynamicResource Font.Size.S}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding QuotaStatus.HasData, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding QuotaStatus.UsageText}"
                                           Foreground="{DynamicResource Fg.Primary}"
                                           FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                           FontSize="{DynamicResource Font.Size.S}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding QuotaStatus.BreakdownText}"
                                           Foreground="{DynamicResource Fg.Muted}"
                                           FontSize="{DynamicResource Font.Size.S}"
                                           TextAlignment="Right"
                                           TextWrapping="Wrap"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <ProgressBar Height="6"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding QuotaStatus.FillPercent, Mode=OneWay}"
                                         keepshell:SeverityBrushBehavior.Foreground="{Binding QuotaStatus.StatusSeverity}"
                                         Margin="0,0,0,8" />

                            <ItemsControl ItemsSource="{Binding QuotaStatus.CategoryItems}"
                                          Visibility="{Binding QuotaStatus.HasCategoryItems, Converter={StaticResource BoolToVisibility}}"
                                          Margin="0,0,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       Foreground="{DynamicResource Fg.Muted}"
                                                       FontSize="{DynamicResource Font.Size.S}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding UnitsText}"
                                                       Foreground="{DynamicResource Fg.Primary}"
                                                       FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                                       FontSize="{DynamicResource Font.Size.S}"
                                                       TextWrapping="Wrap"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding QuotaStatus.NoUsageTodayText}"
                                       Foreground="{DynamicResource Fg.Muted}"
                                       FontSize="{DynamicResource Font.Size.S}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       Visibility="{Binding QuotaStatus.HasNoUsageToday, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Text="{Binding QuotaStatus.NextResetText}"
                                       Foreground="{DynamicResource Fg.Muted}"
                                       FontSize="{DynamicResource Font.Size.S}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,2" />

                            <TextBlock Text="{Binding QuotaStatus.ReliabilityText}"
                                       Foreground="{DynamicResource Fg.Muted}"
                                       FontSize="{DynamicResource Font.Size.S}"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding QuotaStatus.WarningText}"
                                       FontSize="{DynamicResource Font.Size.S}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       keepshell:SeverityBrushBehavior.Foreground="{Binding QuotaStatus.StatusSeverity}"
                                       Visibility="{Binding QuotaStatus.HasWarning, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <TextBlock Text="{Binding QuotaStatus.UsageText}"
                                   Foreground="{DynamicResource Fg.Muted}"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding QuotaStatus.HasData, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0"
                Margin="0,4,0,0">
            <StackPanel>
                <TextBlock Text="Памятка по проекту Google Cloud"
                           Foreground="{DynamicResource Fg.Primary}"
                           FontWeight="{DynamicResource Font.Weight.SemiBold}"
                           FontSize="{DynamicResource Font.Size.S}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6" />
                <TextBlock Text="1. Включите YouTube Data API v3 и создайте OAuth-клиент строго типа «Desktop app» (клиент «Web application» не примет локальный возврат 127.0.0.1)."
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4" />
                <TextBlock Text="2. В статусе проекта «Testing» выданная авторизация истекает каждые 7 дней – вход придётся повторять раз в неделю."
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4" />
                <TextBlock Text="3. Чтобы авторизация не слетала через неделю, нажмите «Publish App» и переведите проект в «In production». Для личного использования (до 100 пользователей) проверка Google не требуется – при входе достаточно выбрать «Дополнительные настройки -> Перейти на страницу …»."
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
