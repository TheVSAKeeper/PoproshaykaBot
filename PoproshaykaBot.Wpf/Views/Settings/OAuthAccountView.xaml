<UserControl x:Class="PoproshaykaBot.Wpf.Views.Settings.OAuthAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:OAuthAccountViewModel}"
             d:DesignWidth="640">

    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="{Binding HeaderText}"
                       Style="{StaticResource TextBlock.Heading}"
                       Margin="0,0,0,12" />

            <TextBlock Text="Scopes"
                       Foreground="{DynamicResource Fg.Muted}"
                       FontSize="{DynamicResource Font.Size.S}"
                       Margin="0,0,0,4" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Style="{StaticResource TextBox.Form}"
                         Text="{Binding ScopesText, UpdateSourceTrigger=PropertyChanged}"
                         keepshell:PlaceholderBehavior.Placeholder="Список scope через пробел" />
                <Button Grid.Column="1"
                        Style="{StaticResource Button.Ghost}"
                        Content="Сбросить"
                        Margin="8,0,0,0"
                        Command="{Binding ResetScopesCommand}" />
            </Grid>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,8">
                <Button Style="{StaticResource Button.Primary}"
                        Content="{Binding AuthorizeButtonText}"
                        Command="{Binding AuthorizeCommand}"
                        Visibility="{Binding IsAuthInProgress, Converter={StaticResource InverseBoolToVisibility}}" />
                <Button Style="{StaticResource Button.Destructive}"
                        Content="Отменить авторизацию"
                        Command="{Binding CancelAuthCommand}"
                        Visibility="{Binding IsAuthInProgress, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <TextBlock Text="{Binding AuthStatusText}"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource Font.Size.S}"
                       Foreground="{Binding AuthStatusSeverity, Converter={StaticResource SeverityToBrush}}"
                       Visibility="{Binding AuthStatusText, Converter={StaticResource NullToVisibility}}"
                       Margin="0,0,0,12" />

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Аккаунт:"
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Margin="0,0,8,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding LoginText}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Foreground="{DynamicResource Fg.Primary}" />
            </Grid>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Статус токена:"
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Margin="0,0,8,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding TokenStatusText}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Foreground="{Binding TokenStatusSeverity, Converter={StaticResource SeverityToBrush}}" />
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Последнее обновление:"
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Margin="0,0,8,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding LastRefreshText}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Foreground="{DynamicResource Fg.Primary}" />
            </Grid>

            <TextBlock Text="Access Token"
                       Foreground="{DynamicResource Fg.Muted}"
                       FontSize="{DynamicResource Font.Size.S}"
                       Margin="0,0,0,4" />
            <keepshell:RevealableTextBox Password="{Binding AccessTokenValue, Mode=TwoWay}"
                                         Margin="0,0,0,4"
                                         Visibility="{Binding HasAccessToken, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="Не установлен"
                       Foreground="{DynamicResource Fg.Muted}"
                       FontSize="{DynamicResource Font.Size.S}"
                       Margin="0,0,0,12"
                       Visibility="{Binding HasAccessToken, Converter={StaticResource InverseBoolToVisibility}}" />

            <TextBlock Text="Refresh Token"
                       Foreground="{DynamicResource Fg.Muted}"
                       FontSize="{DynamicResource Font.Size.S}"
                       Margin="0,0,0,4" />
            <keepshell:RevealableTextBox Password="{Binding RefreshTokenValue, Mode=TwoWay}"
                                         Margin="0,0,0,4"
                                         Visibility="{Binding HasRefreshToken, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="Не установлен"
                       Foreground="{DynamicResource Fg.Muted}"
                       FontSize="{DynamicResource Font.Size.S}"
                       Margin="0,0,0,12"
                       Visibility="{Binding HasRefreshToken, Converter={StaticResource InverseBoolToVisibility}}" />

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Button.Secondary}"
                        Content="Проверить токен"
                        Margin="0,0,8,0"
                        Command="{Binding ValidateTokenCommand}" />
                <Button Style="{StaticResource Button.Secondary}"
                        Content="Обновить токен"
                        Margin="0,0,8,0"
                        Command="{Binding RefreshTokenCommand}" />
                <Button Style="{StaticResource Button.Destructive}"
                        Content="Очистить токены"
                        Command="{Binding ClearTokensCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
