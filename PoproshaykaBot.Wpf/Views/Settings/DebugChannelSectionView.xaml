<UserControl x:Class="PoproshaykaBot.Wpf.Views.Settings.DebugChannelSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DebugChannelSectionViewModel}"
             d:DesignHeight="360"
             d:DesignWidth="600">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PoproshaykaBot.Wpf;component/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <CheckBox Style="{StaticResource CheckBox.Default}"
                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                  Content="Подключаться к чужому каналу (режим отладки)"
                  Margin="0,0,0,4" />

        <TextBlock Text="Бот будет читать чат указанного канала вместо вашего."
                   Style="{StaticResource Form.CheckHint}"
                   Margin="0,0,0,16" />

        <TextBlock Text="Канал"
                   Style="{StaticResource Form.Label}" />

        <TextBox Text="{Binding Channel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding IsEnabled}"
                 keepshell:PlaceholderBehavior.Placeholder="например, mrbeast"
                 Margin="0,0,0,4" />

        <TextBlock Text="{Binding HintText}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground"
                            Value="{DynamicResource Fg.Muted}" />
                    <Setter Property="FontSize"
                            Value="{DynamicResource Font.Size.S}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HintSeverity}"
                                     Value="Success">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource State.SuccessText}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HintSeverity}"
                                     Value="Warning">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource State.WarningText}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HintSeverity}"
                                     Value="Error">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource State.ErrorText}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <CheckBox Style="{StaticResource CheckBox.Default}"
                  IsChecked="{Binding AllowSending, Mode=TwoWay}"
                  IsEnabled="{Binding IsEnabled}"
                  Content="Разрешить боту писать в этот чат"
                  Margin="0,0,0,4" />

        <TextBlock Text="По умолчанию бот молчит: сообщения, которые он собирался отправить, попадают только в журнал."
                   Style="{StaticResource Form.CheckHint}"
                   Margin="0,0,0,16" />

        <TextBlock Style="{StaticResource Form.Hint}"
                   TextWrapping="Wrap"
                   Text="На чужом канале доступно только чтение чата: голосования, смена названия и категории не работают – права есть лишь на ваш собственный канал. Плитка «Чат» – это настоящая страница Twitch под аккаунтом бота: то, что вы наберёте в её поле ввода руками, уйдёт в чужой чат в обход этой настройки. Новый канал подхватывается при следующем подключении бота. Статистика и очки зрителей пишутся в обычный профиль; для чистого прогона запускайте scripts/run-debug.ps1 – он поднимает отдельную папку данных." />
    </StackPanel>

</UserControl>
