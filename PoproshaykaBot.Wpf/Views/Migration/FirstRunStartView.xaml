<UserControl x:Class="PoproshaykaBot.Wpf.Views.Migration.FirstRunStartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Migration"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:FirstRunStartViewModel}"
             MaxWidth="600"
             HorizontalAlignment="Stretch">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      x:Name="ContentScroll"
                      MaxHeight="600"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,16,24,12">
                <StackPanel Visibility="{Binding IsChoiceStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="С чего начнём?"
                               Style="{StaticResource TextBlock.Heading}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Перенесите профили, оверлей, OBS, авто-рассылку и накопленную статистику из старой версии или начните с чистой настройки. Исходная папка останется нетронутой."
                               Foreground="{DynamicResource Fg.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,16" />

                    <Border Visibility="{Binding HasDetectedSource, Converter={StaticResource BoolToVisibility}}"
                            Background="{DynamicResource Bg.Surface}"
                            BorderBrush="{DynamicResource Accent.Primary}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.M}"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel DataContext="{Binding SelectedSource}">
                            <TextBlock Text="Найдена прежняя установка"
                                       FontSize="{DynamicResource Font.Size.S}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent.Text}" />
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Path}"
                                       FontSize="{DynamicResource Font.Size.S}"
                                       Foreground="{DynamicResource Fg.Secondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Modified}"
                                       FontSize="{DynamicResource Font.Size.S}"
                                       Foreground="{DynamicResource Fg.Muted}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Content}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Visibility="{Binding HasDetectedSource, Converter={StaticResource InverseBoolToVisibility}}"
                            Background="{DynamicResource Bg.Surface}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.M}"
                            Padding="14"
                            Margin="0,0,0,12">
                        <TextBlock Text="Если вы уже пользовались PoproshaykaBot раньше, нажмите «Перенести данные из старой версии» и выберите прежнюю папку программы."
                                   Foreground="{DynamicResource Fg.Secondary}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Button x:Name="PickOtherFolderChoiceButton"
                            Content="Выбрать другую папку"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding PickFolderCommand}"
                            AutomationProperties.Name="Выбрать другую папку"
                            HorizontalAlignment="Left" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsInvalidFolderStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Данные бота не найдены"
                               Style="{StaticResource TextBlock.Heading}"
                               TextWrapping="Wrap" />

                    <Border Background="{DynamicResource State.WarningSoft}"
                            BorderBrush="{DynamicResource State.Warning}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.M}"
                            Padding="14"
                            Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <iconPacks:PackIconLucide Grid.Column="0"
                                                      Kind="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}"
                                                      Width="18"
                                                      Height="18"
                                                      Margin="0,2,10,0"
                                                      VerticalAlignment="Top"
                                                      Foreground="{DynamicResource State.WarningText}" />
                            <TextBlock Grid.Column="1"
                                       x:Name="InvalidFolderReasonText"
                                       Text="{Binding InvalidFolderMessage}"
                                       Foreground="{DynamicResource Fg.Primary}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Старая папка не изменилась. Вы можете указать другую папку или сразу открыть чистую панель."
                               Foreground="{DynamicResource Fg.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsSummaryStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock x:Name="SummaryHeadlineText"
                               Text="{Binding SummaryHeadline}"
                               Style="{StaticResource TextBlock.Heading}"
                               TextWrapping="Wrap" />

                    <TextBlock Text="Старая папка не изменена – при необходимости к ней можно вернуться в любой момент."
                               Foreground="{DynamicResource Fg.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,10" />

                    <TextBlock Text="Что перенеслось"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" />

                    <Border Background="{DynamicResource Bg.Surface}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.M}"
                            Padding="12,8">
                        <ItemsControl ItemsSource="{Binding TransferredItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <iconPacks:PackIconLucide Grid.Column="0"
                                                                  Kind="{x:Static iconPacks:PackIconLucideKind.Check}"
                                                                  Width="15"
                                                                  Height="15"
                                                                  Margin="0,2,10,0"
                                                                  VerticalAlignment="Top"
                                                                  Foreground="{DynamicResource State.SuccessText}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="{DynamicResource Fg.Secondary}"
                                                       FontSize="{DynamicResource Font.Size.S}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <StackPanel Visibility="{Binding HasAttentionItems, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,10,0,0">
                        <TextBlock Text="Что не перенеслось или требует настройки"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />

                        <Border Background="{DynamicResource State.WarningSoft}"
                                BorderBrush="{DynamicResource State.Warning}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.M}"
                                Padding="12,8">
                            <ItemsControl ItemsSource="{Binding AttentionItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <iconPacks:PackIconLucide Grid.Column="0"
                                                                      Kind="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}"
                                                                      Width="15"
                                                                      Height="15"
                                                                      Margin="0,2,10,0"
                                                                      VerticalAlignment="Top"
                                                                      Foreground="{DynamicResource State.WarningText}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}"
                                                           Foreground="{DynamicResource Fg.Secondary}"
                                                           FontSize="{DynamicResource Font.Size.S}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding ReloadNotice}"
                               Visibility="{Binding ReloadNotice, Converter={StaticResource NullToVisibility}}"
                               Foreground="{DynamicResource State.WarningText}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />

                    <Border Background="{DynamicResource State.InfoSoft}"
                            BorderBrush="{DynamicResource State.Info}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.M}"
                            Padding="12,8"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <iconPacks:PackIconLucide Grid.Column="0"
                                                      Kind="{x:Static iconPacks:PackIconLucideKind.Info}"
                                                      Width="16"
                                                      Height="16"
                                                      Margin="0,2,10,0"
                                                      VerticalAlignment="Top"
                                                      Foreground="{DynamicResource State.InfoText}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Что нового"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource State.InfoText}" />
                                <TextBlock Text="Появилась поддержка YouTube и два встроенных чата рядом – чат Twitch и чат YouTube работают бок о бок в одном окне панели."
                                           Foreground="{DynamicResource Fg.Primary}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel>
                <StackPanel Visibility="{Binding BusyMessage, Converter={StaticResource NullToVisibility}}"
                            Margin="0,0,0,8">
                    <TextBlock Text="{Binding BusyMessage}"
                               AutomationProperties.LiveSetting="Polite"
                               TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True"
                                 Height="4"
                                 Margin="0,6,0,0" />
                </StackPanel>

                <WrapPanel HorizontalAlignment="Right"
                           Visibility="{Binding IsChoiceStep, Converter={StaticResource BoolToVisibility}}">
                    <Button x:Name="StartFreshChoiceButton"
                            Content="Начать с нуля"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding StartFreshCommand}"
                            AutomationProperties.Name="Начать с нуля"
                            Margin="0,0,8,4"
                            MinWidth="130" />
                    <Button x:Name="ImportChoiceButton"
                            Content="{Binding PrimaryImportButtonText}"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding ImportCommand}"
                            AutomationProperties.Name="Перенести данные из старой версии"
                            Margin="0,0,0,4"
                            MinWidth="220" />
                </WrapPanel>

                <WrapPanel HorizontalAlignment="Right"
                           Visibility="{Binding IsInvalidFolderStep, Converter={StaticResource BoolToVisibility}}">
                    <Button x:Name="StartFreshInvalidButton"
                            Content="Начать с нуля"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding StartFreshCommand}"
                            AutomationProperties.Name="Начать с нуля"
                            Margin="0,0,8,4"
                            MinWidth="130" />
                    <Button x:Name="PickOtherFolderInvalidButton"
                            Content="Выбрать другую папку"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding PickFolderCommand}"
                            AutomationProperties.Name="Выбрать другую папку"
                            Margin="0,0,0,4"
                            MinWidth="180" />
                </WrapPanel>

                <WrapPanel HorizontalAlignment="Right"
                           Visibility="{Binding IsSummaryStep, Converter={StaticResource BoolToVisibility}}">
                    <Button x:Name="OpenDashboardSummaryButton"
                            Content="Открыть панель"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding OpenDashboardCommand}"
                            AutomationProperties.Name="Открыть панель"
                            Margin="0,0,8,4"
                            MinWidth="140" />
                    <Button x:Name="ConnectYouTubeSummaryButton"
                            Content="Подключить YouTube"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding ConnectYouTubeCommand}"
                            AutomationProperties.Name="Подключить YouTube"
                            Margin="0,0,0,4"
                            MinWidth="170" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
