<Window x:Class="PoproshaykaBot.Wpf.Views.Migration.LegacyImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:keepshell="https://schemas.keepshell.dev/wpf"
        xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Migration"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:LegacyImportViewModel}"
        Title="Перенос данных предыдущей версии"
        Width="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource Bg.Base}"
        Foreground="{DynamicResource Fg.Primary}"
        FontFamily="{DynamicResource Font.Sans}"
        FontSize="{DynamicResource Font.Size.M}">

    <Window.InputBindings>
        <KeyBinding Key="Escape"
                    Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Import.SourceCard"
               TargetType="ListBoxItem">
            <Setter Property="Margin"
                    Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Primary}" />
            <Setter Property="AutomationProperties.Name"
                    Value="{Binding Path}" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                Background="{DynamicResource Bg.Surface}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.M}"
                                Padding="12"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      Width="18"
                                      Height="18"
                                      VerticalAlignment="Top"
                                      Margin="0,2,10,0">
                                    <Ellipse x:Name="Marker"
                                             Stroke="{DynamicResource Border.Strong}"
                                             StrokeThickness="1"
                                             Fill="{DynamicResource Bg.Base}" />
                                    <Ellipse x:Name="MarkerDot"
                                             Width="8"
                                             Height="8"
                                             Fill="{DynamicResource Accent.Primary}"
                                             Visibility="Collapsed" />
                                </Grid>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Path}"
                                               Foreground="{DynamicResource Fg.Secondary}"
                                               FontSize="{DynamicResource Font.Size.S}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Modified}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Fg.Muted}"
                                               FontSize="{DynamicResource Font.Size.S}"
                                               Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Content}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Note}"
                                               Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}"
                                               Foreground="{DynamicResource Fg.Secondary}"
                                               FontSize="{DynamicResource Font.Size.S}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Border.Strong}" />
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="Card"
                                        Property="Background"
                                        Value="{DynamicResource Accent.Soft}" />
                                <Setter TargetName="Marker"
                                        Property="Stroke"
                                        Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="MarkerDot"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent.Focus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="0,0,0,1"
                keepshell:TitleBarBehavior.IsWindowChrome="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Перенос данных"
                           Margin="14,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Chrome.Button.Close}"
                            Command="{Binding CloseCommand}"
                            ToolTip="Закрыть"
                            AutomationProperties.Name="Закрыть">
                        <Path Style="{StaticResource Chrome.Glyph.Close}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="20,14,20,4">
            <TextBlock Text="Перенести данные предыдущей версии?"
                       Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVisibility}}"
                       Style="{StaticResource TextBlock.Heading}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding ResultHeadline}"
                       Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}"
                       Style="{StaticResource TextBlock.Heading}"
                       TextWrapping="Wrap" />
        </Grid>

        <ScrollViewer Grid.Row="2"
                      x:Name="ContentScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20,2,20,8">
                <StackPanel Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="{Binding Explanation}"
                                   Foreground="{DynamicResource Fg.Secondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,14" />

                        <Button Content="Выбрать папку…"
                                Style="{StaticResource Button.Secondary}"
                                Command="{Binding PickFolderCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,4,0,0" />

                        <TextBlock Text="{Binding PickerNotice}"
                                   Visibility="{Binding PickerNotice, Converter={StaticResource NullToVisibility}}"
                                   Foreground="{DynamicResource State.WarningText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />

                        <ListBox x:Name="SourceList"
                                 ItemsSource="{Binding Sources}"
                                 SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource Import.SourceCard}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 Margin="0,12,0,0"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Папки с данными предыдущей версии"
                                 IsEnabled="{Binding CanSelectSource}"
                                 SelectionChanged="OnSourceSelectionChanged">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </ListBox.Template>
                        </ListBox>

                        <TextBlock Text="{Binding AuthorizationNotice}"
                                   Visibility="{Binding AuthorizationNotice, Converter={StaticResource NullToVisibility}}"
                                   Foreground="{DynamicResource Fg.Secondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />

                        <CheckBox Content="Заменить файлы, которые уже есть"
                                  IsChecked="{Binding OverwriteExisting, Mode=TwoWay}"
                                  Visibility="{Binding CanOverwriteExisting, Converter={StaticResource BoolToVisibility}}"
                                  Margin="0,16,0,0" />

                        <TextBlock Text="{Binding ConflictNotice}"
                                   Visibility="{Binding ConflictNotice, Converter={StaticResource NullToVisibility}}"
                                   Style="{StaticResource Form.CheckHint}"
                                   TextWrapping="Wrap" />

                        <CheckBox Content="Больше не предлагать"
                                  IsChecked="{Binding NeverAskAgain, Mode=TwoWay}"
                                  Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVisibility}}"
                                  Margin="0,12,0,0" />

                </StackPanel>

                <StackPanel Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding ResultCounts}"
                                      Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding ResultFailures}"
                                      AutomationProperties.Name="Ошибки переноса данных"
                                      Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Foreground="{DynamicResource State.ErrorText}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding ResultUnmigratedNotice}"
                                   Visibility="{Binding ResultUnmigratedNotice, Converter={StaticResource NullToVisibility}}"
                                   Foreground="{DynamicResource Fg.Secondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />

                        <TextBlock Text="{Binding ResultAuthorizationNotice}"
                                   Visibility="{Binding ResultAuthorizationNotice, Converter={StaticResource NullToVisibility}}"
                                   Foreground="{DynamicResource Fg.Secondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />

                        <TextBlock Text="{Binding ResultRestartNotice}"
                                   Visibility="{Binding ResultRestartNotice, Converter={StaticResource NullToVisibility}}"
                                   Foreground="{DynamicResource Fg.Secondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3"
                Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel>
                <StackPanel Visibility="{Binding BusyMessage, Converter={StaticResource NullToVisibility}}"
                            Margin="0,0,0,8">
                    <TextBlock Text="{Binding BusyMessage}"
                               AutomationProperties.LiveSetting="Polite"
                               TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True"
                                 Height="4"
                                 Margin="0,6,0,0" />
                </StackPanel>
                <WrapPanel HorizontalAlignment="Right"
                           Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVisibility}}">
                    <Button Content="Перенести"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding ImportCommand}"
                            MinWidth="120"
                            Margin="0,0,8,0" />
                    <Button Content="{Binding SkipButtonText}"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding CloseCommand}"
                            MinWidth="120" />
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Right"
                           Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Настроить"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding ConfigureCommand}"
                            Visibility="{Binding CanConfigure, Converter={StaticResource BoolToVisibility}}"
                            MinWidth="120"
                            Margin="0,0,8,0" />
                    <Button x:Name="ContinueButton"
                            Content="Продолжить"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding CloseCommand}"
                            MinWidth="120" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
