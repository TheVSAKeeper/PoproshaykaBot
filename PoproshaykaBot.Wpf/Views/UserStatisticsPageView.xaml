<UserControl x:Class="PoproshaykaBot.Wpf.Views.UserStatisticsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:controls="clr-namespace:KeepShell.Views.Controls;assembly=KeepShell"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:UserStatisticsPageViewModel}"
             d:DesignHeight="720"
             d:DesignWidth="1100">

    <UserControl.Resources>

        <Style x:Key="RatingRowItem"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Padding"
                    Value="12,7" />
            <Setter Property="Margin"
                    Value="0" />
            <Setter Property="MinHeight"
                    Value="56" />
            <Setter Property="AutomationProperties.Name"
                    Value="{Binding Summary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="0,0,0,1"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Rectangle x:Name="Stripe"
                                           Fill="Transparent" />

                                <ContentPresenter Grid.Column="1"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource Bg.SurfaceMute}" />
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource Accent.Soft}" />
                                <Setter TargetName="Stripe"
                                        Property="Fill"
                                        Value="{DynamicResource Accent.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RatingRowTemplate">
            <Grid ToolTip="{Binding Summary}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0"
                           Grid.Row="0"
                           Grid.RowSpan="2"
                           Text="{Binding Position}"
                           Style="{StaticResource MonoCell}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Foreground="{DynamicResource Fg.Muted}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />

                <DockPanel Grid.Column="1"
                           Grid.Row="0"
                           LastChildFill="True">
                    <Border DockPanel.Dock="Right"
                            Style="{StaticResource Badge}"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">
                        <TextBlock Text="{Binding RankDisplay}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Fg.Secondary}" />
                    </Border>

                    <TextBlock Text="{Binding Name}"
                               FontSize="{DynamicResource Font.Size.L}"
                               FontWeight="{DynamicResource Font.Weight.SemiBold}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </DockPanel>

                <Grid Grid.Column="1"
                      Grid.Row="1"
                      Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"
                                          MinWidth="40" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar Grid.Column="0"
                                 Value="{Binding Share, Mode=OneWay}"
                                 Maximum="1"
                                 Height="8"
                                 MinHeight="8"
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0"
                                 Focusable="False"
                                 IsHitTestVisible="False" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding PointsDisplay}"
                                   Style="{StaticResource MonoCell}"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   MinWidth="58"
                                   TextAlignment="Right" />
                        <TextBlock Text="{Binding PointsUnit}"
                                   Style="{StaticResource MonoCell}"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   Foreground="{DynamicResource Fg.Muted}"
                                   Margin="4,0,0,0" />
                        <TextBlock Text="·"
                                   Style="{StaticResource MonoCell}"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   Foreground="{DynamicResource Fg.Muted}"
                                   Margin="6,0,6,0" />
                        <TextBlock Text="{Binding MessageCountDisplay}"
                                   Style="{StaticResource MonoCell}"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   MinWidth="58"
                                   TextAlignment="Right" />
                        <TextBlock Text="сообщ"
                                   Style="{StaticResource MonoCell}"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   Foreground="{DynamicResource Fg.Muted}"
                                   Margin="4,0,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"
                                  MaxWidth="560" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal">
                <Button Content="Названия баллов"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding EditPointTermCommand}"
                        AutomationProperties.Name="Изменить названия баллов"
                        Margin="16,0,8,0" />
                <Button Content="Обновить"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="Перечитать статистику" />
            </StackPanel>

            <Grid Grid.Column="0">
                <TextBox Style="{StaticResource TextBox.Form}"
                         Padding="8,0,32,0"
                         Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Поиск пользователя по имени или идентификатору"
                         keepshell:PlaceholderBehavior.Placeholder="Поиск пользователя (имя или ID)..." />

                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,2,0"
                        Style="{StaticResource Button.Icon}"
                        Command="{Binding ClearFilterCommand}"
                        AutomationProperties.Name="Очистить поиск"
                        ToolTip="Очистить поиск"
                        Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVisibility}}">
                    <iconPacks:PackIconLucide Kind="X"
                                              Width="14"
                                              Height="14" />
                </Button>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">
            <TextBlock Text="Сортировка"
                       Style="{StaticResource TextBlock.Subtle}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />

            <ToggleButton Style="{StaticResource ToggleButton.Toolbar}"
                          Command="{Binding SortByCommand}"
                          CommandParameter="{x:Static vm:UserStatisticsSortKey.Points}"
                          IsChecked="{Binding SortKey, Mode=OneWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Points}"
                          AutomationProperties.Name="Сортировать по баллам"
                          Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Баллы" />
                    <TextBlock Text="{Binding SortDirectionArrow}"
                               Margin="6,0,0,0"
                               Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </ToggleButton>

            <ToggleButton Style="{StaticResource ToggleButton.Toolbar}"
                          Command="{Binding SortByCommand}"
                          CommandParameter="{x:Static vm:UserStatisticsSortKey.Messages}"
                          IsChecked="{Binding SortKey, Mode=OneWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Messages}"
                          AutomationProperties.Name="Сортировать по сообщениям"
                          Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Сообщения" />
                    <TextBlock Text="{Binding SortDirectionArrow}"
                               Margin="6,0,0,0"
                               Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </ToggleButton>

            <ToggleButton Style="{StaticResource ToggleButton.Toolbar}"
                          Command="{Binding SortByCommand}"
                          CommandParameter="{x:Static vm:UserStatisticsSortKey.Name}"
                          IsChecked="{Binding SortKey, Mode=OneWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Name}"
                          AutomationProperties.Name="Сортировать по имени">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Имя" />
                    <TextBlock Text="{Binding SortDirectionArrow}"
                               Margin="6,0,0,0"
                               Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*"
                                  MinWidth="260"
                                  MaxWidth="380" />
            </Grid.ColumnDefinitions>

            <controls:EmptyState Grid.Column="0"
                                 Grid.ColumnSpan="2"
                                 Icon="Users"
                                 Heading="{Binding EmptyHeading}"
                                 Description="{Binding EmptyDescription}"
                                 DescriptionMaxWidth="320"
                                 Visibility="{Binding HasUsers, Converter={StaticResource InverseBoolToVisibility}}" />

            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="0"
                    Margin="0,0,16,0"
                    Visibility="{Binding HasUsers, Converter={StaticResource BoolToVisibility}}">
                <ListBox ItemsSource="{Binding Users}"
                         AutomationProperties.Name="Статистика пользователей"
                         SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource RatingRowItem}"
                         ItemTemplate="{StaticResource RatingRowTemplate}"
                         SelectionMode="Single"
                         HorizontalContentAlignment="Stretch"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Border>

            <ScrollViewer Grid.Column="1"
                          Visibility="{Binding HasUsers, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <Border Style="{StaticResource Card}"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Общая статистика"
                                       Style="{StaticResource TextBlock.Heading}"
                                       Margin="0,0,0,8" />

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding TotalUsers}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Fg.Primary}" />
                                <TextBlock Text="Пользователей"
                                           Style="{StaticResource TextBlock.Subtle}" />
                            </DockPanel>

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding TotalMessages}"
                                           Foreground="{DynamicResource Fg.Secondary}" />
                                <TextBlock Text="Сообщений"
                                           Style="{StaticResource TextBlock.Subtle}" />
                            </DockPanel>

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding TotalPoints}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Fg.Primary}" />
                                <TextBlock Text="Баллов"
                                           Style="{StaticResource TextBlock.Subtle}" />
                            </DockPanel>

                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding TotalBonusPenalty}"
                                           FontSize="{DynamicResource Font.Size.XS}"
                                           Foreground="{DynamicResource Fg.Secondary}" />
                                <TextBlock Text="Бонус / Штраф"
                                           Style="{StaticResource TextBlock.Subtle}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Пользователь"
                                       Style="{StaticResource TextBlock.Heading}"
                                       Margin="0,0,0,8" />

                            <StackPanel Visibility="{Binding HasSelectedRow, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding SelectedRow.Name}"
                                           FontWeight="SemiBold"
                                           FontSize="{DynamicResource Font.Size.L}"
                                           Foreground="{DynamicResource Fg.Primary}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,2" />
                                <TextBlock Text="{Binding SelectedRow.UserId}"
                                           Style="{StaticResource TextBlock.Subtle}"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SelectedRow.RankDisplay}"
                                           Foreground="{DynamicResource Fg.Secondary}"
                                           Margin="0,0,0,10" />

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding SelectedRow.Points, StringFormat=N0}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg.Primary}" />
                                    <TextBlock Text="Баллы"
                                               Style="{StaticResource TextBlock.Subtle}" />
                                </DockPanel>

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding SelectedRow.MessageCount, StringFormat=N0}"
                                               Foreground="{DynamicResource Fg.Secondary}" />
                                    <TextBlock Text="Сообщения"
                                               Style="{StaticResource TextBlock.Subtle}" />
                                </DockPanel>

                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding SelectedRow.BonusPoints, StringFormat=N0}"
                                               Foreground="{DynamicResource State.SuccessText}" />
                                    <TextBlock Text="Бонус"
                                               Style="{StaticResource TextBlock.Subtle}" />
                                </DockPanel>

                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding SelectedRow.PenaltyPoints, StringFormat=N0}"
                                               Foreground="{DynamicResource State.ErrorText}" />
                                    <TextBlock Text="Штраф"
                                               Style="{StaticResource TextBlock.Subtle}" />
                                </DockPanel>

                                <TextBlock Text="Управление баллами"
                                           Style="{StaticResource TextBlock.Heading}"
                                           Margin="0,16,0,12" />

                                <keepshell:NumericSettingField Label="Изменение баланса"
                                                              Value="{Binding AdjustmentAmount, Mode=TwoWay}"
                                                              IncreaseCommand="{Binding IncreaseAdjustmentCommand}"
                                                              DecreaseCommand="{Binding DecreaseAdjustmentCommand}"
                                                              IncreaseAutomationName="Увеличить"
                                                              DecreaseAutomationName="Уменьшить"
                                                              Margin="0,0,0,12" />

                                <Button Content="{Binding ActionButtonText}"
                                        Command="{Binding ApplyAdjustmentCommand}"
                                        Style="{StaticResource Button.Primary}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" />
                            </StackPanel>

                            <StackPanel Margin="0,12,0,4"
                                        Visibility="{Binding HasSelectedRow, Converter={StaticResource InverseBoolToVisibility}}">
                                <iconPacks:PackIconLucide Kind="MousePointerClick"
                                                          Width="20"
                                                          Height="20"
                                                          HorizontalAlignment="Center"
                                                          Foreground="{DynamicResource Fg.Muted}" />
                                <TextBlock Text="Выберите пользователя в списке"
                                           Style="{StaticResource TextBlock.Subtle}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
