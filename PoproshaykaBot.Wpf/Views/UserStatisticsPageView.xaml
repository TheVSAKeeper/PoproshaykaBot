<UserControl x:Class="PoproshaykaBot.Wpf.Views.UserStatisticsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels"
             xmlns:views="clr-namespace:PoproshaykaBot.Wpf.Views"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:controls="clr-namespace:KeepShell.Views.Controls;assembly=KeepShell"
             xmlns:platformControls="clr-namespace:PoproshaykaBot.Wpf.Views.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:UserStatisticsPageViewModel}"
             d:DesignHeight="720"
             d:DesignWidth="1100">

    <UserControl.Resources>

        <Style x:Key="AdjustmentInput"
               TargetType="TextBox"
               BasedOn="{StaticResource TextBox.Numeric}">
            <Setter Property="Height"
                    Value="Auto" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasAdjustmentError}"
                             Value="True">
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource State.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InspectorBonusValue"
               TargetType="TextBlock"
               BasedOn="{StaticResource StatValue.Small}">
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedRow.HasBonus}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.SuccessText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InspectorPenaltyValue"
               TargetType="TextBlock"
               BasedOn="{StaticResource StatValue.Small}">
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedRow.HasPenalty}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.ErrorText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SummaryBonusValue"
               TargetType="TextBlock"
               BasedOn="{StaticResource StatValue}">
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasTotalBonus}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.SuccessText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SummaryPenaltyValue"
               TargetType="TextBlock"
               BasedOn="{StaticResource StatValue}">
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasTotalPenalty}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.ErrorText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AvatarTint"
               TargetType="Ellipse">
            <Setter Property="StrokeThickness"
                    Value="1" />
            <Setter Property="Fill"
                    Value="{DynamicResource Bg.SurfaceMute}" />
            <Setter Property="Stroke"
                    Value="{DynamicResource Border.Strong}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PaletteIndex}"
                             Value="0">
                    <Setter Property="Fill"
                            Value="{DynamicResource Accent.Soft}" />
                    <Setter Property="Stroke"
                            Value="{DynamicResource Accent.Primary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PaletteIndex}"
                             Value="1">
                    <Setter Property="Fill"
                            Value="{DynamicResource State.InfoSoft}" />
                    <Setter Property="Stroke"
                            Value="{DynamicResource State.Info}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PaletteIndex}"
                             Value="2">
                    <Setter Property="Fill"
                            Value="{DynamicResource State.SuccessSoft}" />
                    <Setter Property="Stroke"
                            Value="{DynamicResource State.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PaletteIndex}"
                             Value="3">
                    <Setter Property="Fill"
                            Value="{DynamicResource State.WarningSoft}" />
                    <Setter Property="Stroke"
                            Value="{DynamicResource State.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PaletteIndex}"
                             Value="4">
                    <Setter Property="Fill"
                            Value="{DynamicResource State.ErrorSoft}" />
                    <Setter Property="Stroke"
                            Value="{DynamicResource State.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AvatarInitial"
               TargetType="TextBlock">
            <Setter Property="FontWeight"
                    Value="{DynamicResource Font.Weight.SemiBold}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Secondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PaletteIndex}"
                             Value="0">
                    <Setter Property="Foreground"
                            Value="{DynamicResource Accent.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PaletteIndex}"
                             Value="1">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.InfoText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PaletteIndex}"
                             Value="2">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.SuccessText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PaletteIndex}"
                             Value="3">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.WarningText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PaletteIndex}"
                             Value="4">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.ErrorText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="UserAvatarCircle"
                      DataType="{x:Type vm:UserAvatarViewModel}">
            <Grid>
                <Ellipse Fill="{DynamicResource Bg.Surface}" />
                <Ellipse Style="{StaticResource AvatarTint}" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Row="1"
                             Grid.Column="1">
                        <TextBlock Style="{StaticResource AvatarInitial}"
                                   Text="{Binding Initial}" />
                    </Viewbox>
                </Grid>
                <Image Source="{Binding Image}"
                       Stretch="UniformToFill"
                       Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                    <Image.OpacityMask>
                        <VisualBrush>
                            <VisualBrush.Visual>
                                <Ellipse Width="1"
                                         Height="1"
                                         Fill="Black" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Image.OpacityMask>
                </Image>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="UserRatingRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"
                                      SharedSizeGroup="RatingPosition" />
                    <ColumnDefinition Width="*"
                                      MinWidth="92" />
                    <ColumnDefinition Width="Auto"
                                      SharedSizeGroup="RatingRank" />
                    <ColumnDefinition Width="Auto"
                                      SharedSizeGroup="RatingPoints" />
                    <ColumnDefinition Width="Auto"
                                      SharedSizeGroup="RatingMessages" />
                </Grid.ColumnDefinitions>

                <ContentPresenter Grid.Column="0"
                                  Content="{Binding}"
                                  ContentTemplate="{StaticResource RatingPositionCell}" />

                <DockPanel Grid.Column="1"
                           Margin="10,0,10,0">
                    <ContentPresenter DockPanel.Dock="Left"
                                      Width="24"
                                      Height="24"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      Content="{Binding Avatar}"
                                      ContentTemplate="{StaticResource UserAvatarCircle}"
                                      DataContextChanged="OnRowAvatarDataContextChanged" />

                    <platformControls:PlatformIconView DockPanel.Dock="Right"
                                                       Platform="{Binding Platform, Mode=OneWay}"
                                                       Width="14"
                                                       Height="14"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center" />

                    <TextBlock Style="{StaticResource RatingName}"
                               Text="{Binding Name}" />
                </DockPanel>

                <Border Grid.Column="2"
                        Style="{StaticResource Badge}"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0"
                        Visibility="{Binding ShowsRankColumn, RelativeSource={RelativeSource AncestorType=views:UserStatisticsPageView}, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding RankDisplay}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{DynamicResource Fg.Secondary}"
                               TextWrapping="NoWrap" />
                </Border>

                <TextBlock Grid.Column="3"
                           Style="{StaticResource RatingNumber.Strong}"
                           Text="{Binding PointsDisplay}"
                           Margin="10,0,8,0" />

                <TextBlock Grid.Column="4"
                           Style="{StaticResource RatingNumber}"
                           Text="{Binding MessageCountDisplay}"
                           Margin="10,0,8,0" />
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="FilterBar"
              Grid.Row="0"
              Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"
                                  MinWidth="150"
                                  MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0"
                  Grid.Column="0">
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource TextBox.IconField}"
                         Padding="10,0,32,0"
                         Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                         AutomationProperties.Name="Поиск участника по нику или идентификатору" />

                <TextBlock Text="Найти по нику или ID"
                           Margin="43,0,38,0"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Fg.Muted}"
                           IsHitTestVisible="False"
                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />

                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,2,0"
                        Style="{StaticResource Button.Icon}"
                        Command="{Binding ClearFilterCommand}"
                        AutomationProperties.Name="Очистить поиск"
                        ToolTip="Очистить поиск"
                        Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVisibility}}">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.X}"
                                              Width="14"
                                              Height="14" />
                </Button>
            </Grid>

            <ComboBox HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      MinWidth="156"
                      ItemsSource="{Binding SliceOptions}"
                      SelectedItem="{Binding SelectedSliceOption, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      AutomationProperties.Name="Срез статистики">
                <ComboBox.Style>
                    <Style TargetType="ComboBox"
                           BasedOn="{StaticResource ComboBox.Toolbar}">
                        <Setter Property="Grid.Row"
                                Value="0" />
                        <Setter Property="Grid.Column"
                                Value="1" />
                        <Setter Property="Margin"
                                Value="8,0,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactFilterBar, RelativeSource={RelativeSource AncestorType=views:UserStatisticsPageView}}"
                                         Value="True">
                                <Setter Property="Grid.Row"
                                        Value="1" />
                                <Setter Property="Grid.Column"
                                        Value="0" />
                                <Setter Property="Margin"
                                        Value="0,6,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Grid.Row"
                                Value="0" />
                        <Setter Property="Grid.Column"
                                Value="3" />
                        <Setter Property="Margin"
                                Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactFilterBar, RelativeSource={RelativeSource AncestorType=views:UserStatisticsPageView}}"
                                         Value="True">
                                <Setter Property="Grid.Row"
                                        Value="1" />
                                <Setter Property="Grid.Column"
                                        Value="1" />
                                <Setter Property="Grid.ColumnSpan"
                                        Value="3" />
                                <Setter Property="Margin"
                                        Value="8,6,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Content="Перенос баллов…"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding TransferPointsCommand}"
                        AutomationProperties.Name="Перенести баллы между источниками"
                        Margin="8,0,0,0" />
                <Button Content="Названия баллов"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding EditPointTermCommand}"
                        AutomationProperties.Name="Изменить названия баллов"
                        Margin="8,0,8,0" />
                <Button Style="{StaticResource Button.Icon}"
                        Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="Перечитать статистику"
                        ToolTip="Перечитать статистику">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.RefreshCw}"
                                              Width="14"
                                              Height="14" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*"
                                  MinWidth="300"
                                  MaxWidth="380" />
            </Grid.ColumnDefinitions>

            <controls:EmptyState Grid.Column="0"
                                 Grid.ColumnSpan="2"
                                 Icon="Users"
                                 Heading="{Binding EmptyHeading}"
                                 Description="{Binding EmptyDescription}"
                                 DescriptionMaxWidth="320"
                                 ActionText="{Binding EmptyActionText}"
                                 ActionCommand="{Binding EmptyActionCommand}"
                                 Visibility="{Binding HasUsers, Converter={StaticResource InverseBoolToVisibility}}" />

            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="0"
                    Margin="0,0,16,0"
                    Visibility="{Binding HasUsers, Converter={StaticResource BoolToVisibility}}">
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="16,10,16,8">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Left"
                                    Style="{StaticResource Button.Ghost}"
                                    Command="{Binding ToggleSummaryCommand}"
                                    HorizontalAlignment="Left"
                                    MinHeight="0"
                                    Padding="4,2"
                                    Margin="-4,0,8,0"
                                    AutomationProperties.Name="{Binding SummaryToggleCaption}"
                                    ToolTip="{Binding SummaryToggleCaption}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Width="13"
                                                              Height="13"
                                                              VerticalAlignment="Center"
                                                              Foreground="{DynamicResource Fg.Secondary}">
                                        <iconPacks:PackIconLucide.Style>
                                            <Style TargetType="iconPacks:PackIconLucide">
                                                <Setter Property="Kind"
                                                        Value="ChevronRight" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowExpandedSummary}"
                                                                 Value="True">
                                                        <Setter Property="Kind"
                                                                Value="ChevronDown" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </iconPacks:PackIconLucide.Style>
                                    </iconPacks:PackIconLucide>
                                    <TextBlock Text="Сводка"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Fg.Muted}"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="{Binding SummaryLine}"
                                       FontSize="{DynamicResource Font.Size.S}"
                                       Foreground="{DynamicResource Fg.Secondary}"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SummaryLine}"
                                       Visibility="{Binding ShowExpandedSummary, Converter={StaticResource InverseBoolToVisibility}}" />
                        </DockPanel>

                        <WrapPanel Orientation="Horizontal"
                                   Margin="0,6,-8,-8"
                                   Visibility="{Binding ShowExpandedSummary, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource StatCell}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StatValue}"
                                               Text="{Binding TotalUsers}" />
                                    <TextBlock Style="{StaticResource StatLabel}"
                                               Text="участников" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCell}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StatValue}"
                                               Text="{Binding TotalMessages}" />
                                    <TextBlock Style="{StaticResource StatLabel}"
                                               Text="сообщений" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCell}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StatValue}"
                                               Text="{Binding TotalPoints}" />
                                    <TextBlock Style="{StaticResource StatLabel}"
                                               Text="баллов" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCell}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SummaryBonusValue}"
                                               Text="{Binding TotalBonus}" />
                                    <TextBlock Style="{StaticResource StatLabel}"
                                               Text="бонус" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCell}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SummaryPenaltyValue}"
                                               Text="{Binding TotalPenalty}" />
                                    <TextBlock Style="{StaticResource StatLabel}"
                                               Text="штраф" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <TextBlock Style="{StaticResource StatLabel}"
                                   Margin="0,6,0,0"
                                   Text="{Binding VisibleCountText}"
                                   Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Height="1"
                            Background="{DynamicResource Border.Subtle}" />

                    <Grid x:Name="RatingHeader"
                          Grid.Row="2"
                          Margin="12,6,24,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="RatingPosition" />
                            <ColumnDefinition Width="*"
                                              MinWidth="92" />
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="RatingRank" />
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="RatingPoints" />
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="RatingMessages" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource RatingHeaderText}"
                                   Text="#"
                                   HorizontalAlignment="Center" />

                        <Button Grid.Column="1"
                                Style="{StaticResource TableSortButton}"
                                HorizontalAlignment="Left"
                                Margin="34,0,0,0"
                                Command="{Binding SortByCommand}"
                                CommandParameter="{x:Static vm:UserStatisticsSortKey.Name}"
                                AutomationProperties.Name="Сортировать по нику">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Участник" />
                                <Path Style="{StaticResource TableSortArrow}"
                                      Tag="{Binding NameSortIndicator}" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource TableSortButton}"
                                HorizontalAlignment="Left"
                                Margin="2,0,0,0"
                                Command="{Binding SortByCommand}"
                                CommandParameter="{x:Static vm:UserStatisticsSortKey.Rank}"
                                AutomationProperties.Name="Сортировать по рангу"
                                Visibility="{Binding ShowsRankColumn, RelativeSource={RelativeSource AncestorType=views:UserStatisticsPageView}, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ранг" />
                                <Path Style="{StaticResource TableSortArrow}"
                                      Tag="{Binding RankSortIndicator}" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3"
                                Style="{StaticResource TableSortButton}"
                                HorizontalAlignment="Right"
                                Margin="2,0,0,0"
                                Command="{Binding SortByCommand}"
                                CommandParameter="{x:Static vm:UserStatisticsSortKey.Points}"
                                AutomationProperties.Name="Сортировать по баллам">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Баллы" />
                                <Path Style="{StaticResource TableSortArrow}"
                                      Tag="{Binding PointsSortIndicator}" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="4"
                                Style="{StaticResource TableSortButton}"
                                HorizontalAlignment="Right"
                                Margin="2,0,0,0"
                                Command="{Binding SortByCommand}"
                                CommandParameter="{x:Static vm:UserStatisticsSortKey.Messages}"
                                AutomationProperties.Name="Сортировать по сообщениям">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Сообщения" />
                                <Path Style="{StaticResource TableSortArrow}"
                                      Tag="{Binding MessagesSortIndicator}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListBox x:Name="RatingList"
                             Grid.Row="3"
                             ItemsSource="{Binding Users}"
                             AutomationProperties.Name="Рейтинг участников"
                             SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource RatingRowItem}"
                             ItemTemplate="{StaticResource UserRatingRowTemplate}"
                             SelectionMode="Single"
                             HorizontalContentAlignment="Stretch"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Visible" />
                </Grid>
            </Border>

            <Border x:Name="InspectorCard"
                    Grid.Column="1"
                    Style="{StaticResource Card}"
                    Padding="16,12"
                    Visibility="{Binding HasUsers, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer x:Name="OuterInspectorScroll"
                              AutomationProperties.Name="Карточка пользователя"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="VerticalScrollBarVisibility"
                                    Value="Disabled" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInspectorScrollCombined, RelativeSource={RelativeSource AncestorType=views:UserStatisticsPageView}}"
                                             Value="True">
                                    <Setter Property="VerticalScrollBarVisibility"
                                            Value="Auto" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="ProfileStatsScroll"
                                      Grid.Row="0"
                                      AutomationProperties.Name="Статистика профиля пользователя"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasSelectedRow, Converter={StaticResource BoolToVisibility}}">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="VerticalScrollBarVisibility"
                                            Value="Auto" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInspectorScrollCombined, RelativeSource={RelativeSource AncestorType=views:UserStatisticsPageView}}"
                                                     Value="True">
                                            <Setter Property="VerticalScrollBarVisibility"
                                                    Value="Disabled" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel Margin="0,0,12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  Width="56"
                                                  Height="56"
                                                  Margin="0,0,12,0"
                                                  VerticalAlignment="Center"
                                                  Content="{Binding SelectedRow.Avatar}"
                                                  ContentTemplate="{StaticResource UserAvatarCircle}" />

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <WrapPanel x:Name="IdentityHeader"
                                               Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedRow.Name}"
                                                   MaxWidth="{Binding ActualWidth, ElementName=IdentityHeader}"
                                                   FontSize="{DynamicResource Font.Size.XL}"
                                                   FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                                   Foreground="{DynamicResource Fg.Primary}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedRow.Name}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,2" />

                                        <Border Style="{StaticResource Badge}"
                                                VerticalAlignment="Center"
                                                Margin="0,2,0,2">
                                            <TextBlock Text="{Binding SelectedRow.RankDisplay}"
                                                       FontSize="{DynamicResource Font.Size.Caption}"
                                                       Foreground="{DynamicResource Fg.Secondary}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </WrapPanel>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,4,0,0">
                                        <platformControls:PlatformIconView Platform="{Binding SelectedRow.Platform, Mode=OneWay}"
                                                                           Width="12"
                                                                           Height="12"
                                                                           Margin="0,0,6,0"
                                                                           VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedRow.UserId}"
                                                   FontFamily="{DynamicResource Font.Mono}"
                                                   FontSize="{DynamicResource Font.Size.Caption}"
                                                   Foreground="{DynamicResource Fg.Muted}"
                                                   TextWrapping="NoWrap"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding SelectedPlaceText}"
                                               Foreground="{DynamicResource Fg.Secondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <UniformGrid Columns="2"
                                         Margin="0,12,0,0">
                                <StackPanel Margin="0,0,12,6">
                                    <TextBlock Style="{StaticResource StatValue.Small}"
                                               Text="{Binding SelectedRow.PointsDisplay}" />
                                    <TextBlock Style="{StaticResource StatLabel.Wrap}"
                                               Text="баллов" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource StatValue.Small}"
                                               Text="{Binding SelectedRow.MessageCountDisplay}" />
                                    <TextBlock Style="{StaticResource StatLabel.Wrap}"
                                               Text="сообщений" />
                                </StackPanel>

                                <StackPanel Margin="0,0,12,6">
                                    <TextBlock Style="{StaticResource InspectorBonusValue}"
                                               Text="{Binding SelectedRow.BonusDisplay}" />
                                    <TextBlock Style="{StaticResource StatLabel.Wrap}"
                                               Text="бонус" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource InspectorPenaltyValue}"
                                               Text="{Binding SelectedRow.PenaltyDisplay}" />
                                    <TextBlock Style="{StaticResource StatLabel.Wrap}"
                                               Text="штраф" />
                                </StackPanel>

                                <StackPanel Margin="0,0,12,6">
                                    <TextBlock Style="{StaticResource StatValue.Small}"
                                               Text="{Binding SelectedRow.DaysInChatDisplay}" />
                                    <TextBlock Style="{StaticResource StatLabel.Wrap}"
                                               Text="дней в чате" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource StatValue.Small}"
                                               Text="{Binding SelectedRow.DailyRateDisplay}" />
                                    <TextBlock Style="{StaticResource StatLabel.Wrap}"
                                               Text="сообщений в день" />
                                </StackPanel>
                            </UniformGrid>

                            <Grid x:Name="ActivityStats"
                                  Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Column="0"
                                        Grid.RowSpan="3"
                                        Background="Transparent"
                                        ToolTip="{Binding SelectedRow.FirstSeenMoment}" />
                                <TextBlock Grid.Column="0"
                                           Grid.Row="0"
                                           Style="{StaticResource StatValue.Small}"
                                           Margin="0,0,12,0"
                                           IsHitTestVisible="False"
                                           Text="{Binding SelectedRow.FirstSeenDisplay}" />
                                <TextBlock Grid.Column="0"
                                           Grid.Row="1"
                                           Style="{StaticResource StatLabel}"
                                           Margin="0,2,12,0"
                                           TextWrapping="Wrap"
                                           IsHitTestVisible="False"
                                           Text="в чате с" />
                                <TextBlock Grid.Column="0"
                                           Grid.Row="2"
                                           Style="{StaticResource StatLabel}"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           Margin="0,2,8,0"
                                           TextWrapping="Wrap"
                                           IsHitTestVisible="False"
                                           Text="{Binding SelectedRow.FirstSeenMoment}" />

                                <Border Grid.Column="1"
                                        Grid.RowSpan="3"
                                        Background="Transparent"
                                        ToolTip="{Binding SelectedRow.LastSeenMoment}" />
                                <TextBlock Grid.Column="1"
                                           Grid.Row="0"
                                           Style="{StaticResource StatValue.Small}"
                                           IsHitTestVisible="False"
                                           Text="{Binding SelectedRow.LastSeenDisplay}" />
                                <TextBlock Grid.Column="1"
                                           Grid.Row="1"
                                           Style="{StaticResource StatLabel}"
                                           TextWrapping="Wrap"
                                           IsHitTestVisible="False"
                                           Text="последнее сообщение" />
                                <TextBlock Grid.Column="1"
                                           Grid.Row="2"
                                           Style="{StaticResource StatLabel}"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           TextWrapping="Wrap"
                                           IsHitTestVisible="False"
                                           Text="{Binding SelectedRow.LastSeenMoment}" />
                            </Grid>

                            <TextBlock Style="{StaticResource StatLabel}"
                                       Text="состав баллов"
                                       Margin="0,16,0,0" />

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="CompositionBar"
                                        Grid.Column="0"
                                        Background="{DynamicResource Bg.SurfaceMute}"
                                        CornerRadius="5"
                                        Height="10">
                                    <Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding SelectedRow.MessagesTrack}" />
                                                <ColumnDefinition Width="{Binding SelectedRow.BonusTrack}" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource Accent.Primary}"
                                                    CornerRadius="5"
                                                    Margin="0,0,2,0" />
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource State.Success}"
                                                    CornerRadius="5" />
                                        </Grid>

                                        <Grid x:Name="PenaltyCut"
                                              Visibility="{Binding SelectedRow.HasPenalty, Converter={StaticResource BoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding SelectedRow.EarnedNetTrack}"
                                                                  MinWidth="2" />
                                                <ColumnDefinition Width="{Binding SelectedRow.PenaltyCutTrack}" />
                                            </Grid.ColumnDefinitions>

                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Grid.Column" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedRow.IsPenaltyCutWhole}" Value="True">
                                                                <Setter Property="Grid.Column" Value="0" />
                                                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="0,5,5,0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedRow.IsPenaltyCutWhole}" Value="True">
                                                                <Setter Property="CornerRadius" Value="5" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Resources>
                                                <Border Background="{DynamicResource Bg.SurfaceMute}" />
                                                <Border Background="{DynamicResource State.Error}"
                                                        Opacity="0.4" />
                                            </Grid>

                                            <Border x:Name="PenaltyCutEdge"
                                                    Grid.Column="0"
                                                    Width="2"
                                                    Height="14"
                                                    Margin="0,-2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="1"
                                                    Background="{DynamicResource Fg.Primary}" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="TinyTrackMarkers"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="4,0,0,0"
                                            Background="Transparent"
                                            ToolTip="Часть слишком мала, чтобы быть видной на полосе"
                                            Visibility="{Binding SelectedRow.HasTinyTrack, Converter={StaticResource BoolToVisibility}}">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Margin="2,0,0,0"
                                             Fill="{DynamicResource Accent.Primary}"
                                             Visibility="{Binding SelectedRow.IsMessagesTrackTiny, Converter={StaticResource BoolToVisibility}}" />
                                    <Ellipse Width="6"
                                             Height="6"
                                             Margin="2,0,0,0"
                                             Fill="{DynamicResource State.Success}"
                                             Visibility="{Binding SelectedRow.IsBonusTrackTiny, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>

                            <WrapPanel Orientation="Horizontal"
                                       Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,0">
                                    <Ellipse Width="8"
                                             Height="8"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource Accent.Primary}" />
                                    <TextBlock Text="{Binding SelectedRow.MessagesPartText}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Fg.Secondary}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,0"
                                            Visibility="{Binding SelectedRow.HasBonus, Converter={StaticResource BoolToVisibility}}">
                                    <Ellipse Width="8"
                                             Height="8"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource State.Success}" />
                                    <TextBlock Text="{Binding SelectedRow.BonusPartText}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource State.SuccessText}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding SelectedRow.HasPenalty, Converter={StaticResource BoolToVisibility}}">
                                    <Ellipse Width="8"
                                             Height="8"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource State.Error}" />
                                    <TextBlock Text="{Binding SelectedRow.PenaltyPartText}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource State.ErrorText}"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </WrapPanel>

                            <StackPanel Margin="0,16,0,0"
                                        Visibility="{Binding SelectedRow.HasRankLadder, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource StatLabel}"
                                           Text="путь по рангам" />

                                <ItemsControl x:Name="RankLadder"
                                              ItemsSource="{Binding RankLadderSteps}"
                                              Focusable="False"
                                              Grid.IsSharedSizeScope="True"
                                              AutomationProperties.Name="{Binding SelectedRow.RankLadder.Summary}"
                                              Margin="0,6,0,0">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="AutomationProperties.Name"
                                                    Value="{Binding AutomationName}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:UserRankLadderStep}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Column="0"
                                                      Grid.Row="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0"
                                                            Width="2"
                                                            HorizontalAlignment="Center"
                                                            Visibility="{Binding HasAbove, Converter={StaticResource BoolToVisibility}}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource Border.Default}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAboveReached}"
                                                                                 Value="True">
                                                                        <Setter Property="Background"
                                                                                Value="{DynamicResource Accent.Primary}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>

                                                    <Border Grid.Row="1"
                                                            Width="2"
                                                            HorizontalAlignment="Center"
                                                            Visibility="{Binding HasBelow, Converter={StaticResource BoolToVisibility}}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource Border.Default}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsReached}"
                                                                                 Value="True">
                                                                        <Setter Property="Background"
                                                                                Value="{DynamicResource Accent.Primary}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>

                                                    <Border Grid.RowSpan="2"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Width"
                                                                        Value="10" />
                                                                <Setter Property="Height"
                                                                        Value="10" />
                                                                <Setter Property="CornerRadius"
                                                                        Value="5" />
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource Bg.Surface}" />
                                                                <Setter Property="BorderBrush"
                                                                        Value="{DynamicResource Border.Strong}" />
                                                                <Setter Property="BorderThickness"
                                                                        Value="1.5" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPassed}"
                                                                                 Value="True">
                                                                        <Setter Property="Width"
                                                                                Value="14" />
                                                                        <Setter Property="Height"
                                                                                Value="14" />
                                                                        <Setter Property="CornerRadius"
                                                                                Value="7" />
                                                                        <Setter Property="Background"
                                                                                Value="{DynamicResource Accent.Primary}" />
                                                                        <Setter Property="BorderThickness"
                                                                                Value="0" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCurrent}"
                                                                                 Value="True">
                                                                        <Setter Property="Width"
                                                                                Value="14" />
                                                                        <Setter Property="Height"
                                                                                Value="14" />
                                                                        <Setter Property="CornerRadius"
                                                                                Value="7" />
                                                                        <Setter Property="BorderBrush"
                                                                                Value="{DynamicResource Accent.Primary}" />
                                                                        <Setter Property="BorderThickness"
                                                                                Value="4" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsGap}"
                                                                                 Value="True">
                                                                        <Setter Property="Visibility"
                                                                                Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <TextBlock Text="✓"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource Fg.OnAccent}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsPassed, Converter={StaticResource BoolToVisibility}}" />
                                                    </Border>
                                                </Grid>

                                                <Border Grid.Column="0"
                                                        Grid.Row="1"
                                                        Width="2"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding HasBelow, Converter={StaticResource BoolToVisibility}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource Border.Default}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsReached}"
                                                                             Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource Accent.Primary}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <Border Grid.Column="1"
                                                        Grid.Row="0"
                                                        Grid.RowSpan="2"
                                                        Margin="4,1,0,1"
                                                        CornerRadius="{DynamicResource Radius.S}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background"
                                                                    Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}"
                                                                             Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource Accent.Soft}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <Grid Grid.Column="1"
                                                      Grid.Row="0"
                                                      Margin="8,4,8,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"
                                                                          SharedSizeGroup="LadderEmoji" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto"
                                                                          SharedSizeGroup="LadderThreshold" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Emoji}"
                                                               Foreground="{DynamicResource Fg.Secondary}"
                                                               TextWrapping="NoWrap"
                                                               Margin="0,0,8,0" />

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Name}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource Fg.Primary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsReached}"
                                                                                 Value="False">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource Fg.Secondary}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCurrent}"
                                                                                 Value="True">
                                                                        <Setter Property="FontWeight"
                                                                                Value="{DynamicResource Font.Weight.SemiBold}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsGap}"
                                                                                 Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource Fg.Secondary}" />
                                                                        <Setter Property="FontSize"
                                                                                Value="{DynamicResource Font.Size.Caption}" />
                                                                        <Setter Property="Grid.ColumnSpan"
                                                                                Value="2" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding ThresholdText}"
                                                               Foreground="{DynamicResource Fg.Secondary}"
                                                               TextAlignment="Right"
                                                               TextWrapping="NoWrap"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,0,0" />
                                                </Grid>

                                                <StackPanel Grid.Column="1"
                                                            Grid.Row="1"
                                                            Margin="8,0,8,8"
                                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                                    <Border Background="{DynamicResource Bg.Surface}"
                                                            CornerRadius="3"
                                                            Height="6"
                                                            Margin="0,2,0,6"
                                                            Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding ProgressTrack}" />
                                                                <ColumnDefinition Width="{Binding RemainderTrack}" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Background="{DynamicResource Accent.Primary}"
                                                                    CornerRadius="3" />
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Text="{Binding ProgressText}"
                                                               FontSize="{DynamicResource Font.Size.Caption}"
                                                               Foreground="{DynamicResource Fg.Secondary}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button x:Name="RankLadderToggle"
                                        Style="{StaticResource Button.Link}"
                                        FontSize="{DynamicResource Font.Size.Caption}"
                                        Content="{Binding RankLadderToggleText}"
                                        Command="{Binding ToggleRankLadderCommand}"
                                        HorizontalAlignment="Left"
                                        Margin="30,4,0,0"
                                        Visibility="{Binding SelectedRow.RankLadder.CanCollapse, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                            </StackPanel>

                            <StackPanel x:Name="ChannelBreakdownsSection"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding SelectedRow.HasChannelBreakdowns, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                <TextBlock Text="По каналам"
                                           Style="{StaticResource TextBlock.Subtle}"
                                           Margin="0,0,0,6" />

                                <ItemsControl ItemsSource="{Binding SelectedRow.ChannelBreakdowns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:UserChannelBreakdownRowViewModel}">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Label}"
                                                           Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="1"
                                                           Foreground="{DynamicResource Fg.Secondary}"
                                                           TextWrapping="NoWrap">
                                                    <Run Text="{Binding PointsDisplay, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding MessageCountDisplay, Mode=OneWay}" />
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="LinkedAccountsSection"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding CanManageLinks, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                <TextBlock Text="Связанные аккаунты"
                                           Style="{StaticResource TextBlock.Subtle}"
                                           Margin="0,0,0,6" />

                                <ItemsControl ItemsSource="{Binding SelectedRow.LinkedAccounts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:UserLinkedAccountRowViewModel}">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0"
                                                            Margin="0,0,8,0">
                                                    <TextBlock TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding PlatformLabel, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding OriginLabel}"
                                                               Style="{StaticResource TextBlock.Subtle}"
                                                               FontSize="{DynamicResource Font.Size.Caption}"
                                                               Visibility="{Binding HasOriginLabel, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource Button.Link}"
                                                        FontSize="{DynamicResource Font.Size.Caption}"
                                                        Content="Отвязать"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.UnlinkAccountCommand, RelativeSource={RelativeSource AncestorType=views:UserStatisticsPageView}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanUnlink, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Style="{StaticResource Button.Secondary}"
                                        Content="Привязать аккаунт…"
                                        Command="{Binding LinkAccountCommand}"
                                        HorizontalAlignment="Left"
                                        Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1"
                                Visibility="{Binding HasSelectedRow, Converter={StaticResource BoolToVisibility}}">
                        <Border Height="1"
                                Background="{DynamicResource Border.Subtle}"
                                Margin="0,8,0,0" />

                        <Button x:Name="BalanceToggle"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding ToggleBalanceCommand}"
                                HorizontalAlignment="Left"
                                MinHeight="0"
                                Padding="6,4"
                                Margin="-6,6,0,0"
                                AutomationProperties.Name="{Binding BalanceToggleCaption}"
                                ToolTip="{Binding BalanceToggleCaption}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Баланс"
                                           Style="{StaticResource TextBlock.Heading}"
                                           FontSize="{DynamicResource Font.Size.L}"
                                           VerticalAlignment="Center" />

                                <iconPacks:PackIconLucide Width="14"
                                                          Height="14"
                                                          Margin="8,0,0,0"
                                                          VerticalAlignment="Center"
                                                          Foreground="{DynamicResource Fg.Secondary}">
                                    <iconPacks:PackIconLucide.Style>
                                        <Style TargetType="iconPacks:PackIconLucide">
                                            <Setter Property="Kind"
                                                    Value="ChevronRight" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBalanceExpanded}"
                                                             Value="True">
                                                    <Setter Property="Kind"
                                                            Value="ChevronDown" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconLucide.Style>
                                </iconPacks:PackIconLucide>
                            </StackPanel>
                        </Button>

                        <StackPanel x:Name="BalanceBody"
                                    Margin="0,6,0,0"
                                    Visibility="{Binding IsBalanceExpanded, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Margin="0,0,0,8"
                                        Visibility="{Binding HasMultipleAdjustmentTargets, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                <TextBlock Text="Канал начисления"
                                           Style="{StaticResource TextBlock.Subtle}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AdjustmentTargetOptions}"
                                          SelectedItem="{Binding SelectedAdjustmentTarget, Mode=TwoWay}"
                                          DisplayMemberPath="Label"
                                          AutomationProperties.Name="Канал начисления" />
                            </StackPanel>

                            <UniformGrid Columns="4"
                                         Margin="0,0,0,8">
                                <Button Style="{StaticResource QuickAmountButton}"
                                        Command="{Binding SetAdjustmentCommand}"
                                        Content="−100"
                                        Margin="0,0,6,0"
                                        AutomationProperties.Name="Поставить минус сто баллов">
                                    <Button.CommandParameter>
                                        <sys:Double>-100</sys:Double>
                                    </Button.CommandParameter>
                                </Button>
                                <Button Style="{StaticResource QuickAmountButton}"
                                        Command="{Binding SetAdjustmentCommand}"
                                        Content="−10"
                                        Margin="0,0,6,0"
                                        AutomationProperties.Name="Поставить минус десять баллов">
                                    <Button.CommandParameter>
                                        <sys:Double>-10</sys:Double>
                                    </Button.CommandParameter>
                                </Button>
                                <Button Style="{StaticResource QuickAmountButton}"
                                        Command="{Binding SetAdjustmentCommand}"
                                        Content="+10"
                                        Margin="0,0,6,0"
                                        AutomationProperties.Name="Поставить плюс десять баллов">
                                    <Button.CommandParameter>
                                        <sys:Double>10</sys:Double>
                                    </Button.CommandParameter>
                                </Button>
                                <Button Style="{StaticResource QuickAmountButton}"
                                        Command="{Binding SetAdjustmentCommand}"
                                        Content="+100"
                                        AutomationProperties.Name="Поставить плюс сто баллов">
                                    <Button.CommandParameter>
                                        <sys:Double>100</sys:Double>
                                    </Button.CommandParameter>
                                </Button>
                            </UniformGrid>

                            <StackPanel x:Name="AdjustmentField"
                                        Margin="0,0,0,8">
                                <TextBlock Text="Изменение баланса"
                                           Style="{StaticResource TextBlock.Subtle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4" />

                                <Grid>
                                    <TextBox x:Name="AdjustmentBox"
                                             Text="{Binding AdjustmentText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource AdjustmentInput}"
                                             AutomationProperties.Name="Изменение баланса"
                                             AutomationProperties.HelpText="{Binding AdjustmentError, TargetNullValue={x:Static sys:String.Empty}}" />
                                    <UniformGrid Style="{StaticResource UniformGrid.Steppers}">
                                        <RepeatButton Style="{StaticResource RepeatButton.StepperUp}"
                                                      Command="{Binding IncreaseAdjustmentCommand}"
                                                      AutomationProperties.Name="Увеличить">
                                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ChevronUp}"
                                                                      Width="10"
                                                                      Height="10" />
                                        </RepeatButton>
                                        <RepeatButton Style="{StaticResource RepeatButton.StepperDown}"
                                                      Command="{Binding DecreaseAdjustmentCommand}"
                                                      AutomationProperties.Name="Уменьшить">
                                            <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.ChevronDown}"
                                                                      Width="10"
                                                                      Height="10" />
                                        </RepeatButton>
                                    </UniformGrid>
                                </Grid>

                                <TextBlock x:Name="AdjustmentErrorText"
                                           Text="{Binding AdjustmentError}"
                                           Foreground="{DynamicResource State.ErrorText}"
                                           FontSize="{DynamicResource Font.Size.S}"
                                           TextWrapping="Wrap"
                                           Margin="2,4,0,0"
                                           AutomationProperties.LiveSetting="Assertive"
                                           Visibility="{Binding HasAdjustmentError, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <Button x:Name="ApplyAdjustmentButton"
                                    Content="{Binding ActionButtonText}"
                                    Command="{Binding ApplyAdjustmentCommand}"
                                    Style="{StaticResource Button.Primary}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.RowSpan="2"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasSelectedRow, Converter={StaticResource InverseBoolToVisibility}}">
                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.MousePointerClick}"
                                                  Width="20"
                                                  Height="20"
                                                  HorizontalAlignment="Center"
                                                  Foreground="{DynamicResource Fg.Muted}" />
                        <TextBlock Text="Выберите участника в списке"
                                   Style="{StaticResource TextBlock.Subtle}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
