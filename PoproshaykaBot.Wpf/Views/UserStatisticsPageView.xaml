<UserControl x:Class="PoproshaykaBot.Wpf.Views.UserStatisticsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:UserStatisticsPageViewModel}"
             d:DesignHeight="720"
             d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   LastChildFill="True"
                   Margin="0,0,0,12">
            <Button DockPanel.Dock="Right"
                    Content="Обновить"
                    Style="{StaticResource Button.Ghost}"
                    Command="{Binding RefreshCommand}"
                    Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right"
                    Content="Названия баллов"
                    Style="{StaticResource Button.Ghost}"
                    Command="{Binding EditPointTermCommand}"
                    Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right"
                    Content="Очистить"
                    Style="{StaticResource Button.Ghost}"
                    Command="{Binding ClearFilterCommand}" />
            <TextBox Style="{StaticResource TextBox.Form}"
                     Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     keepshell:PlaceholderBehavior.Placeholder="Поиск пользователя (имя или ID)..." />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*"
                                  MinWidth="260" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      Margin="0,0,16,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Пользователь"
                                        Binding="{Binding Name}"
                                        SortMemberPath="Name"
                                        Width="2*" />
                    <DataGridTextColumn Header="Сообщения"
                                        Binding="{Binding MessageCount, StringFormat=N0}"
                                        SortMemberPath="MessageCount"
                                        Width="Auto"
                                        MinWidth="90" />
                    <DataGridTextColumn Header="Баллы"
                                        Binding="{Binding Points, StringFormat=N0}"
                                        SortMemberPath="Points"
                                        SortDirection="Descending"
                                        Width="*" />
                    <DataGridTextColumn Header="Ранг"
                                        Binding="{Binding RankDisplay}"
                                        SortMemberPath="RankDisplay"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <Border Style="{StaticResource Card}"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Общая статистика"
                                       Style="{StaticResource TextBlock.Heading}"
                                       Margin="0,0,0,8" />

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding TotalUsers}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Fg.Primary}" />
                                <TextBlock Text="Пользователей"
                                           Style="{StaticResource TextBlock.Subtle}" />
                            </DockPanel>

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding TotalMessages}"
                                           Foreground="{DynamicResource Fg.Secondary}" />
                                <TextBlock Text="Сообщений"
                                           Style="{StaticResource TextBlock.Subtle}" />
                            </DockPanel>

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding TotalPoints}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Fg.Primary}" />
                                <TextBlock Text="Баллов"
                                           Style="{StaticResource TextBlock.Subtle}" />
                            </DockPanel>

                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding TotalBonusPenalty}"
                                           FontSize="{DynamicResource Font.Size.XS}"
                                           Foreground="{DynamicResource Fg.Secondary}" />
                                <TextBlock Text="Бонус / Штраф"
                                           Style="{StaticResource TextBlock.Subtle}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Пользователь"
                                       Style="{StaticResource TextBlock.Heading}"
                                       Margin="0,0,0,8" />

                            <StackPanel Visibility="{Binding HasSelectedRow, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding SelectedRow.Name}"
                                           FontWeight="SemiBold"
                                           FontSize="{DynamicResource Font.Size.L}"
                                           Foreground="{DynamicResource Fg.Primary}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,2" />
                                <TextBlock Text="{Binding SelectedRow.UserId}"
                                           Style="{StaticResource TextBlock.Subtle}"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SelectedRow.RankDisplay}"
                                           Foreground="{DynamicResource Fg.Secondary}"
                                           Margin="0,0,0,10" />

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding SelectedRow.Points, StringFormat=N0}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg.Primary}" />
                                    <TextBlock Text="Баллы"
                                               Style="{StaticResource TextBlock.Subtle}" />
                                </DockPanel>

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding SelectedRow.MessageCount, StringFormat=N0}"
                                               Foreground="{DynamicResource Fg.Secondary}" />
                                    <TextBlock Text="Сообщения"
                                               Style="{StaticResource TextBlock.Subtle}" />
                                </DockPanel>

                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding SelectedRow.BonusPoints, StringFormat=N0}"
                                               Foreground="{DynamicResource State.Success}" />
                                    <TextBlock Text="Бонус"
                                               Style="{StaticResource TextBlock.Subtle}" />
                                </DockPanel>

                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding SelectedRow.PenaltyPoints, StringFormat=N0}"
                                               Foreground="{DynamicResource State.Error}" />
                                    <TextBlock Text="Штраф"
                                               Style="{StaticResource TextBlock.Subtle}" />
                                </DockPanel>
                            </StackPanel>

                            <TextBlock Text="Выберите пользователя в таблице"
                                       Style="{StaticResource TextBlock.Subtle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8"
                                       Visibility="{Binding HasSelectedRow, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Управление баллами"
                                       Style="{StaticResource TextBlock.Heading}"
                                       Margin="0,0,0,12" />

                            <keepshell:NumericSettingField Label="Изменение баланса"
                                                          Value="{Binding AdjustmentAmount, Mode=TwoWay}"
                                                          IncreaseCommand="{Binding IncreaseAdjustmentCommand}"
                                                          DecreaseCommand="{Binding DecreaseAdjustmentCommand}"
                                                          IncreaseAutomationName="Увеличить"
                                                          DecreaseAutomationName="Уменьшить"
                                                          Margin="0,0,0,12" />

                            <Button Content="{Binding ActionButtonText}"
                                    Command="{Binding ApplyAdjustmentCommand}"
                                    Style="{StaticResource Button.Primary}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
