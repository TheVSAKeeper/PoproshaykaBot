<UserControl x:Class="PoproshaykaBot.Wpf.Views.Tiles.ChatDisplayTileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Tiles"
             xmlns:controls="clr-namespace:KeepShell.Views.Controls;assembly=KeepShell"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ChatDisplayTileViewModel}"
             d:DesignWidth="380"
             d:DesignHeight="460">

    <DockPanel LastChildFill="True">
        <Grid>
            <Grid.Resources>
                <Style x:Key="ChatWebView" TargetType="wv2:WebView2">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsShown}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasFallback}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.IsLayoutEditing, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.IsModalDialogOpen, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <DataTemplate x:Key="ChatFallback">
                    <controls:EmptyState Icon="MessageSquareWarning"
                                         Heading="{Binding FallbackHeading}"
                                         Description="{Binding FallbackDescription}"
                                         ActionText="{Binding FallbackActionText}"
                                         ActionCommand="{Binding FallbackActionCommand}"
                                         DescriptionMaxWidth="320"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center" />
                </DataTemplate>
                <Style x:Key="ChatPaneTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Subtle}">
                    <Setter Property="Margin" Value="0,0,8,0" />
                    <Setter Property="Visibility" Value="{Binding DataContext.SelectedMode.IsSplit, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                </Style>
                <DataTemplate x:Key="ChatPaneHeader">
                    <DockPanel Margin="7,1">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasAccountChoices}" Value="False" />
                                            <Condition Binding="{Binding DataContext.SelectedMode.IsSplit, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayName}" Style="{StaticResource ChatPaneTitle}"
                                   VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding AccountChoices}"
                                  SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  AutomationProperties.Name="Аккаунт чата"
                                  ToolTip="{Binding SelectedAccount.Label}"
                                  Style="{StaticResource ComboBox.Form}"
                                  HorizontalAlignment="Left" MaxWidth="240"
                                  MinHeight="22" Padding="5,2"
                                  Background="Transparent"
                                  FontSize="{DynamicResource Font.Size.S}"
                                  Visibility="{Binding HasAccountChoices, Converter={StaticResource BoolToVisibility}}" />
                    </DockPanel>
                </DataTemplate>
                <DataTemplate x:Key="ChatMessageInput">
                    <StackPanel Margin="6,4"
                                Visibility="{Binding ShowMessageInput, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Через API" Command="{Binding SendMessageCommand}"
                                    AutomationProperties.Name="Отправить сообщение через API"
                                    ToolTip="Отправить от выбранного аккаунта приложения"
                                    Style="{StaticResource Button.Secondary}" Margin="6,0,0,0" />
                            <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Сообщение в чат" />
                        </DockPanel>
                        <TextBlock Text="{Binding MessageStatus}" Style="{StaticResource TextBlock.Subtle}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding MessageStatus, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </DataTemplate>
            </Grid.Resources>

            <UniformGrid x:Name="ChatPanes">
                <UniformGrid.Style>
                    <Style TargetType="UniformGrid">
                        <Setter Property="Rows" Value="1" />
                        <Setter Property="Columns" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLayoutEditing}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsModalDialogOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedMode.Layout}" Value="Columns">
                                <Setter Property="Columns" Value="2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedMode.Layout}" Value="Rows">
                                <Setter Property="Rows" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </UniformGrid.Style>
                <DockPanel DataContext="{Binding TwitchChat}" ClipToBounds="True"
                           Visibility="{Binding IsShown, Converter={StaticResource BoolToVisibility}}">
                    <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource ChatPaneHeader}" />
                    <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ChatMessageInput}" />
                    <Grid>
                        <wv2:WebView2 x:Name="WebView" Style="{StaticResource ChatWebView}"
                                      ZoomFactor="{Binding DataContext.ZoomFactor, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ChatFallback}"
                                          Visibility="{Binding HasFallback, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DockPanel>
                <DockPanel DataContext="{Binding PlatformChat}" ClipToBounds="True"
                           Visibility="{Binding IsShown, Converter={StaticResource BoolToVisibility}}">
                    <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource ChatPaneHeader}" />
                    <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ChatMessageInput}" />
                    <Grid>
                        <wv2:WebView2 x:Name="PlatformWebView" Style="{StaticResource ChatWebView}"
                                      ZoomFactor="{Binding DataContext.ZoomFactor, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ChatFallback}"
                                          Visibility="{Binding HasFallback, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DockPanel>
            </UniformGrid>

            <controls:EmptyState x:Name="HiddenChat" Icon="MessageSquare" Heading="Чат скрыт"
                                 DescriptionMaxWidth="320" VerticalAlignment="Center" HorizontalAlignment="Center">
                <controls:EmptyState.Style>
                    <Style TargetType="controls:EmptyState">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Description" Value="Окно чата вернётся, когда закончится настройка дашборда." />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLayoutEditing}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsModalDialogOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Description" Value="Окно чата вернётся, когда закроется диалог." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:EmptyState.Style>
            </controls:EmptyState>
        </Grid>
    </DockPanel>
</UserControl>
