<UserControl x:Class="PoproshaykaBot.Wpf.Views.Tiles.ObsSecondaryOutputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Tiles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ObsSecondaryOutputViewModel}"
             d:DesignWidth="320">

    <UserControl.Resources>
        <Style x:Key="SecondaryOutputHealth"
               TargetType="TextBlock"
               BasedOn="{StaticResource TextBlock.Subtle}">
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.XS}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HealthSeverity}"
                             Value="Warning">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.WarningText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HealthSeverity}"
                             Value="Error">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.ErrorText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card.Inset}"
            Padding="10,7"
            Margin="0,0,0,5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0"
                       LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource Button.Secondary}"
                        MinHeight="24"
                        Padding="8,2"
                        Margin="8,0,0,0"
                        FontSize="{DynamicResource Font.Size.XS}"
                        Content="{Binding ActionButtonText}"
                        Command="{Binding ToggleCommand}"
                        Visibility="{Binding CanControl, Converter={StaticResource BoolToVisibility}}" />

                <Border DockPanel.Dock="Right"
                        Style="{StaticResource Badge}"
                        Padding="6,1"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="RTMP"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{DynamicResource Fg.Secondary}" />
                </Border>

                <Border DockPanel.Dock="Right"
                        Style="{StaticResource Badge}"
                        Padding="6,1"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsVertical, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Вертик."
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{DynamicResource Fg.Secondary}" />
                </Border>

                <Ellipse DockPanel.Dock="Left"
                         Width="7"
                         Height="7"
                         VerticalAlignment="Center"
                         Margin="0,0,6,0"
                         keepshell:SeverityBrushBehavior.Fill="{Binding StateSeverity}" />

                <TextBlock Text="{Binding Name}"
                           ToolTip="{Binding Name}"
                           FontWeight="SemiBold"
                           FontSize="{DynamicResource Font.Size.S}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </DockPanel>

            <WrapPanel Grid.Row="1"
                       Margin="13,3,0,0"
                       Orientation="Horizontal">
                <TextBlock Text="{Binding StateText}"
                           FontSize="{DynamicResource Font.Size.XS}"
                           FontWeight="SemiBold"
                           keepshell:SeverityBrushBehavior.Foreground="{Binding StateSeverity}"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center" />

                <TextBlock Text="{Binding Timecode, Converter={StaticResource Timecode}}"
                           Style="{StaticResource TextBlock.Mono}"
                           FontSize="{DynamicResource Font.Size.XS}"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasTimecode, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="{Binding BytesText}"
                           Style="{StaticResource TextBlock.Subtle}"
                           FontSize="{DynamicResource Font.Size.XS}"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasBytes, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="{Binding Health}"
                           Style="{StaticResource SecondaryOutputHealth}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasHealth, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
