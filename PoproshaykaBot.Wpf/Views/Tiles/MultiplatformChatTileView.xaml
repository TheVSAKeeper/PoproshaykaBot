<UserControl x:Class="PoproshaykaBot.Wpf.Views.Tiles.MultiplatformChatTileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Tiles"
             xmlns:chat="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Tiles.Chat"
             xmlns:infra="clr-namespace:PoproshaykaBot.Wpf.Infrastructure"
             xmlns:platformControls="clr-namespace:PoproshaykaBot.Wpf.Views.Controls"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:controls="clr-namespace:KeepShell.Views.Controls;assembly=KeepShell"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MultiplatformChatTileViewModel}"
             d:DesignWidth="380"
             d:DesignHeight="420">

    <UserControl.Resources>
        <infra:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
        <DataTemplate DataType="{x:Type chat:ChatFeedMessageItemViewModel}">
            <Border Margin="0,0,4,0"
                    Padding="{Binding Data.FeedItemPadding, Source={StaticResource ViewModelProxy}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHistorical}" Value="True">
                                <Setter Property="Opacity" Value="0.72" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource Fg.Primary}"
                           FontSize="{Binding Data.FeedFontSize, Source={StaticResource ViewModelProxy}}"
                           LineHeight="{Binding Data.FeedLineHeight, Source={StaticResource ViewModelProxy}}">
                    <InlineUIContainer BaselineAlignment="Center">
                        <TextBlock Text="{Binding TimestampText, Mode=OneWay}"
                                   Foreground="{DynamicResource Fg.Muted}"
                                   FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="{Binding Data.FeedMetaFontSize, Source={StaticResource ViewModelProxy}}"
                                   Margin="0,0,5,0"
                                   Visibility="{Binding Data.ShowTimestamps, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" />
                    </InlineUIContainer>
                    <InlineUIContainer BaselineAlignment="Center">
                        <platformControls:PlatformIconView Platform="{Binding Platform, Mode=OneWay}"
                                                           Width="{Binding Data.FeedPlatformIconSize, Source={StaticResource ViewModelProxy}}"
                                                           Height="{Binding Data.FeedPlatformIconSize, Source={StaticResource ViewModelProxy}}"
                                                           Margin="0,0,4,0"
                                                           ToolTip="{Binding PlatformDisplayName, Mode=OneWay}"
                                                           Visibility="{Binding Data.ShowPlatformIcons, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" />
                    </InlineUIContainer>
                    <InlineUIContainer BaselineAlignment="Center">
                        <Grid Visibility="{Binding Data.ShowRoleBadges, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}">
                            <Border Background="{DynamicResource Bg.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4,0"
                                    Margin="0,0,4,0"
                                    Visibility="{Binding HasRoleBadge, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding RoleBadgeText, Mode=OneWay}"
                                           Foreground="{DynamicResource Fg.Secondary}"
                                           FontSize="{Binding Data.FeedMetaFontSize, Source={StaticResource ViewModelProxy}}" />
                            </Border>
                        </Grid>
                    </InlineUIContainer>
                    <InlineUIContainer BaselineAlignment="Center">
                        <Border Background="{DynamicResource Bg.SurfaceAlt}"
                                CornerRadius="4"
                                Padding="4,0"
                                Margin="0,0,4,0"
                                Visibility="{Binding IsHistorical, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="История"
                                       Foreground="{DynamicResource Fg.Muted}"
                                       FontSize="{Binding Data.FeedMetaFontSize, Source={StaticResource ViewModelProxy}}" />
                        </Border>
                    </InlineUIContainer>
                    <InlineUIContainer BaselineAlignment="Center">
                        <Button Style="{StaticResource Button.Ghost}"
                                Padding="0"
                                MinHeight="0"
                                Margin="0,0,4,0"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding HasUserLink, Mode=OneWay}"
                                Command="{Binding OpenUserCommand}">
                            <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       FontSize="{Binding Data.FeedFontSize, Source={StaticResource ViewModelProxy}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding AuthorBrush, Mode=OneWay}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AuthorBrush}" Value="{x:Null}">
                                                <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </InlineUIContainer>
                    <Run Text="{Binding MessageText, Mode=OneWay}" />
                </TextBlock>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type chat:ChatFeedHistoryBoundaryItemViewModel}">
            <Border Padding="{Binding Data.FeedItemPadding, Source={StaticResource ViewModelProxy}}">
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Height="1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Border.Subtle}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Label, Mode=OneWay}"
                               Margin="8,0"
                               FontSize="{Binding Data.FeedMetaFontSize, Source={StaticResource ViewModelProxy}}"
                               Foreground="{DynamicResource Fg.Muted}" />
                    <Border Grid.Column="2"
                            Height="1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Border.Subtle}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type chat:ChatFeedStreamDividerItemViewModel}">
            <Border Padding="{Binding Data.FeedItemPadding, Source={StaticResource ViewModelProxy}}">
                <Grid Margin="0,5,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Height="1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Border.Strong}" />
                    <Border Grid.Column="1"
                            Background="{DynamicResource Bg.SurfaceAlt}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,1"
                            Margin="6,0">
                        <TextBlock Text="{Binding Label, Mode=OneWay}"
                                   FontWeight="SemiBold"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="260"
                                   ToolTip="{Binding Label, Mode=OneWay}"
                                   FontSize="{Binding Data.FeedMetaFontSize, Source={StaticResource ViewModelProxy}}"
                                   Foreground="{DynamicResource Fg.Secondary}" />
                    </Border>
                    <Border Grid.Column="2"
                            Height="1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Border.Strong}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type chat:ChatFeedGapItemViewModel}">
            <Border Margin="0,0,4,0"
                    Padding="{Binding Data.FeedItemPadding, Source={StaticResource ViewModelProxy}}">
                <Border Background="{DynamicResource Bg.SurfaceAlt}"
                        BorderBrush="{DynamicResource Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,5">
                    <StackPanel Orientation="Horizontal">
                        <platformControls:PlatformIconView Platform="{Binding Platform, Mode=OneWay}"
                                                           Width="{Binding Data.FeedPlatformIconSize, Source={StaticResource ViewModelProxy}}"
                                                           Height="{Binding Data.FeedPlatformIconSize, Source={StaticResource ViewModelProxy}}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"
                                                           ToolTip="{Binding PlatformDisplayName, Mode=OneWay}"
                                                           Visibility="{Binding Data.ShowPlatformIcons, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding TimestampText, Mode=OneWay}"
                                   Foreground="{DynamicResource Fg.Muted}"
                                   FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="{Binding Data.FeedMetaFontSize, Source={StaticResource ViewModelProxy}}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Visibility="{Binding Data.ShowTimestamps, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Text, Mode=OneWay}"
                                   Foreground="{DynamicResource State.WarningText}"
                                   FontSize="{Binding Data.FeedMetaFontSize, Source={StaticResource ViewModelProxy}}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <DockPanel DockPanel.Dock="Top"
                   Margin="0,0,0,6">
            <ComboBox DockPanel.Dock="Right"
                      ItemsSource="{Binding PlatformOptions}"
                      SelectedItem="{Binding SelectedPlatformFilter, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      MinWidth="112"
                      ToolTip="Показать сообщения выбранной площадки в ленте"
                      AutomationProperties.Name="Фильтр сообщений по площадке" />
            <TextBlock Text="Лента сообщений"
                       Style="{StaticResource TextBlock.Subtle}"
                       VerticalAlignment="Center" />
        </DockPanel>

        <Border x:Name="AppearancePanel"
                Style="{StaticResource Card.Inset}"
                DockPanel.Dock="Top"
                Margin="0,0,0,6"
                Padding="8,6"
                Visibility="{Binding IsAppearancePanelOpen, Converter={StaticResource BoolToVisibility}}">
            <WrapPanel Orientation="Horizontal"
                       VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,2,12,2">
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="A−"
                            Padding="6,2"
                            MinHeight="24"
                            Command="{Binding DecreaseFontSizeCommand}"
                            ToolTip="Уменьшить шрифт ленты"
                            AutomationProperties.Name="Уменьшить шрифт ленты" />
                    <TextBlock Text="{Binding FeedFontSizeText, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Margin="6,0"
                               MinWidth="36"
                               TextAlignment="Center"
                               FontFamily="{DynamicResource Font.Mono}"
                               FontSize="{DynamicResource Font.Size.XS}"
                               Foreground="{DynamicResource Fg.Secondary}" />
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="A+"
                            Padding="6,2"
                            MinHeight="24"
                            Command="{Binding IncreaseFontSizeCommand}"
                            ToolTip="Увеличить шрифт ленты"
                            AutomationProperties.Name="Увеличить шрифт ленты" />
                </StackPanel>

                <CheckBox Style="{StaticResource CheckBox.Default}"
                          Content="Компактно"
                          IsChecked="{Binding IsCompactMode, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,2,10,2" />
                <CheckBox Style="{StaticResource CheckBox.Default}"
                          Content="Время"
                          IsChecked="{Binding ShowTimestamps, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,2,10,2" />
                <CheckBox Style="{StaticResource CheckBox.Default}"
                          Content="Площадка"
                          IsChecked="{Binding ShowPlatformIcons, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,2,10,2" />
                <CheckBox Style="{StaticResource CheckBox.Default}"
                          Content="Роли"
                          IsChecked="{Binding ShowRoleBadges, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,2,10,2" />

                <Button Style="{StaticResource Button.Ghost}"
                        Content="Сброс"
                        Padding="6,2"
                        MinHeight="24"
                        VerticalAlignment="Center"
                        Margin="0,2,0,2"
                        Command="{Binding ResetAppearanceCommand}"
                        ToolTip="Сбросить настройки отображения ленты"
                        AutomationProperties.Name="Сбросить настройки отображения ленты" />
            </WrapPanel>
        </Border>

        <Grid>
            <ListBox x:Name="FeedListBox"
                     ItemsSource="{Binding Items}"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ScrollViewer.ScrollChanged="OnFeedScrollChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <controls:EmptyState Icon="MessagesSquare"
                                 Heading="Пока пусто"
                                 Description="Сообщения подключённых площадок появятся здесь в реальном времени."
                                 DescriptionMaxWidth="280"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <Button Style="{StaticResource Button.Primary}"
                    Content="{Binding UnreadButtonText, Mode=OneWay}"
                    Command="{Binding ScrollToBottomCommand}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,6"
                    Padding="12,4"
                    Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
