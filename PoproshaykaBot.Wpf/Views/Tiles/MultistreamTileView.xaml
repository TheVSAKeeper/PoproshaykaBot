<UserControl x:Class="PoproshaykaBot.Wpf.Views.Tiles.MultistreamTileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:controls="clr-namespace:PoproshaykaBot.Wpf.Views.Controls">
    <UserControl.Resources>
        <Style x:Key="PlatformStatus" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.S}" />
        </Style>
    </UserControl.Resources>
    <StackPanel VerticalAlignment="Top">
        <Border Style="{StaticResource Card.Inset}"
                Margin="0,0,0,8"
                Padding="10,6">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource Button.Secondary}"
                        MinHeight="26"
                        Padding="8,2"
                        Margin="8,0,0,0"
                        FontSize="{DynamicResource Font.Size.XS}"
                        Content="{Binding BulkConnectionLabel}"
                        Command="{Binding BulkConnectionCommand}"
                        Visibility="{Binding ShowBulkConnectionAction, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.AutomationId="MultistreamBulkConnection"
                        AutomationProperties.Name="{Binding BulkConnectionLabel}" />
                <DockPanel VerticalAlignment="Center">
                    <Ellipse DockPanel.Dock="Left"
                             Width="7"
                             Height="7"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0"
                             keepshell:SeverityBrushBehavior.Fill="{Binding SummarySeverity}" />
                    <TextBlock Text="{Binding SummaryText}"
                               FontSize="{DynamicResource Font.Size.S}"
                               FontWeight="{DynamicResource Font.Weight.SemiBold}"
                               Foreground="{DynamicResource Fg.Primary}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SummaryText}"
                               VerticalAlignment="Center" />
                </DockPanel>
            </DockPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding Rows}" VerticalAlignment="Top">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,8" Padding="10,7">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:PlatformIconView Platform="{Binding Platform}"
                                                           ToolTip="{Binding DisplayName}"
                                                           Width="16"
                                                           Height="16"
                                                           Margin="0,0,6,0"
                                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource Fg.Primary}"
                                           FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ChannelName}"
                                           ToolTip="{Binding ChannelName}"
                                           Foreground="{DynamicResource Fg.Secondary}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           Visibility="{Binding ShowStaticChannelName, Converter={StaticResource BoolToVisibility}}" />
                                <Border Grid.Column="3"
                                        Style="{StaticResource Badge}"
                                        Padding="7,1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasChannelBadge, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding ChannelBadgeText}"
                                               Foreground="{DynamicResource Fg.Secondary}"
                                               FontSize="{DynamicResource Font.Size.Caption}" />
                                </Border>
                            </Grid>
                            <ComboBox Margin="0,0,0,6"
                                      Style="{StaticResource ComboBox.Toolbar}"
                                      MinHeight="28"
                                      Padding="8,3"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Channels}"
                                      SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      IsEnabled="{Binding CanSwitchChannel}"
                                      ToolTip="{Binding ChannelSelectorTooltip}"
                                      AutomationProperties.AutomationId="{Binding Platform, StringFormat='MultistreamChannel{0}'}"
                                      AutomationProperties.Name="{Binding ChannelSelectorName}"
                                      Visibility="{Binding HasChannelSelector, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Margin="0,0,0,4"
                                       Style="{StaticResource PlatformStatus}"
                                       Text="{Binding SwitchErrorText}"
                                       keepshell:SeverityBrushBehavior.Foreground="{Binding SwitchErrorSeverity}"
                                       Visibility="{Binding HasSwitchError, Converter={StaticResource BoolToVisibility}}" />
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right"
                                        Style="{StaticResource Badge.Success}"
                                        Padding="6,1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasViewerCount, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding ViewerCountText}"
                                               FontSize="{DynamicResource Font.Size.XS}" />
                                </Border>
                                <Ellipse DockPanel.Dock="Left"
                                         Width="6"
                                         Height="6"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0"
                                         keepshell:SeverityBrushBehavior.Fill="{Binding BroadcastSeverity}" />
                                <TextBlock Style="{StaticResource PlatformStatus}"
                                           Text="{Binding BroadcastText}"
                                           keepshell:SeverityBrushBehavior.Foreground="{Binding BroadcastSeverity}" />
                            </DockPanel>
                            <TextBlock Margin="12,1,0,2"
                                       Text="{Binding LiveSummaryText}"
                                       ToolTip="{Binding LiveSummaryText}"
                                       Foreground="{DynamicResource Fg.Muted}"
                                       FontSize="{DynamicResource Font.Size.XS}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasLiveSummary, Converter={StaticResource BoolToVisibility}}" />
                            <DockPanel Margin="0,2,0,0">
                                <Ellipse DockPanel.Dock="Left"
                                         Width="6"
                                         Height="6"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0"
                                         keepshell:SeverityBrushBehavior.Fill="{Binding ChatSeverity}" />
                                <TextBlock Style="{StaticResource PlatformStatus}"
                                           Text="{Binding ChatText}"
                                           keepshell:SeverityBrushBehavior.Foreground="{Binding ChatSeverity}" />
                            </DockPanel>
                            <WrapPanel Margin="0,5,0,0"
                                       Visibility="{Binding HasContextBadges, Converter={StaticResource BoolToVisibility}}">
                                <Border Style="{StaticResource Badge}"
                                        Padding="6,1"
                                        Margin="0,0,5,3"
                                        ToolTip="Авторизация ведущего отсутствует – работает только бот"
                                        Visibility="{Binding IsBotOnly, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Только бот"
                                               Foreground="{DynamicResource Fg.Secondary}"
                                               FontSize="{DynamicResource Font.Size.XS}" />
                                </Border>
                                <Border Style="{StaticResource Badge.Info}"
                                        Padding="6,1"
                                        Margin="0,0,5,3"
                                        ToolTip="{Binding SwitchModeBadgeTooltip}"
                                        Visibility="{Binding HasSwitchModeBadge, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding SwitchModeBadgeText}"
                                               FontSize="{DynamicResource Font.Size.XS}" />
                                </Border>
                                <Border Style="{StaticResource Badge.Success}"
                                        Padding="6,1"
                                        Margin="0,0,5,3"
                                        ToolTip="{Binding BackgroundLiveTooltip}"
                                        Visibility="{Binding HasBackgroundLive, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding BackgroundLiveText}"
                                               FontSize="{DynamicResource Font.Size.XS}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding MonitoringWarningText}"
                                       Foreground="{DynamicResource State.WarningText}"
                                       FontSize="{DynamicResource Font.Size.XS}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasMonitoringWarning, Converter={StaticResource BoolToVisibility}}" />
                            <WrapPanel Margin="0,2,0,0">
                                <Button Style="{StaticResource Button.Secondary}"
                                        MinHeight="30"
                                        Padding="10,3"
                                        FontSize="{DynamicResource Font.Size.S}"
                                        Margin="0,4,8,0"
                                        Content="{Binding ConnectionActionLabel}"
                                        Command="{Binding ToggleConnectionCommand}"
                                        Visibility="{Binding ShowConnectionAction, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="{Binding ConnectionActionName}" />
                                <Button x:Name="OpenPlatform"
                                        Style="{StaticResource Button.Ghost}"
                                        MinHeight="30"
                                        Padding="10,3"
                                        FontSize="{DynamicResource Font.Size.S}"
                                        Margin="0,4,0,0"
                                        Content="{Binding PlatformActionLabel}"
                                        Command="{Binding OpenPlatformCommand}"
                                        AutomationProperties.AutomationId="{Binding Platform, StringFormat='MultistreamSettings{0}'}"
                                        AutomationProperties.Name="{Binding PlatformActionName}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSetupRequired}" Value="True">
                            <Setter TargetName="OpenPlatform" Property="Style" Value="{StaticResource Button.Primary}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
