<UserControl x:Class="PoproshaykaBot.Wpf.Views.Tiles.ObsInfoTileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Tiles"
             xmlns:behaviors="clr-namespace:PoproshaykaBot.Wpf.Infrastructure.Behaviors"
             xmlns:controls="clr-namespace:KeepShell.Views.Controls;assembly=KeepShell"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ObsInfoTileViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="420">

    <StackPanel VerticalAlignment="Top">
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding ConnectionText}"
                       ToolTip="{Binding ConnectionToolTip}"
                       FontWeight="SemiBold"
                       FontSize="{DynamicResource Font.Size.S}"
                       VerticalAlignment="Center"
                       behaviors:StreamStatusBrushBehavior.Foreground="{Binding ConnectionStatus}" />

            <DockPanel Grid.Column="1"
                       Margin="10,0,0,0"
                       LastChildFill="True"
                       VerticalAlignment="Center">
                <Border DockPanel.Dock="Right"
                        Style="{StaticResource Badge}"
                        Padding="6,1"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}"
                        keepshell:SeverityBrushBehavior.SoftBackground="{Binding ToastSeverity}"
                        keepshell:SeverityBrushBehavior.BorderBrush="{Binding ToastSeverity}">
                    <TextBlock Text="{Binding ToastText}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ToastText}"
                               keepshell:SeverityBrushBehavior.Foreground="{Binding ToastSeverity}" />
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="Сцена:"
                               Style="{StaticResource TextBlock.Subtle}"
                               FontSize="{DynamicResource Font.Size.XS}"
                               Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SceneName}"
                               ToolTip="{Binding SceneName}"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource Font.Size.S}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Grid>

        <Grid x:Name="OutputsGrid"
              Margin="0,0,0,8"
              SizeChanged="OnOutputsSizeChanged"
              Visibility="{Binding HasOutputs, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SecondOutputColumn"
                                  Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentControl x:Name="StreamCardHost"
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,0,6"
                            VerticalAlignment="Top"
                            Content="{Binding StreamCard}" />

            <ContentControl x:Name="RecordCardHost"
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            Content="{Binding RecordCard}" />
        </Grid>

        <StackPanel Margin="0,0,0,8"
                    Visibility="{Binding ShowSecondaryOutputs, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Доп. выходы"
                       Style="{StaticResource TextBlock.Subtle}"
                       FontSize="{DynamicResource Font.Size.XS}"
                       Margin="0,0,0,4" />

            <ItemsControl ItemsSource="{Binding SecondaryOutputs}" />
        </StackPanel>

        <StackPanel Visibility="{Binding IsUnavailable, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Text="Аудиоисточники"
                       Style="{StaticResource TextBlock.Subtle}"
                       FontSize="{DynamicResource Font.Size.XS}"
                       Margin="0,0,0,4" />

            <ItemsControl ItemsSource="{Binding AudioSources}"
                          Visibility="{Binding HasAudioSources, Converter={StaticResource BoolToVisibility}}" />

            <controls:EmptyState Icon="Mic"
                                 IconSize="20"
                                 Heading="Источники не найдены"
                                 Description="Включите OBS-интеграцию и настройте аудиоисточники."
                                 HorizontalAlignment="Stretch"
                                 Visibility="{Binding HasAudioSources, Converter={StaticResource InverseBoolToVisibility}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
