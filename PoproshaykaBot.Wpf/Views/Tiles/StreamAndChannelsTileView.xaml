<UserControl x:Class="PoproshaykaBot.Wpf.Views.Tiles.StreamAndChannelsTileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Tiles"
             xmlns:behaviors="clr-namespace:PoproshaykaBot.Wpf.Infrastructure.Behaviors"
             xmlns:controls="clr-namespace:PoproshaykaBot.Wpf.Views.Controls"
             xmlns:platforms="clr-namespace:PoproshaykaBot.Core.Platforms;assembly=PoproshaykaBot.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StreamAndChannelsTileViewModel}"
             d:DesignWidth="360">
    <StackPanel>
        <DockPanel LastChildFill="True" Margin="0,0,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ViewerCount, StringFormat=N0}"
                           Foreground="{DynamicResource Fg.Secondary}"
                           FontSize="{DynamicResource Font.Size.XS}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
                <TextBlock Text=" зр."
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.XS}"
                           VerticalAlignment="Center" />
                <TextBlock Text="·"
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.XS}"
                           VerticalAlignment="Center"
                           Margin="5,0" />
                <TextBlock Text="{Binding Uptime, Converter={StaticResource Timecode}}"
                           FontFamily="{DynamicResource Font.Mono}"
                           Foreground="{DynamicResource Fg.Secondary}"
                           FontSize="{DynamicResource Font.Size.XS}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Ellipse DockPanel.Dock="Left"
                     Width="9"
                     Height="9"
                     Margin="0,0,7,0"
                     VerticalAlignment="Center"
                     behaviors:StreamStatusBrushBehavior.Fill="{Binding Status}" />
            <TextBlock Text="{Binding StatusBadgeText}"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource Font.Size.S}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       behaviors:StreamStatusBrushBehavior.Foreground="{Binding Status}" />
        </DockPanel>

        <TextBlock Text="{Binding StreamTitle}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Fg.Primary}"
                   FontSize="{DynamicResource Font.Size.M}"
                   Margin="0,0,0,2" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Style="{StaticResource TextBlock.Subtle}"
                       FontSize="{DynamicResource Font.Size.XS}"
                       Text="{Binding DetailLabel, StringFormat='{}{0}: '}" />
            <TextBlock Foreground="{DynamicResource Fg.Secondary}"
                       FontSize="{DynamicResource Font.Size.XS}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding DetailValue}"
                       Text="{Binding DetailValue}" />
        </StackPanel>

        <Border Style="{StaticResource Card.Inset}"
                Padding="8,5"
                Margin="0,0,0,4"
                Visibility="{Binding HasTwitchAnchor, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:PlatformIconView Grid.Column="0"
                                           Platform="{x:Static platforms:StreamingPlatform.Twitch}"
                                           Width="14"
                                           Height="14"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding TwitchChannelName}"
                           ToolTip="{Binding TwitchChannelName}"
                           Foreground="{DynamicResource Fg.Primary}"
                           FontWeight="{DynamicResource Font.Weight.SemiBold}"
                           FontSize="{DynamicResource Font.Size.S}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <Ellipse Width="7"
                             Height="7"
                             VerticalAlignment="Center"
                             Margin="0,0,5,0"
                             keepshell:SeverityBrushBehavior.Fill="{Binding TwitchAnchorSeverity}" />
                    <TextBlock Text="{Binding TwitchAnchorStatusText}"
                               FontSize="{DynamicResource Font.Size.XS}"
                               keepshell:SeverityBrushBehavior.Foreground="{Binding TwitchAnchorSeverity}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card.Inset}"
                Padding="8,5">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <controls:PlatformIconView Platform="{x:Static platforms:StreamingPlatform.YouTube}"
                                                   Width="14"
                                                   Height="14"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                        <TextBlock Text="Канал YouTube"
                                   Foreground="{DynamicResource Fg.Primary}"
                                   FontWeight="{DynamicResource Font.Weight.SemiBold}"
                                   FontSize="{DynamicResource Font.Size.S}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ComboBox Grid.Column="1"
                              Style="{StaticResource ComboBox.Toolbar}"
                              MinHeight="28"
                              Padding="8,3"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding YouTubeChannels}"
                              SelectedItem="{Binding SelectedYouTubeChannel, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              IsEnabled="{Binding CanSwitchYouTubeChannel}"
                              ToolTip="{Binding YouTubeSelectorTooltip}"
                              AutomationProperties.AutomationId="StreamChannelsYouTubeSelector"
                              AutomationProperties.Name="Канал YouTube"
                              Visibility="{Binding HasYouTubeChannelSelector, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding YouTubeChannelDisplayName}"
                               ToolTip="{Binding YouTubeChannelDisplayName}"
                               Foreground="{DynamicResource Fg.Secondary}"
                               FontSize="{DynamicResource Font.Size.S}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Visibility="{Binding ShowStaticYouTubeChannel, Converter={StaticResource BoolToVisibility}}" />

                    <Button Grid.Column="1"
                            Content="Настроить YouTube"
                            Style="{StaticResource Button.Primary}"
                            MinHeight="26"
                            Padding="10,2"
                            FontSize="{DynamicResource Font.Size.XS}"
                            HorizontalAlignment="Right"
                            Command="{Binding OpenChannelsAndProfilesCommand}"
                            AutomationProperties.AutomationId="StreamChannelsSetupYouTube"
                            Visibility="{Binding ShowYouTubeSetupButton, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <DockPanel LastChildFill="True" Margin="0,4,0,0">
                    <Ellipse DockPanel.Dock="Left"
                             Width="7"
                             Height="7"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0"
                             keepshell:SeverityBrushBehavior.Fill="{Binding YouTubeStatusSeverity}" />
                    <TextBlock Text="{Binding YouTubeStatusText}"
                               FontSize="{DynamicResource Font.Size.S}"
                               FontWeight="{DynamicResource Font.Weight.Medium}"
                               TextWrapping="Wrap"
                               keepshell:SeverityBrushBehavior.Foreground="{Binding YouTubeStatusSeverity}"
                               AutomationProperties.AutomationId="StreamChannelsYouTubeStatus" />
                </DockPanel>

                <TextBlock Margin="0,4,0,0"
                           Text="{Binding YouTubeSwitchErrorText}"
                           FontSize="{DynamicResource Font.Size.XS}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource State.WarningText}"
                           Visibility="{Binding HasYouTubeSwitchError, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <TextBlock Text="Найдено несколько активных трансляций YouTube"
                   Foreground="{DynamicResource State.WarningText}"
                   FontSize="{DynamicResource Font.Size.XS}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"
                   Visibility="{Binding HasMultipleYouTubeBroadcasts, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding MonitoringIssueText}"
                   Foreground="{DynamicResource State.WarningText}"
                   FontSize="{DynamicResource Font.Size.XS}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"
                   Visibility="{Binding HasMonitoringIssue, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
</UserControl>
