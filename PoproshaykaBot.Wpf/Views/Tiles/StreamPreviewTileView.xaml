<UserControl x:Class="PoproshaykaBot.Wpf.Views.Tiles.StreamPreviewTileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Tiles"
             xmlns:controls="clr-namespace:KeepShell.Views.Controls;assembly=KeepShell"
             xmlns:platformControls="clr-namespace:PoproshaykaBot.Wpf.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StreamPreviewTileViewModel}"
             d:DesignWidth="380"
             d:DesignHeight="214">

    <Grid>
        <Image x:Name="FrameImage"
               Source="{Binding Thumbnail}"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"
               Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibility}}" />

        <controls:EmptyState Icon="ImageOff"
                             Heading="{Binding EmptyHeading}"
                             Description="{Binding EmptyDescription}"
                             DescriptionMaxWidth="300"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
            <controls:EmptyState.Style>
                <Style TargetType="controls:EmptyState">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Thumbnail}"
                                     Value="{x:Null}">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:EmptyState.Style>
        </controls:EmptyState>

        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="8"
                Padding="6,3"
                CornerRadius="6"
                Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="1"
                Visibility="{Binding HasMultiplePlatforms, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <platformControls:PlatformIconView Platform="{Binding SelectedPlatform, Mode=OneWay}"
                                                   Width="12"
                                                   Height="12"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0" />
                <TextBlock Text="{Binding SelectedPlatformName, Mode=OneWay}"
                           FontSize="{DynamicResource Font.Size.XS}"
                           Foreground="{DynamicResource Fg.Secondary}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
