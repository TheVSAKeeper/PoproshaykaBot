<UserControl x:Class="PoproshaykaBot.Wpf.Views.Tiles.BroadcastProfilesTileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Tiles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BroadcastProfilesTileViewModel}"
             d:DesignHeight="320"
             d:DesignWidth="780">

    <UserControl.Resources>
        <Style x:Key="ProfileCard"
               TargetType="Border"
               BasedOn="{StaticResource Card.Inset}">
            <Setter Property="Margin"
                    Value="0,0,8,8" />
            <Setter Property="Padding"
                    Value="10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}"
                             Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource State.SuccessSoft}" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource State.Success}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProfileCardMeta"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Secondary}" />
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.XS}" />
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis" />
        </Style>

        <DataTemplate x:Key="ProfileCardTemplate"
                      DataType="{x:Type vm:BroadcastProfileItemViewModel}">
            <Border x:Name="Card"
                    Style="{StaticResource ProfileCard}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Применить" Command="{Binding ApplyCommand}" />
                        <Separator />
                        <MenuItem Header="Редактировать…" Command="{Binding EditCommand}" />
                        <MenuItem Header="Дублировать" Command="{Binding DuplicateCommand}" />
                        <Separator />
                        <MenuItem Header="Удалить" Command="{Binding DeleteCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <StackPanel>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="64" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Style="{StaticResource Badge}"
                                        Margin="4,0,0,0"
                                        Visibility="{Binding HasNumberPlaceholder, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding NumberBadge}"
                                               FontFamily="{DynamicResource Font.Mono}" />
                                </Border>
                                <Border Style="{StaticResource Badge.Success}"
                                        Margin="4,0,0,0"
                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Активен" />
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontSize="{DynamicResource Font.Size.M}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg.Primary}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Расходится с текущим стримом"
                                   Foreground="{DynamicResource State.WarningText}"
                                   FontSize="{DynamicResource Font.Size.XS}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasDrift, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{Binding TitleDisplay}"
                                   Style="{StaticResource ProfileCardMeta}"
                                   FontStyle="Italic"
                                   Margin="0,2,0,0"
                                   ToolTip="{Binding TitleDisplay}"
                                   Visibility="{Binding HasTitleDisplay, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{Binding MetaLine}"
                                   Style="{StaticResource ProfileCardMeta}"
                                   Margin="0,2,0,0"
                                   ToolTip="{Binding MetaLine}"
                                   Visibility="{Binding HasMetaLine, Converter={StaticResource BoolToVisibility}}" />

                    </StackPanel>

                    <Border x:Name="CardActions"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="{Binding Background, ElementName=Card}"
                            BorderBrush="{Binding BorderBrush, ElementName=Card}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.S}"
                            Padding="4,3"
                            Opacity="0"
                            IsHitTestVisible="False"
                            ToolTip="{Binding MetaLine}"
                            ToolTipService.IsEnabled="{Binding HasMetaLine}">
                        <WrapPanel>
                            <Button Content="Применить"
                                    ToolTip="Применить профиль к каналу"
                                    Command="{Binding ApplyCommand}"
                                    Style="{StaticResource Button.Secondary}" />
                            <StackPanel Orientation="Horizontal"
                                        Margin="8,0,0,0"
                                        Visibility="{Binding HasNumberPlaceholder, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="–"
                                        Command="{Binding DecrementNumberCommand}"
                                        Style="{StaticResource Button.Secondary}"
                                        Padding="8,2"
                                        ToolTip="Уменьшить номер"
                                        AutomationProperties.Name="Уменьшить номер" />
                                <TextBlock Text="{Binding NumberBadge}"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="{DynamicResource Font.Size.S}"
                                           Foreground="{DynamicResource Fg.Secondary}"
                                           VerticalAlignment="Center"
                                           Margin="6,0" />
                                <Button Content="+"
                                        Command="{Binding IncrementNumberCommand}"
                                        Style="{StaticResource Button.Secondary}"
                                        Padding="8,2"
                                        ToolTip="Увеличить номер"
                                        AutomationProperties.Name="Увеличить номер" />
                            </StackPanel>
                            <ProgressBar IsIndeterminate="True"
                                         Width="40"
                                         Height="4"
                                         Margin="8,0,0,0"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding IsApplyInFlight, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                    </Border>

                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="Card"
                         Property="IsMouseOver"
                         Value="True">
                    <Setter TargetName="CardActions"
                            Property="Opacity"
                            Value="1" />
                    <Setter TargetName="CardActions"
                            Property="IsHitTestVisible"
                            Value="True" />
                </Trigger>

                <Trigger SourceName="Card"
                         Property="IsKeyboardFocusWithin"
                         Value="True">
                    <Setter TargetName="CardActions"
                            Property="Opacity"
                            Value="1" />
                    <Setter TargetName="CardActions"
                            Property="IsHitTestVisible"
                            Value="True" />
                </Trigger>

                <DataTrigger Binding="{Binding IsApplyInFlight}"
                             Value="True">
                    <Setter TargetName="CardActions"
                            Property="Opacity"
                            Value="1" />
                    <Setter TargetName="CardActions"
                            Property="IsHitTestVisible"
                            Value="True" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding UnsavedNotice}"
                   FontSize="{DynamicResource Font.Size.S}"
                   Foreground="{DynamicResource State.WarningText}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   AutomationProperties.LiveSetting="Polite"
                   Visibility="{Binding UnsavedNotice, Converter={StaticResource NullToVisibility}}" />

        <TextBlock Grid.Row="1"
                   Text="Профилей нет – добавьте кнопкой «+» в заголовке"
                   Style="{StaticResource TextBlock.Subtle}"
                   FontSize="{DynamicResource Font.Size.S}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Visibility="{Binding HasProfiles, Converter={StaticResource InverseBoolToVisibility}}" />

        <Grid Grid.Row="1"
              Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding StatusMessage}"
                       FontSize="{DynamicResource Font.Size.S}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource State.ErrorText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}"
                              Margin="0,0,-8,0"
                              VerticalAlignment="Top"
                              ItemTemplate="{StaticResource ProfileCardTemplate}"
                              SizeChanged="OnCardsSizeChanged">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding CardColumns, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CardColumns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Value="1">
                                    <Setter Property="ItemsPanel">
                                        <Setter.Value>
                                            <ItemsPanelTemplate>
                                                <StackPanel />
                                            </ItemsPanelTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
