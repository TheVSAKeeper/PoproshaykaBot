<UserControl x:Class="PoproshaykaBot.Wpf.Views.Tiles.StreamInfoTileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Tiles"
             xmlns:behaviors="clr-namespace:PoproshaykaBot.Wpf.Infrastructure.Behaviors"
             xmlns:controls="clr-namespace:PoproshaykaBot.Wpf.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StreamInfoTileViewModel}"
             d:DesignWidth="380">
    <UserControl.Resources>
        <Style x:Key="PlatformTabPillButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Bg.SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Sans}" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.XS}" />
            <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Medium}" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Pill}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.SurfaceMute}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Border.Default}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                    <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
                    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.SemiBold}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Margin="0,0,0,4"
                    Visibility="{Binding HasMultiplePlatforms, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding PlatformTabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource PlatformTabPillButton}"
                                Command="{Binding SelectCommand}"
                                ToolTip="{Binding ToolTipText}"
                                AutomationProperties.AutomationId="{Binding Platform, StringFormat='StreamInfoTab{0}'}"
                                AutomationProperties.Name="{Binding ToolTipText}">
                            <StackPanel Orientation="Horizontal">
                                <controls:PlatformIconView Platform="{Binding Platform, Mode=OneWay}"
                                                           Width="12"
                                                           Height="12"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,5,0" />
                                <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                                           VerticalAlignment="Center" />
                                <Ellipse Width="6"
                                         Height="6"
                                         VerticalAlignment="Center"
                                         Margin="6,0,4,0"
                                         keepshell:SeverityBrushBehavior.Fill="{Binding StatusSeverity}" />
                                <TextBlock Text="{Binding ViewerCountText, Mode=OneWay}"
                                           Opacity="0.85"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding TotalLiveViewersText, Mode=OneWay}"
                       Style="{StaticResource TextBlock.Subtle}"
                       FontSize="{DynamicResource Font.Size.XS}"
                       Margin="0,0,0,4"
                       Visibility="{Binding HasCombinedLiveSummary, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <DockPanel LastChildFill="True"
                   Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right"
                       Style="{StaticResource TextBlock.Subtle}"
                       FontSize="{DynamicResource Font.Size.XS}"
                       VerticalAlignment="Center"
                       Text="{Binding LastUpdated, StringFormat='HH:mm:ss'}" />
            <Ellipse DockPanel.Dock="Left"
                     Width="10"
                     Height="10"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center"
                     behaviors:StreamStatusBrushBehavior.Fill="{Binding Status}" />
            <TextBlock VerticalAlignment="Center"
                       FontSize="{DynamicResource Font.Size.S}"
                       FontWeight="SemiBold"
                       behaviors:StreamStatusBrushBehavior.Foreground="{Binding Status}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="НЕИЗВЕСТНО" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}"
                                         Value="Online">
                                <Setter Property="Text" Value="В ЭФИРЕ" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}"
                                         Value="Offline">
                                <Setter Property="Text" Value="ОФЛАЙН" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>

        <TextBlock Text="{Binding StreamTitle}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Fg.Primary}"
                   FontSize="{DynamicResource Font.Size.M}"
                   Margin="0,0,0,8" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="0"
                        Grid.Row="0"
                        Margin="0,0,8,8">
                <TextBlock Style="{StaticResource TextBlock.Subtle}"
                           FontSize="{DynamicResource Font.Size.XS}"
                           Text="{Binding DetailLabel, Mode=OneWay}" />
                <TextBlock Foreground="{DynamicResource Fg.Secondary}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding DetailValue, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Grid.Row="0"
                        Margin="0,0,0,8">
                <TextBlock Style="{StaticResource TextBlock.Subtle}"
                           FontSize="{DynamicResource Font.Size.XS}"
                           Text="Зрители" />
                <TextBlock Foreground="{DynamicResource Fg.Secondary}"
                           Text="{Binding ViewerCount, StringFormat=N0}" />
            </StackPanel>

            <StackPanel Grid.Column="0"
                        Grid.Row="1"
                        Margin="0,0,8,0">
                <TextBlock Style="{StaticResource TextBlock.Subtle}"
                           FontSize="{DynamicResource Font.Size.XS}"
                           Text="Продолжительность" />
                <TextBlock FontFamily="{DynamicResource Font.Mono}"
                           Foreground="{DynamicResource Fg.Secondary}"
                           Text="{Binding Uptime, Converter={StaticResource Timecode}}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding ActiveChannelDisplayName, StringFormat='Активный канал: {0}'}"
                   ToolTip="{Binding ActiveChannelDisplayName}"
                   Style="{StaticResource TextBlock.Subtle}"
                   FontSize="{DynamicResource Font.Size.XS}"
                   TextTrimming="CharacterEllipsis"
                   Visibility="{Binding HasActiveChannel, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding PreselectedNextText}"
                   Style="{StaticResource TextBlock.Subtle}"
                   FontSize="{DynamicResource Font.Size.XS}"
                   TextWrapping="Wrap"
                   Margin="0,3,0,0"
                   Visibility="{Binding HasPreselectedNext, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Text="Найдено несколько активных трансляций YouTube"
                   Foreground="{DynamicResource State.WarningText}"
                   FontSize="{DynamicResource Font.Size.XS}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"
                   Visibility="{Binding HasMultipleBroadcastsNotice, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding MonitoringIssueText}"
                   Foreground="{DynamicResource State.WarningText}"
                   FontSize="{DynamicResource Font.Size.XS}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"
                   Visibility="{Binding HasMonitoringIssue, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
</UserControl>
